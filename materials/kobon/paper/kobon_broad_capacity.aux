\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Constructions are lower bounds for $K=K_{\mathrm  {gen}}$ (Theorem~\ref {thm:collapse}). Column $\bar  a_3^s$ is the exact maximum over \emph  {simple} arrangements \cite  {BBL,Blanc}: where the construction exceeds it (bold: $n=8,12,14$) the record is attained only non-simply, so the simple-only bound $\lfloor n(n-7/3)/3\rfloor $ --- which equals the construction at every even $n$ here and is what the OEIS upper-bound column reports --- cannot apply (Proposition~\ref {prop:mismatch}). The reference columns are the claim \eqref  {eq:CB} from the incomplete unpublished draft \cite  {CB2007}, and FK $=\lfloor n(n-2)/3\rfloor $ \cite  {FK1999} (see Remark~\ref {rem:provenance}). Rows marked \emph  {certified here} are settled by unsatisfiability with every degeneracy free, citing nothing.}}{16}{table.2}\protected@file@percent }
\newlabel{tab:windows}{{2}{16}{Constructions are lower bounds for $K=\Kgen $ (Theorem~\ref {thm:collapse}). Column $\bar a_3^s$ is the exact maximum over \emph {simple} arrangements \cite {BBL,Blanc}: where the construction exceeds it (bold: $n=8,12,14$) the record is attained only non-simply, so the simple-only bound $\lfloor n(n-7/3)/3\rfloor $ --- which equals the construction at every even $n$ here and is what the OEIS upper-bound column reports --- cannot apply (Proposition~\ref {prop:mismatch}). The reference columns are the claim \eqref {eq:CB} from the incomplete unpublished draft \cite {CB2007}, and FK $=\lfloor n(n-2)/3\rfloor $ \cite {FK1999} (see Remark~\ref {rem:provenance}). Rows marked \emph {certified here} are settled by unsatisfiability with every degeneracy free, citing nothing}{table.2}{}}
