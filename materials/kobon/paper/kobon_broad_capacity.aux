\bibcite{BBL}{1}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Constructions are admissible families, hence lower bounds for all three quantities. By Theorem~\ref {thm:collapse}, $K=K_{\mathrm  {gen}}$, so column three bounds both: its base value $\lfloor n(n-2)/3\rfloor $ is peer-reviewed for non-simple arrangements \cite  {FK1999}, while the $-1$ for $n\equiv 0,2\pmod  6$ rests on the draft \cite  {CB2007}. ``Closed'' means the value is settled, by agreement of construction and bound or by \cite  {Savchuk} at $n=11$. Rows $8,9,10$ are additionally certified here with all degeneracies free. The upper bounds listed in OEIS A006066 at $n=12,14,18,20$ (namely $38,54,94,117$) are \emph  {simple}-arrangement values of the \cite  {BBL,Blanc} type and are not valid for $K$; the windows above are what the non-simple literature proves.}}{9}{table.2}\protected@file@percent }
\newlabel{tab:windows}{{2}{9}{Constructions are admissible families, hence lower bounds for all three quantities. By Theorem~\ref {thm:collapse}, $K=\Kgen $, so column three bounds both: its base value $\lfloor n(n-2)/3\rfloor $ is peer-reviewed for non-simple arrangements \cite {FK1999}, while the $-1$ for $n\equiv 0,2\pmod 6$ rests on the draft \cite {CB2007}. ``Closed'' means the value is settled, by agreement of construction and bound or by \cite {Savchuk} at $n=11$. Rows $8,9,10$ are additionally certified here with all degeneracies free. The upper bounds listed in OEIS A006066 at $n=12,14,18,20$ (namely $38,54,94,117$) are \emph {simple}-arrangement values of the \cite {BBL,Blanc} type and are not valid for $K$; the windows above are what the non-simple literature proves}{table.2}{}}
