  "candidate": {
    "id": "utc-2100-2300-net-premium",
    "mechanism": "Padysak and Vojtko (Quantpedia, 2022-02-18) report that Bitcoin hourly returns for the 22:00 and 23:00 UTC hours are the largest and most statistically significant of the day on Gemini spot data 2015-10..2022-02, during hours when every major traditional exchange is closed, and propose buying at 21:00 UTC and selling at 23:00 UTC. This candidate tests whether that published two-hour long window earns a positive expected return on Binance USD-M perpetuals after two taker fees, and whether the window carries more return than its pro-rata share of the same UTC day.",
    "primary_window": [
      "2020-01-01T00:00:00Z",
      "2022-01-01T00:00:00Z"
    ],
    "replication_window": [
      "2022-04-01T00:00:00Z",
