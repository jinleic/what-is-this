#!/usr/bin/env python3
"""Frozen launcher: preload every local module from campaign asrun copies."""
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path
import hashlib
import os
import runpy
import sys

CAMPAIGN = Path(__file__).resolve().parents[1]
ASRUN = CAMPAIGN / "asrun"
SRC = ASRUN / "src"
SCRATCH = ASRUN / "scratch"

REQUIRED_ENVS = (
    "OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
    "VECLIB_MAXIMUM_THREADS", "NUMEXPR_NUM_THREADS",
)
EXPECTED = {
    "scratch/cr58_cn122_ZT_reduced.json":
        "2821574f8182f0abc97f1b31168e5077a3d6c63d756dbe1f06f24075b0d9926e",
    "scratch/mws59_layout.txt":
        "7bc075d41f6cd2ef71a7c5d5d76d6b3d669e0845728535b857c15ef1d735208f",
    "scratch/sun56_verify.py.asrun":
        "3b7fb40aae051fcc2236dd151ad60f802fb68244df296686667d9a313fb18033",
    "src/gate_a.py.asrun":
        "1ddb004b342c64ddcfefea9ee7b66303fbe07f22951303c485aaf559f306a260",
    "src/gate_b_floor.py.asrun":
        "c8caffa8fb48de6d3542a5439f84c35e4d74f1b1cab6710a154842ce20002c1a",
    "src/gatec_decomps.py.asrun":
        "e96e4f52053be7f02e23b3fd694c68845711da2c429ba887a8b2daa8e8229eed",
    "src/gatec_sweep.py.asrun":
        "0dcb5844f3065fa445d0f079d8e9055cf6f9d8158d9f78fb72bca50f7e4b4ed4",
    "src/new_decomp_offdiag.py.asrun":
        "b3046e6a6c506ffd5c78871a9f057770a552968314ac6fd225ad60e2b1d4e77c",
    "src/stapleton60_data.py.asrun":
        "70da1bfb64f8c51637e540eb19873449c712cb80b9d5f272de10020cbe5ee563",
    "src/tensor_data.py.asrun":
        "b55b18a8eb95fb950973b944a2e8c703bbba78d020a83a6ef3a32c36f9f8a793",
    "src/verify_anchors.py.asrun":
        "0ffcd100a4c08200f8c2d3aec04cf0a5e53b16c35daf99f596ac64daa91b3239",
}
RESERVED_OUTPUTS = (
    "run.log", "phaseA_controls.json",
    "decision_mws59.npz", "decision_mws59_summary.json",
    "decision_stapleton60.npz", "decision_stapleton60_summary.json",
    "pair_tables.npz", "campaign_result.json", "report.md",
    "checksums.sha256",
)


def sha256(path):
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def preflight():
    if os.environ.get("MM3_CAMPAIGN_RELEASED") != "1":
        raise RuntimeError("MM3 CPU slot not explicitly released")
    if not __debug__:
        raise RuntimeError("python -O is refused")
    for name in REQUIRED_ENVS:
        if os.environ.get(name) != "1":
            raise RuntimeError(f"{name} must equal 1")
    if os.nice(0) < 10:
        raise RuntimeError("process niceness must be at least 10")
    for relative, expected in EXPECTED.items():
        actual = sha256(ASRUN / relative)
        if actual != expected:
            raise RuntimeError(
                f"frozen dependency mismatch for {relative}: "
                f"{actual} != {expected}")
    occupied = [
        name for name in RESERVED_OUTPUTS
        if os.path.lexists(CAMPAIGN / name)
    ]
    staged = [path.name for path in CAMPAIGN.glob("*.tmp")]
    if occupied or staged:
        raise RuntimeError(
            f"write-once release refused; occupied={occupied}, "
            f"staged={staged}")


preflight()

def load(name, path):
    loader = SourceFileLoader(name, str(path))
    spec = spec_from_loader(name, loader)
    module = module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


print("MM3 frozen perimeter PASS: release, resources, hashes, outputs")
if sys.argv[1:]:
    if sys.argv[1:] == ["--check-only"]:
        print("MM3 CHECK ONLY: no module import or target computation")
        raise SystemExit(0)
    raise RuntimeError(f"unexpected launcher arguments: {sys.argv[1:]}")
for name in ("tensor_data", "stapleton60_data", "sun56_verify", "gate_a", "gatec_decomps", "gate_b_floor", "gatec_sweep", "verify_anchors"):
    filename = name + ".py.asrun"
    root = SCRATCH if name == "sun56_verify" else SRC
    load(name, root / filename)

namespace = runpy.run_path(str(SRC / "new_decomp_offdiag.py.asrun"), run_name="mm3_frozen_asrun")
namespace["SRC"] = SRC
namespace["SCRATCH"] = SCRATCH
namespace["run_campaign"](CAMPAIGN)
