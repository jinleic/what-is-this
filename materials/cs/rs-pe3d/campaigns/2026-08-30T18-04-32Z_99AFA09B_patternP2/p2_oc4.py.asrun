import json
from fractions import Fraction
oc2 = json.loads(open("scratch/p2_oc2.json").read())
print("OC4 confirmation from frozen rows:")
for cls in ("coprime", "non_coprime"):
    sub1 = sorted({v["rho"] for v in oc2[cls].values() if Fraction(v["rho"]) < 1}, key=Fraction)
    sub1_incl1 = sorted({v["rho"] for v in oc2[cls].values()}, key=Fraction)
    print(f"  {cls}: distinct values incl 1: {sub1_incl1} ({len(sub1_incl1)}); strictly below 1: {sub1} ({len(sub1)})")
# Owner's OC4: 7 coprime rows take only two distinct ratios {1, 3/5}; 6 non-coprime rows take five {1/4, 3/8, 1/2, 3/5, 1}
cop_c = sorted({v["rho"] for v in oc2["coprime"].values()}, key=Fraction)
non_c = sorted({v["rho"] for v in oc2["non_coprime"].values()}, key=Fraction)
owner_c = ["3/5", "1/1"]; owner_n = ["1/4", "3/8", "1/2", "3/5", "1/1"]
print("  Coprime values == owner's {1, 3/5}:", cop_c == owner_c)
print("  Non-coprime values == owner's five:", non_c == owner_n)
res = {"coprime_values": cop_c, "non_coprime_values": non_c,
       "owner_check_confirmed": cop_c == owner_c and non_c == owner_n}
json.dump(res, open("scratch/p2_oc4.json","w"), indent=2)
print("written scratch/p2_oc4.json")
