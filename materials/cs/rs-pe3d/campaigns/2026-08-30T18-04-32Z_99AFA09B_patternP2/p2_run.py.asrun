"""P2 battery runner: pre-registered in
campaigns/2026-08-30T18-04-32Z_99AFA09B_patternP2/pre_statement.md (committed
BEFORE any computation). Reuses the frozen gate-B machinery unmodified:
weight<=3 point-support census, normalized reduced-basis candidate class,
exact HiGHS MILP re-verified in F_q, per-witness exhaustive cheaper-tuple
closure. Checkpoint after EVERY instance."""
import json, itertools, time, datetime as dt, sys, platform
from pathlib import Path
from fractions import Fraction
from src.campaign import _code_hash, _normalize, _profile_census
from src.delta import DeltaEngine
from src.milp import delta_milp
from src.rs import Inst
from src.verify import verify_record
from src.field import rref
from src.gateb import beta_of, proof_delta

CKPT = Path("scratch/p2_checkpoint.json")
MILP_LIMIT = 120.0

def ckpt_write(state):
    CKPT.parent.mkdir(parents=True, exist_ok=True)
    tmp = CKPT.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(state, indent=2, sort_keys=True) + "\n")
    tmp.replace(CKPT)

def unit_anchor():
    from src.units import anchor2
    t0 = time.monotonic()
    res = anchor2()
    res["seconds"] = round(time.monotonic() - t0, 3)
    res["anchor_ok"] = res["rho_exact"] == "1/3" and res["V_nonzero_count"] == 5**7 - 1
    return res

def run_instance(spec):
    inst = Inst(spec["q"], spec["s"], spec["t"])
    start = time.monotonic()
    engine = DeltaEngine(inst)
    census, candidates = _profile_census(inst, engine, 3)
    best = None
    for M, info in sorted(candidates.items()):
        result = delta_milp(inst, list(M), time_limit=MILP_LIMIT)
        if result.status not in {"kOptimal", "kModelOptimal"}:
            continue
        wt = sum(x != 0 for x in M)
        ratio = Fraction(wt, result.objective)
        if best is None or ratio < best[0]:
            record = {
                "id": spec["id"], "q": inst.q, "s": list(inst.s), "t": list(inst.t),
                "lam": [list(x) for x in inst.lam], "M": list(M),
                "weight": wt, "delta": result.objective,
                "components": [list(x) for x in result.components],
                "coefficients": [[list(c) for c in rows_] for rows_ in result.coefficients],
            }
            best = (ratio, wt, result.objective, record)
    if best is None:
        raise AssertionError(f"no optimal candidate rows for {spec['id']}")
    ratio, wt, delta, record = best
    checked = verify_record(record, check_lower=False)
    if not checked["ok"]:
        raise AssertionError((spec["id"], checked))
    engine2 = DeltaEngine(inst)
    if not hasattr(engine2, "rank_cache"):
        engine2.rank_cache = {}
    proof = proof_delta(engine2, record["M"], delta)
    row = {
        "id": spec["id"], "q": inst.q, "s": list(inst.s), "t": list(inst.t),
        "N": inst.N, "V_dim": engine.V_dim(),
        "beta": f"{beta_of(spec['s']).numerator}/{beta_of(spec['s']).denominator}",
        "coprime": (spec["s"][0]*spec["s"][1]//__import__('math').gcd(spec["s"][0],spec["s"][1]) ,),
        "support_window": "all point supports of weight <= 3",
        "candidate_class": "normalized reduced basis of each V n F^S",
        "candidate_count_total": len(candidates),
        "rho_window": f"{ratio.numerator}/{ratio.denominator}",
        "weight": wt, "delta": delta,
        "attained_in_window": len(record["M"]) <= 3 and wt <= 3,
        "delta_proven_exact_for_best_witness": proof["proved"],
        "proof_cheaper_hit": proof["cheaper_hit"],
        "proof_equal_hits": proof["equal_hits"],
        "evidence_label": ("MACHINE-VERIFIED (finite window)" if proof["proved"] else "COMPUTATIONAL-EVIDENCE"),
        "seconds": round(time.monotonic() - start, 3),
    }
    return row, record

INSTANCES = [
    {"id": "PP1", "q": 13,  "s": (2,3,4),  "t": (1,1,1), "pred": "3/5"},
    {"id": "PP2", "q": 43,  "s": (2,3,7),  "t": (1,1,1), "pred": "3/5"},
    {"id": "PP3", "q": 97,  "s": (2,3,8),  "t": (1,1,1), "pred": "3/5"},
    {"id": "PP4", "q": 109, "s": (2,3,9),  "t": (1,1,1), "pred": "3/5"},
    {"id": "PP5", "q": 67,  "s": (2,3,11), "t": (1,1,1), "pred": "3/5"},
    {"id": "PP6", "q": 157, "s": (2,3,13), "t": (1,1,1), "pred": "3/5"},
    {"id": "PP7", "q": 97,  "s": (2,3,16), "t": (1,1,1), "pred": "3/5"},
    {"id": "PP8", "q": 601, "s": (2,3,25), "t": (1,1,1), "pred": "3/5"},
    {"id": "PP9", "q": 193, "s": (2,3,32), "t": (1,1,1), "pred": "3/5"},
    {"id": "PN1", "q": 41,  "s": (2,4,5),  "t": (1,1,1), "pred": "!3/5"},
    {"id": "PN2", "q": 71,  "s": (2,5,7),  "t": (1,1,1), "pred": "!3/5"},
    {"id": "PN3", "q": 211, "s": (3,5,7),  "t": (1,1,1), "pred": "!3/5"},
    {"id": "PN4", "q": 421, "s": (4,5,7),  "t": (1,1,1), "pred": "!3/5"},
    {"id": "PN5", "q": 61,  "s": (4,5,6),  "t": (1,1,1), "pred": "!3/5"},
    {"id": "PN6", "q": 43,  "s": (2,6,7),  "t": (1,1,1), "pred": "!3/5"},
    {"id": "PN7", "q": 337, "s": (3,4,7),  "t": (1,1,1), "pred": "!3/5"},
    {"id": "PN8", "q": 11,  "s": (2,2,5),  "t": (1,1,1), "pred": "!3/5"},
    {"id": "PN9", "q": 17,  "s": (2,2,8),  "t": (1,1,1), "pred": "!3/5"},
    {"id": "PN10","q": 281, "s": (5,7,8),  "t": (1,1,1), "pred": "!3/5"},
]

def main():
    started = dt.datetime.now(dt.timezone.utc).isoformat()
    state = {
        "campaign": "2026-08-30T18-04-32Z_99AFA09B_patternP2",
        "prestatement": "campaigns/2026-08-30T18-04-32Z_99AFA09B_patternP2/pre_statement.md",
        "started_utc": started, "python": sys.version, "platform": platform.platform(),
        "code_sha256": _code_hash(), "phase": "unit-anchor", "rows": [], "unit_anchor": None,
    }
    ckpt_write(state); print("checkpoint written (pre-anchor)", flush=True)

    unit = unit_anchor()
    state["unit_anchor"] = unit; state["phase"] = "unit-anchor-done"; ckpt_write(state)
    print(f"unit anchor rho={unit['rho_exact']} ok={unit['anchor_ok']} ({unit['seconds']}s)", flush=True)
    if not unit["anchor_ok"]:
        state["phase"] = "UNIT-ANCHOR-FAILED"; ckpt_write(state)
        print("UNIT ANCHOR FAILED - stopping", flush=True); return 1

    done_ids = {r["id"] for r in state["rows"]}
    for spec in INSTANCES:
        if spec["id"] in done_ids:
            print("skip (already done):", spec["id"], flush=True); continue
        t0 = time.monotonic()
        try:
            row, record = run_instance(spec)
            row["prediction"] = spec["pred"]
            row["P_match"] = (row["rho_window"] == "3/5") if spec["pred"] == "3/5" else (row["rho_window"] != "3/5")
            state["rows"].append(row)
            state.setdefault("records", {})[spec["id"]] = record
            state["phase"] = f"done-{spec['id']}"
            ckpt_write(state)
            print(f"{spec['id']} q={spec['q']} s={spec['s']} beta={row['beta']} rho^window={row['rho_window']} "
                  f"wt={row['weight']} delta={row['delta']} proved={row['delta_proven_exact_for_best_witness']} "
                  f"pred={spec['pred']} P_match={row['P_match']} ({row['seconds']}s)", flush=True)
        except Exception as exc:
            state["phase"] = f"FAILED-{spec['id']}"
            state.setdefault("failures", []).append(
                {"id": spec.get("id"), "error": repr(exc), "at": dt.datetime.now(dt.timezone.utc).isoformat()})
            ckpt_write(state)
            raise
    state["phase"] = "complete"
    state["finished_utc"] = dt.datetime.now(dt.timezone.utc).isoformat()
    ckpt_write(state)
    print("all rows complete", flush=True)
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
