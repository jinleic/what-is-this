"""Vectorized wt<=3 census count for PN5, PN6, PN7, PN10 (candidates only,
no optimization) — establishes whether their windows are empty like PN4's."""
import itertools, time, sys
import numpy as np
from src.rs import Inst
from src.delta import DeltaEngine
from src.field import rref

def rref_numpy(mat, qq):
    M = mat % qq; piv = []; r = 0
    for c in range(M.shape[1]):
        if r >= M.shape[0]: break
        nz = np.flatnonzero(M[r:, c] % qq)
        if len(nz) == 0: continue
        p = r + nz[0]
        if p != r: M[[r, p]] = M[[p, r]]
        inv = pow(int(M[r, c]), -1, qq)
        M[r] = (M[r] * inv) % qq
        colv = M[:, c].copy(); colv[r] = 0
        nzr = np.flatnonzero(colv)
        if len(nzr): M[nzr] = (M[nzr] - np.outer(colv[nzr], M[r])) % qq
        piv.append(c); r += 1
    return M % qq, piv

specs = [("PN5",61,(4,5,6)),("PN6",43,(2,6,7)),("PN7",337,(3,4,7)),("PN10",281,(5,7,8))]
for k, q, s in specs:
    inst = Inst(q, s, (1,1,1))
    engine = DeltaEngine(inst)
    B = np.array(engine.V_basis(), dtype=np.int64)
    qq = int(inst.q); d, N = B.shape
    all_S = [S for w in (1,2,3) for S in itertools.combinations(range(N), w)]
    n_nonzero = 0; n_cand = 0
    t0 = time.monotonic()
    for idx, S in enumerate(all_S):
        off = np.array([c for c in range(N) if c not in S])
        rr, piv = rref_numpy(B[:, off].T % qq, qq)
        free = [c for c in range(d) if c not in piv]
        if free:
            n_nonzero += 1
            n_cand += len(free)
    rate = len(all_S) / (time.monotonic() - t0)
    print(f"{k} q={q} s={s} N={N}: supports={len(all_S)} nonzero_supports={n_nonzero} raw_basis_vectors={n_cand} ({rate:.0f}/s)", flush=True)
