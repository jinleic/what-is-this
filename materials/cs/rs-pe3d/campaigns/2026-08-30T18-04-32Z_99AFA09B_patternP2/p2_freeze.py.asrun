"""P2 freeze: regenerate every artifact from raw records, verify every
witness in exact F_q, recompute every ratio as Fraction(wt, delta), write
payload/witnesses/optimality/manifest/checksums. Scripts byte-copied."""
import datetime as dt, hashlib, json, platform, sys
from fractions import Fraction
from math import comb, gcd
from pathlib import Path
from src.campaign import _code_hash
from src.verify import verify_record

ROOT = Path(".").resolve()
CAMP = ROOT / "campaigns" / "2026-08-30T18-04-32Z_99AFA09B_patternP2"
GB = ROOT / "campaigns" / "2026-08-30T11-43-59Z_50595CC9_fffe84b0_gateB"

state = json.loads((ROOT/"scratch/p2_checkpoint.json").read_text())
oc1 = json.loads((ROOT/"scratch/p2_oc1.json").read_text())
oc2 = json.loads((ROOT/"scratch/p2_oc2.json").read_text())
oc4 = json.loads((ROOT/"scratch/p2_oc4.json").read_text())
hgate_op = json.loads((ROOT/"scratch/p2_hgate_order_proof.json").read_text())

# ---- regenerate rows: verify witnesses, recompute ratios ----
recs = state.get("records", {})
regen = []
for row in state["rows"]:
    rid = row["id"]
    out = {k: row[k] for k in ("id","q","s","t","N","beta","coprime") if k in row}
    if row.get("window_empty"):
        out.update({
            "rho_window": None, "window_empty": True,
            "empty_census_supports": row["empty_census_supports"],
            "empty_census_complete": True,
            "empty_census_method": "vectorized kernel over V-basis (rref), complete over all supports of weight<=3; cross-checked against frozen _profile_census on non-empty instances PN6 (3486=3486) and PP2 (917=917)",
            "prediction": row["prediction"], "outcome": "UNTESTABLE-in-window",
            "P_match": "UNTESTABLE-in-window (window empty; NOT a miss, NOT a confirmation)",
            "evidence_label": "MACHINE-VERIFIED (empty-window census fact)",
        })
        regen.append(out)
        continue
    rec = recs.get(rid)
    if rec is not None:
        chk = verify_record(rec, check_lower=False)
        ratio = Fraction(rec["weight"], rec["delta"])
        ratio_str = f"{ratio.numerator}/{ratio.denominator}"
        assert ratio_str == row["rho_window"], (rid, ratio_str, row["rho_window"])
        out.update({
            "rho_window": ratio_str, "weight": rec["weight"], "delta": rec["delta"],
            "witness_verified_in_freeze": chk["ok"],
            "delta_proven_exact_for_best_witness": row["delta_proven_exact_for_best_witness"],
            "proof_cheaper_hit": row.get("proof_cheaper_hit"),
            "proof_equal_hits": row.get("proof_equal_hits"),
            "candidate_count_total": row.get("candidate_count_total"),
            "prediction": row["prediction"],
            "P_match": (ratio_str == "3/5") if row["prediction"] == "3/5" else (ratio_str != "3/5"),
            "evidence_label": "MACHINE-VERIFIED (finite window)",
        })
    else:
        # PN6/PN7: witnesses live in their scratch result files; regenerate+verify here
        src = json.loads((ROOT/f"scratch/p2_{rid.lower()}_result.json").read_text())
        rec = src["record"]
        chk = verify_record(rec, check_lower=False)
        ratio = Fraction(rec["weight"], rec["delta"])
        ratio_str = f"{ratio.numerator}/{ratio.denominator}"
        assert ratio_str == row["rho_window"], (rid, ratio_str, row["rho_window"])
        out.update({
            "rho_window": ratio_str, "weight": rec["weight"], "delta": rec["delta"],
            "witness_verified_in_freeze": chk["ok"],
            "delta_proven_exact_for_best_witness": src["proof"]["proved"],
            "proof_cheaper_hit": src["proof"]["cheaper_hit"],
            "proof_equal_hits": src["proof"]["equal_hits"],
            "candidate_count_total": src["candidate_count"],
            "prediction": row["prediction"],
            "P_match": (ratio_str == "3/5") if row["prediction"] == "3/5" else (ratio_str != "3/5"),
            "evidence_label": "MACHINE-VERIFIED (finite window)",
            "census_method": "vectorized kernel over V-basis, cross-checked vs frozen _profile_census on PN6/PP2",
        })
        recs[rid] = rec
    regen.append(out)

# ---- P and H-COP adjudication ----
pp_rows = [r for r in regen if r["id"].startswith("PP")]
pn_live = [r for r in regen if r["id"].startswith("PN") and not r.get("window_empty")]
pn_empty = [r for r in regen if r.get("window_empty")]
pp_hits = sum(1 for r in pp_rows if r["P_match"])
pp_misses = [r for r in pp_rows if not r["P_match"]]
pn_hits = sum(1 for r in pn_live if r["P_match"])
pn_misses = [r for r in pn_live if not r["P_match"]]

# H-COP adjudication over landing rows (empty rows contribute nothing)
cop_live = [r for r in regen if r.get("coprime") and not r.get("window_empty")]
noncop_live = [r for r in regen if not r.get("coprime") and not r.get("window_empty")]
hcopa_vals = sorted({r["rho_window"] for r in cop_live}, key=Fraction)
hcopa_ok = all(r["rho_window"] in ("1/1","3/5") for r in cop_live)
npred_rows = [r for r in cop_live if r["id"].startswith("PN")]
hcopa_np_ok = all(r["rho_window"] == "1/1" for r in npred_rows)
sub1 = sorted({Fraction(r["rho_window"]) for r in noncop_live if Fraction(r["rho_window"]) < 1})
hcopb_ok = len(sub1) >= 3

P_verdict = {
    "arm_PP": {"rows": 9, "hits": pp_hits, "misses": len(pp_misses),
               "detail": {r["id"]: r["rho_window"] for r in pp_rows},
               "label": "STRONG prediction (exactly 3/5, one of five observed values)"},
    "arm_PN": {"rows_landed": len(pn_live), "rows_empty_window": len(pn_empty),
               "hits": pn_hits, "misses": len(pn_misses),
               "detail": {r["id"]: r["rho_window"] for r in pn_live},
               "label": "WEAK prediction (anything but 3/5); empty-window rows untestable"},
    "overall": "P SURVIVES THE SECOND BATTERY: 9/9 on the discriminating arm, 3/3 landed on the weak arm, 3 untestable-in-window (PN4, PN5, PN10). P is NOT falsified. Out-of-sample record now 2 batteries + B11.",
    "not_a_theorem": "P remains a window-level order-pattern hypothesis at t=(1,1,1), Lambda=Id; every value here is rho^window, not rho_inst.",
    "falsification_condition_restated": "any PP row != 3/5 or any PN row == 3/5 ends P (none occurred)",
    "uniform_null_context": "(1/5)^9 ~ 2.0e-7 on the PP arm if the five observed corpus values were equally likely - an ILLUSTRATIVE figure, not a rigorously defined null; labeled as such",
}
HCOP_verdict = {
    "H-COP.a": {"coprime_landed_rows": {r["id"]: r["rho_window"] for r in cop_live},
                "all_in_{1,3/5}": hcopa_ok, "no_pair_coprime_exactly_1": hcopa_np_ok,
                "rows_with_empty_window": [r["id"] for r in regen if r.get("coprime") and r.get("window_empty")]},
    "H-COP.b": {"noncoprime_landed_rows": {r["id"]: r["rho_window"] for r in noncop_live},
                "distinct_sub1_values": [f"{v.numerator}/{v.denominator}" for v in sub1],
                "count": len(sub1), "needed_ge_3": True, "holds": hcopb_ok},
    "verdict": "FALSIFIED: H-COP.a holds (all coprime landed rows in {1, 3/5}, the no-pair ones exactly 1), but H-COP.b FAILS - all landed non-coprime rows are at 1 or 3/5, only ONE distinct sub-1 value instead of >= 3. The frozen-table five-value richness {1/4, 3/8, 1/2, 3/5, 1} did NOT reproduce on new non-coprime battery rows.",
    "owner_record_note": "Main's structural-hypothesis ledger: this falsifies H-COP (reframed from Main's OC4 observation). OC4's description of the frozen 13 was exact (scratch/p2_oc4.json); its generalization to new rows fails.",
    "caveat": "H-COP.b's battery rows skew to t=landing small-N instances; PN4/PN5/PN10 (the larger non-coprime/cop-row heavies) are untestable-in-window. Falsification is on the landed set.",
}

HGATE_verdict = {
    "prediction_source": "Main message, committed as addendum_HGATE_prediction.md + scratch/p2_hgate_order_proof.json BEFORE PN10 census finished",
    "statement": "weight<=3 window non-empty iff min(s) <= 3 (min(s) >= 4 => empty)",
    "prospective_test": {"row": "PN10", "s": [5,7,8], "min_s": 5,
                         "census_supports": 3658900, "nonzero_supports": 0,
                         "outcome": "EMPTY as predicted"},
    "retro_labeled": {"PN4": {"s": [4,5,7], "min_s": 4, "empty": True},
                      "PN5": {"s": [4,5,6], "min_s": 4, "empty": True},
                      "PN6": {"s": [2,6,7], "min_s": 2, "empty": False},
                      "PN7": {"s": [3,4,7], "min_s": 3, "empty": False}},
    "battery_verdict": "CONFIRMED on the battery: 3/3 empty at min(s)>=4, 3/3 non-empty at min(s)<=3 (PN1 min=2, PN2 min=2, PN3 min=3, PN6 min=2 also landed non-empty).",
    "frozen_table_consistency": "all 13 frozen rows have min(s) <= 3 and all have non-empty windows",
    "status": "EVIDENCE (15 rows consistent, one prospective confirmation); mechanism from the dual product code NOT yet derived - OPEN; Main's caveats (single prior empty point, possible confound) inherited",
    "significance": "If it holds, the gate-B programme's effective domain is exactly {instances with an order <= 3}: every ratio this target ever reported is conditional on that predicate (rule-15 named domain).",
}

rows_order_check = {
    (r["id"], r.get("P_match")) for r in regen if not r.get("window_empty")
}

payload = {
    "campaign": CAMP.name,
    "gate": "B-extension (P2 battery)",
    "agent": "RsPe3dPatternP",
    "pre_statement": "pre_statement.md committed as this directory's FIRST file (git bf541f0) BEFORE any battery computation; order proof scratch/p2_hgate_order_proof.json + prediction_order proof inside pre_statement",
    "utc_frozen": dt.datetime.now(dt.timezone.utc).isoformat(),
    "python": sys.version, "platform": platform.platform(),
    "code_sha256": _code_hash(),
    "fixed_parameters": {"t": [1,1,1], "Lambda": "identity on every axis",
                         "milp_limit_seconds": 120, "window": "weight<=3 supports, reduced-basis candidate class"},
    "owner_checks": {
        "OC1_rho_equals_wt_over_delta": {"confirmed": True,
            "detail": "13/13 frozen witnesses re-verified in exact F_q (verify_record) and every recorded ratio equals Fraction(weight, delta) recomputed from the witness",
            "per_row": oc1},
        "OC2_P_within_coprimality_classes": {"confirmed": True, "per_class": oc2,
            "labels": {"coprime": "7 rows (B01,B02,B03,B10,B11,B12,B13): 3/5 iff contains {2,3} (3 rows 3/5, 4 rows 1)", "non_coprime": "6 rows (B04,B05,B06,B07,B08,B09): 3/5 iff contains {2,3} (2 rows 3/5, 4 rows not)"}},
        "OC4_ratio_set_observation": {"description_confirmed": oc4["owner_check_confirmed"],
            "coprime_values": oc4["coprime_values"], "non_coprime_values": oc4["non_coprime_values"],
            "label": "owner observation confirmed as a DESCRIPTION of the frozen 13; its generalization (H-COP) was pre-registered and FALSIFIED"},
    },
    "pattern_P": P_verdict,
    "pattern_HCOP": HCOP_verdict,
    "pattern_HGATE": HGATE_verdict,
    "rows": regen,
    "rule7_swept_set": (
        "t=(1,1,1), Lambda=Id, the 19 pre-registered (q,s) pairs q in {11,13,17,41,43,61,67,71,97,109,157,193,211,281,337,421,601} "
        "with s as fixed in pre_statement P2-2; witnesses restricted to weight<=3 supports (complete census per instance) and the "
        "normalized reduced-basis candidate class; per-witness delta exactly closed at the best witness (all cheaper line-tuples absent, "
        ">=1 present). PN4/PN5/PN10 windows are EMPTY (complete censuses 457,450 / 288,100 / 3,658,900 supports, zero nonzero V n F^S) "
        "so they certify the emptiness fact, not a ratio."
    ),
    "rule7_not_swept": [
        "supports of weight >= 4 (OPEN everywhere; H-GATE evidence suggests weight-4 supports are where the action is at min(s)>=4)",
        "non-basis field values inside dim>1 intersections",
        "t != (1,1,1); eta binding constraints; non-identity Lambda",
        "all (q,s) pairs not in the 19-row list; the frozen 13 rows NOT re-run (non-goal)",
        "global rho_inst: each landing row certifies only [1/(3N), rho^window]",
        "continuous beta; every asymptotic statement; TR26-150's truth itself (untouched)",
    ],
    "tool_versions": {"python": sys.version.split()[0], "highspy": "1.15.1",
                      "python-flint": "0.9.0", "sympy": "1.14.0",
                      "numpy": "2.4.3 (kernel) / 2.5.2 (venv runs)",
                      "solver": "HiGHS via highspy, exact modular MILP, every solution re-checked in F_q"},
    "evidence_labels": {
        "landing_rows": "MACHINE-VERIFIED (finite window): exact F_q verification + exhaustive per-witness cheaper-tuple closure",
        "empty_rows": "MACHINE-VERIFIED (empty-window census): complete censuses, zero nonzero supports",
        "oc_checks": "MACHINE-VERIFIED on frozen witnesses",
        "float_rows": "none",
    },
    "inheritance_disclosure": "battery reuses the frozen gate-B instrument (census->MILP->closure code, unchanged sha256 a9ff7e0a...); OC1/OC2/OC4 re-derived from frozen witnesses, not payload strings; PN1-PN3+PP* witnesses regenerated fresh inside this campaign; PN6/PN7 via vectorized kernel cross-checked against the frozen census on PN6/PP2.",
}

# ---- witnesses.json ----
witnesses_out = {"records": [recs[k] for k in sorted(recs)]}
(CAMP/"witnesses.json").write_text(json.dumps(witnesses_out, indent=2, sort_keys=True) + "\n")
(CAMP/"payload.json").write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
(CAMP/"optimality.json").write_text(json.dumps([
    {"id": r["id"], "q": r["q"], "s": r["s"], "rho_window": r.get("rho_window"),
     "weight": r.get("weight"), "delta": r.get("delta"),
     "delta_proven_exact_for_best_witness": r.get("delta_proven_exact_for_best_witness"),
     "window_empty": r.get("window_empty", False),
     "evidence_label": r["evidence_label"],
     "scope": "per-witness exact delta; best-in-window ratio; heavier supports OPEN; rho^window NOT rho_inst"}
    for r in regen], indent=2, sort_keys=True) + "\n")

# ---- scripts as byte copies ----
import shutil
byte_copies = {
    "/tmp/p2_run.py": "p2_run.py.asrun",
    "/tmp/p2_oc12.py": "p2_oc12.py.asrun",
    "/tmp/p2_oc2b.py": "p2_oc2b.py.asrun",
    "/tmp/p2_oc4.py": "p2_oc4.py.asrun",
    "/tmp/p2_pn7.py": "p2_pn7.py.asrun",
    "/tmp/p2_pn6.py": "p2_pn6.py.asrun",
    "/tmp/p2_diag3.py": "p2_diag3_pn4_census.py.asrun",
    "/tmp/p2_diag4.py": "p2_diag4_pn567_census.py.asrun",
    "/tmp/p2_diag5.py": "p2_diag5_pn10_census.py.asrun",
    "/tmp/p2_sanity_crosscheck.py": "p2_sanity_crosscheck.py.asrun",
    "/tmp/p2_freeze.py": "p2_freeze.py.asrun",
}
for src, dst in byte_copies.items():
    p = Path(src)
    if p.exists():
        shutil.copyfile(p, CAMP/dst)
# frozen scratch artifacts byte-copied into the freeze
for src, dst in [("scratch/p2_checkpoint.json","scratch_checkpoint_freeze_snapshot.json"),
                 ("scratch/p2_oc1.json","oc1.json"), ("scratch/p2_oc2.json","oc2.json"),
                 ("scratch/p2_oc4.json","oc4.json"),
                 ("scratch/p2_hgate_order_proof.json","hgate_order_proof.json"),
                 ("scratch/p2_pn6_result.json","pn6_result.json"),
                 ("scratch/p2_pn7_result.json","pn7_result.json"),
                 ("scratch/p2_pn10_result.json","pn10_result.json"),
                 ("scratch/p2_pn10_census.json","pn10_census_final_checkpoint.json")]:
    shutil.copyfile(ROOT/src, CAMP/dst)
# the pre-statement + order proof + HGATE addendum
shutil.copyfile(ROOT/"scratch"/"p2_order_proof.json", CAMP/"order_proof.json")

# ---- checksums last ----
sums = {}
for p in sorted(CAMP.iterdir()):
    if p.is_file() and p.name not in ("manifest.json", "checksums.sha256"):
        sums[p.name] = hashlib.sha256(p.read_bytes()).hexdigest()
(CAMP/"checksums.sha256").write_text("".join(f"{v}  {k}\n" for k, v in sums.items()))

manifest = {
    "campaign": CAMP.name, "gate": "B-extension (P2 battery)", "agent": "RsPe3dPatternP",
    "utc_frozen": dt.datetime.now(dt.timezone.utc).isoformat(),
    "rows_total": len(regen),
    "rows_landed_with_ratio": sum(1 for r in regen if not r.get("window_empty")),
    "rows_empty_window": [r["id"] for r in regen if r.get("window_empty")],
    "pattern_P_verdict": P_verdict["overall"],
    "pattern_HCOP_verdict": HCOP_verdict["verdict"],
    "pattern_HGATE_verdict": HGATE_verdict["battery_verdict"],
    "owner_checks": "OC1/OC2/OC4-description all confirmed on frozen witnesses (see payload.owner_checks)",
    "files": sums,
    "code_sha256": _code_hash(),
    "tool_versions": payload["tool_versions"],
    "reproduce": ("cd cs/rs-pe3d && PYTHONPATH=$PWD ../.venv/bin/python /tmp/p2_run.py (requires /tmp scripts restored from the .asrun byte-copies here) | verify witnesses: python -m src.verify <dir>/witnesses.json"),
    "frozen": "append-only; no file listed in checksums edited after this manifest",
}
(CAMP/"manifest.json").write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
print("FROZE", CAMP)
print("rows:", manifest["rows_total"], "landed:", manifest["rows_landed_with_ratio"], "empty:", manifest["rows_empty_window"])
print("P:", manifest["pattern_P_verdict"][:120])
print("H-COP:", manifest["pattern_HCOP_verdict"][:120])
print("H-GATE:", manifest["pattern_HGATE_verdict"][:120])
