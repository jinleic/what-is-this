"""Instrument cross-check: the vectorized count-census (used for the empty-
window verdicts) and the frozen _profile_census must agree on a NON-empty
instance. Run both on PN6 (43,(2,6,7)) and PP2 (43,(2,3,7)): counts must
match exactly. This is the T-instrument trap check (rule 14: the fast kernel
must be able to see a nonzero window when one exists)."""
import itertools, json, time
import numpy as np
from src.rs import Inst
from src.delta import DeltaEngine
from src.field import rref
from src.campaign import _profile_census, _normalize

def rref_numpy(mat, qq):
    M = mat % qq; piv = []; r = 0
    for c in range(M.shape[1]):
        if r >= M.shape[0]: break
        nz = np.flatnonzero(M[r:, c] % qq)
        if len(nz) == 0: continue
        p = r + nz[0]
        if p != r: M[[r, p]] = M[[p, r]]
        inv = pow(int(M[r, c]), -1, qq)
        M[r] = (M[r] * inv) % qq
        colv = M[:, c].copy(); colv[r] = 0
        nzr = np.flatnonzero(colv)
        if len(nzr): M[nzr] = (M[nzr] - np.outer(colv[nzr], M[r])) % qq
        piv.append(c); r += 1
    return M % qq, piv

def fast_count_nonzero_supports(q, s):
    inst = Inst(q, s, (1,1,1))
    engine = DeltaEngine(inst)
    B = np.array(engine.V_basis(), dtype=np.int64)
    qq = int(inst.q); d, N = B.shape
    n_nonzero = 0; n_raw = 0
    for w in (1,2,3):
        for S in itertools.combinations(range(N), w):
            off = np.array([c for c in range(N) if c not in S])
            rr, piv = rref_numpy(B[:, off].T % qq, qq)
            free = [c for c in range(d) if c not in piv]
            if free:
                valid = 0
                for fc in free:
                    v = np.zeros(d, dtype=np.int64); v[fc] = 1
                    for i, pc in enumerate(piv):
                        v[pc] = (-int(rr[i][fc])) % qq
                    wv = (v @ B) % qq
                    if wv.any(): valid += 1
                if valid:
                    n_nonzero += 1; n_raw += valid
    return n_nonzero, n_raw

for q, s in [(43,(2,6,7)), (43,(2,3,7))]:
    inst = Inst(q, s, (1,1,1))
    engine = DeltaEngine(inst)
    census, cands = _profile_census(inst, engine, 3)
    frozen_nonzero = sum(len(v) for v in census["supports"].values())
    nn, nr = fast_count_nonzero_supports(q, s)
    ok = (frozen_nonzero == nn)
    print(f"q={q} s={s}: frozen_census_nonzero_supports={frozen_nonzero} fastcensus={nn} raw={nr} frozen_candidates={census['candidate_count']} MATCH={ok}")
    assert ok, "INSTRUMENT DISAGREEMENT"
print("instrument cross-check PASSED on both instances")
