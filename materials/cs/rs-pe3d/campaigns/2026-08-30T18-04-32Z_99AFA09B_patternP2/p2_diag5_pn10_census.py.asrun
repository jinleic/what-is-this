"""PN10 census count, checkpointed every 200k supports to scratch."""
import itertools, time, json
from pathlib import Path
import numpy as np
from src.rs import Inst
from src.delta import DeltaEngine

CKPT = Path("scratch/p2_pn10_census.json")

def rref_numpy(mat, qq):
    M = mat % qq; piv = []; r = 0
    for c in range(M.shape[1]):
        if r >= M.shape[0]: break
        nz = np.flatnonzero(M[r:, c] % qq)
        if len(nz) == 0: continue
        p = r + nz[0]
        if p != r: M[[r, p]] = M[[p, r]]
        inv = pow(int(M[r, c]), -1, qq)
        M[r] = (M[r] * inv) % qq
        colv = M[:, c].copy(); colv[r] = 0
        nzr = np.flatnonzero(colv)
        if len(nzr): M[nzr] = (M[nzr] - np.outer(colv[nzr], M[r])) % qq
        piv.append(c); r += 1
    return M % qq, piv

q, s = 281, (5,7,8)
inst = Inst(q, s, (1,1,1))
engine = DeltaEngine(inst)
B = np.array(engine.V_basis(), dtype=np.int64)
qq = int(inst.q); d, N = B.shape
all_S = [S for w in (1,2,3) for S in itertools.combinations(range(N), w)]
n_nonzero = 0; n_cand = 0; start = 0; t0 = time.monotonic()
if CKPT.exists():
    prev = json.loads(CKPT.read_text())
    start = prev["done"]; n_nonzero = prev["nonzero"]; n_cand = prev["raw"]
    print(f"resuming after {start}", flush=True)
for idx in range(start, len(all_S)):
    S = all_S[idx]
    off = np.array([c for c in range(N) if c not in S])
    rr, piv = rref_numpy(B[:, off].T % qq, qq)
    free = [c for c in range(d) if c not in piv]
    if free:
        n_nonzero += 1; n_cand += len(free)
    if (idx + 1) % 200000 == 0:
        tmp = CKPT.with_suffix(".json.tmp")
        tmp.write_text(json.dumps({"done": idx+1, "nonzero": n_nonzero, "raw": n_cand}) + "\n")
        tmp.replace(CKPT)
        rate = (idx + 1 - start) / (time.monotonic() - t0)
        print(f"  {idx+1}/{len(all_S)} nonzero={n_nonzero} rate={rate:.0f}/s", flush=True)
rate = (len(all_S) - start) / (time.monotonic() - t0)
print(f"PN10 DONE: supports={len(all_S)} nonzero_supports={n_nonzero} raw_basis_vectors={n_cand} ({rate:.0f}/s)")
