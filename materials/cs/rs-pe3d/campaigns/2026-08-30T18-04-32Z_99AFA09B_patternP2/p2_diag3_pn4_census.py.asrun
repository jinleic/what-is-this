"""Fast vectorized census count for PN4 (and later PN10): numpy rref kernel
over V-basis columns, from the frozen run_b11_fast approach."""
import itertools, time
import numpy as np
from src.rs import Inst
from src.delta import DeltaEngine
from src.field import rref
from src.campaign import _normalize

q, s = 421, (4,5,7)
inst = Inst(q, s, (1,1,1))
engine = DeltaEngine(inst)
B = np.array(engine.V_basis(), dtype=np.int64)
qq = int(inst.q)
d, N = B.shape
print(f"PN4: V basis {d}x{N}, q={qq}")

def rref_numpy(mat):
    M = mat % qq
    piv = []
    r = 0
    for c in range(M.shape[1]):
        if r >= M.shape[0]:
            break
        nz = np.flatnonzero(M[r:, c] % qq)
        if len(nz) == 0:
            continue
        p = r + nz[0]
        if p != r:
            M[[r, p]] = M[[p, r]]
        inv = pow(int(M[r, c]), -1, qq)
        M[r] = (M[r] * inv) % qq
        colv = M[:, c].copy(); colv[r] = 0
        nzr = np.flatnonzero(colv)
        if len(nzr):
            M[nzr] = (M[nzr] - np.outer(colv[nzr], M[r])) % qq
        piv.append(c); r += 1
    return M % qq, piv

def inter_support_v(S):
    off = np.array([c for c in range(N) if c not in S])
    rr, piv = rref_numpy(B[:, off].T % qq)
    free = [c for c in range(d) if c not in piv]
    if not free:
        return []
    out = []
    for fc in free:
        v = np.zeros(d, dtype=np.int64); v[fc] = 1
        for i, pc in enumerate(piv):
            v[pc] = (-int(rr[i][fc])) % qq
        w = (v @ B) % qq
        if w.any():
            out.append(w.tolist())
    return rref(out, qq)[0] if out else []

n_candidates = 0
n_supports_nonzero = 0
t0 = time.monotonic()
all_S = [S for w in (1,2,3) for S in itertools.combinations(range(N), w)]
print("supports:", len(all_S))
done = 0
for idx, S in enumerate(all_S):
    rb = inter_support_v(set(S))
    if rb:
        n_supports_nonzero += 1
        n_candidates += len(rb)
    done += 1
    if done % 50000 == 0:
        rate = done / (time.monotonic() - t0)
        print(f"  {done}/{len(all_S)}, nonzero_supports={n_supports_nonzero}, raw_cands={n_candidates}, {rate:.0f}/s", flush=True)
rate = done / (time.monotonic() - t0)
print(f"DONE: {done} supports, nonzero_supports={n_supports_nonzero}, raw_basis_vectors={n_candidates}, {rate:.0f}/s, {time.monotonic()-t0:.0f}s")
