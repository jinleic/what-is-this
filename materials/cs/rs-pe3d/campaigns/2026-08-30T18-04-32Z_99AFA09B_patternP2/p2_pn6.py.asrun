"""PN6 (43,(2,6,7)): census found 3486 raw basis vectors across 3486
nonzero supports. Optimize with fast enumeration (vectorized) + closure."""
import itertools, time, json, datetime as dt
from fractions import Fraction
import numpy as np
from src.rs import Inst
from src.delta import DeltaEngine
from src.field import rref
from src.campaign import _normalize
from src.milp import delta_milp
from src.verify import verify_record
from src.gateb import beta_of, proof_delta

def rref_numpy(mat, qq):
    M = mat % qq; piv = []; r = 0
    for c in range(M.shape[1]):
        if r >= M.shape[0]: break
        nz = np.flatnonzero(M[r:, c] % qq)
        if len(nz) == 0: continue
        p = r + nz[0]
        if p != r: M[[r, p]] = M[[p, r]]
        inv = pow(int(M[r, c]), -1, qq)
        M[r] = (M[r] * inv) % qq
        colv = M[:, c].copy(); colv[r] = 0
        nzr = np.flatnonzero(colv)
        if len(nzr): M[nzr] = (M[nzr] - np.outer(colv[nzr], M[r])) % qq
        piv.append(c); r += 1
    return M % qq, piv

q, s = 43, (2,6,7)
inst = Inst(q, s, (1,1,1))
engine = DeltaEngine(inst)
B = np.array(engine.V_basis(), dtype=np.int64)
qq = int(inst.q); d, N = B.shape
candidates = {}
all_S = [S for w in (1,2,3) for S in itertools.combinations(range(N), w)]
for S in all_S:
    off = np.array([c for c in range(N) if c not in S])
    rr, piv = rref_numpy(B[:, off].T % qq, qq)
    free = [c for c in range(d) if c not in piv]
    for fc in free:
        v = np.zeros(d, dtype=np.int64); v[fc] = 1
        for i, pc in enumerate(piv):
            v[pc] = (-int(rr[i][fc])) % qq
        w = (v @ B) % qq
        if w.any():
            M = _normalize(w.tolist(), qq)
            key = tuple(i for i, x in enumerate(M) if x)
            candidates.setdefault(key, M)
print(f"PN6 census: {len(candidates)} normalized candidates", flush=True)
wths = {}
for M in candidates.values():
    w = sum(1 for x in M if x)
    wths[w] = wths.get(w, 0) + 1
print("weight histogram:", wths, flush=True)

best = None
for n, key in enumerate(sorted(candidates)):
    M = candidates[key]
    result = delta_milp(inst, list(M), time_limit=120.0)
    if result.status not in {"kOptimal", "kModelOptimal"}:
        print("milp non-optimal at", key, result.status, flush=True); continue
    wt = sum(x != 0 for x in M)
    ratio = Fraction(wt, result.objective)
    if best is None or ratio < best[0]:
        record = {"id": "PN6", "q": inst.q, "s": list(inst.s), "t": list(inst.t),
                  "lam": [list(x) for x in inst.lam], "M": list(M), "weight": wt,
                  "delta": result.objective,
                  "components": [list(x) for x in result.components],
                  "coefficients": [[list(c) for c in rows_] for rows_ in result.coefficients]}
        eng2 = DeltaEngine(inst)
        if not hasattr(eng2, "rank_cache"): eng2.rank_cache = {}
        proof = proof_delta(eng2, record["M"], result.objective)
        best = (ratio, wt, result.objective, record, proof)
        print(f"  [{n+1}/{len(candidates)}] cand wt={wt} delta={result.objective} ratio={ratio} proved={proof['proved']}", flush=True)
    if (n+1) % 500 == 0:
        print(f"  progress {n+1}/{len(candidates)} best={best[0]}", flush=True)

ratio, wt, delta, record, proof = best
chk = verify_record(record, check_lower=False)
out = {"id": "PN6", "phase": "complete", "q": q, "s": list(s),
       "beta": f"{beta_of(s).numerator}/{beta_of(s).denominator}",
       "rho_window": f"{ratio.numerator}/{ratio.denominator}",
       "weight": wt, "delta": delta, "proof": proof, "verified": chk,
       "candidate_count": len(candidates), "weight_histogram": wths,
       "record": record, "utc": dt.datetime.now(dt.timezone.utc).isoformat()}
open("scratch/p2_pn6_result.json", "w").write(json.dumps(out, indent=2) + "\n")
print("PN6 FINAL:", f"{ratio.numerator}/{ratio.denominator}", "wt", wt, "delta", delta, "proved", proof["proved"])
