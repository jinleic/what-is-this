import sys, json
from pathlib import Path
from fractions import Fraction
from math import gcd
from src.campaign import _code_hash
from src.verify import verify_record

GB = Path("campaigns/2026-08-30T11-43-59Z_50595CC9_fffe84b0_gateB")
witnesses = json.loads((GB/"witnesses.json").read_text())
recs = {r["id"]: r for r in witnesses["records"]}

oc1 = {}
for rid in sorted(recs):
    rec = recs[rid]
    chk = verify_record(rec, check_lower=False)
    ratio = Fraction(rec["weight"], rec["delta"])
    oc1[rid] = {
        "verified_ok": bool(chk["ok"]),
        "ratio_from_witness_Fraction_wt_delta": f"{ratio.numerator}/{ratio.denominator}",
        "weight": rec["weight"], "delta": rec["delta"],
    }
print("OC1 rows verified:", sum(1 for v in oc1.values() if v["verified_ok"]), "/", len(oc1))

add = json.loads((GB/"pattern_P_rowwise_addendum.json").read_text())
mismatch = []
for row in add["rows"]:
    rid = row["id"]
    oc1[rid]["recorded_addendum_ratio"] = row["rho"]
    if oc1[rid]["ratio_from_witness_Fraction_wt_delta"] != row["rho"]:
        mismatch.append(rid)
print("OC1 ratio==recorded for all rows:", "YES" if not mismatch else mismatch)

pay = json.loads((GB/"payload.json").read_text())
coprime_rows = set(pay["coprime_rows"])
oc2 = {"coprime": {}, "non_coprime": {}}
for row in add["rows"]:
    rid = row["id"]; s = row["s"]; rho = row["rho"]
    is_coprime = gcd(gcd(s[0],s[1]), s[2]) == 1
    cls = "coprime" if is_coprime else "non_coprime"
    contains23 = (2 in s and 3 in s)
    oc2[cls][rid] = {"s": s, "rho": rho, "contains_2_and_3": contains23,
                     "coprime_flag_matches_payload": (rid in coprime_rows) == is_coprime}
for cls in ("coprime", "non_coprime"):
    rows = oc2[cls]
    ok_within = all((v["contains_2_and_3"] == (v["rho"] == "3/5")) for v in rows.values())
    vals = sorted({v["rho"] for v in rows.values()}, key=Fraction)
    flag_ok = all(v["coprime_flag_matches_payload"] for v in rows.values())
    print(f"OC2 {cls}: n={len(rows)} P_within_class={ok_within} payload_flags_ok={flag_ok} values={vals}")
    for rid, v in sorted(rows.items()):
        print("   ", rid, tuple(v["s"]), "rho=", v["rho"], "contains23=", v["contains_2_and_3"])

json.dump(oc1, open("scratch/p2_oc1.json","w"), indent=2)
json.dump(oc2, open("scratch/p2_oc2.json","w"), indent=2)
print("code_sha256:", _code_hash())
