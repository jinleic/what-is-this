"""B11 fast census: vectorized rref kernel for V n F^S, checkpoint every 50000
supports. Resumes from scratch/gateB_B11_census.json if present (it is not,
the earlier slow run wrote nothing yet). Optimization phase after census."""
import json, itertools, time, datetime as dt
from pathlib import Path
from fractions import Fraction
import numpy as np

from src.campaign import _normalize, _code_hash
from src.delta import DeltaEngine
from src.milp import delta_milp
from src.rs import Inst
from src.verify import verify_record
from src.field import rref
from src.gateb import beta_of, proof_delta

ROOT = Path('/Users/jinleic/jinleic-workspace/cs/rs-pe3d')
CKPT = ROOT / 'scratch' / 'gateB_B11_census.json'
RESULT = ROOT / 'scratch' / 'gateB_b11_result.json'

inst = Inst(241, (3,5,16), (1,1,1))
engine = DeltaEngine(inst)
B = np.array(engine.V_basis(), dtype=np.int64)
qq = int(inst.q)
d, N = B.shape

def rref_numpy(mat):
    M = mat % qq
    piv = []
    r = 0
    for c in range(M.shape[1]):
        if r >= M.shape[0]:
            break
        nz = np.flatnonzero(M[r:, c] % qq)
        if len(nz) == 0:
            continue
        p = r + nz[0]
        if p != r:
            M[[r, p]] = M[[p, r]]
        inv = pow(int(M[r, c]), -1, qq)
        M[r] = (M[r] * inv) % qq
        colv = M[:, c].copy()
        colv[r] = 0
        nzr = np.flatnonzero(colv)
        if len(nzr):
            M[nzr] = (M[nzr] - np.outer(colv[nzr], M[r])) % qq
        piv.append(c)
        r += 1
    return M % qq, piv

def inter_support_v(S):
    off = np.array([c for c in range(N) if c not in S])
    rr, piv = rref_numpy(B[:, off].T % qq)
    free = [c for c in range(d) if c not in piv]
    out = []
    for fc in free:
        v = np.zeros(d, dtype=np.int64)
        v[fc] = 1
        for i, pc in enumerate(piv):
            v[pc] = (-int(rr[i][fc])) % qq
        w = (v @ B) % qq
        if w.any():
            out.append(w.tolist())
    return rref(out, qq)[0] if out else []

def save(candidates, supports_done, phase):
    CKPT.parent.mkdir(parents=True, exist_ok=True)
    tmp = CKPT.with_suffix('.json.tmp')
    tmp.write_text(json.dumps({
        'phase': phase, 'supports_done': supports_done,
        'candidates': {','.join(map(str, k)): [list(v[0]), v[1]] for k, v in candidates.items()},
    }) + '\n')
    tmp.replace(CKPT)

candidates = {}
start_from = 0
if CKPT.exists():
    prev = json.loads(CKPT.read_text())
    for k, v in prev['candidates'].items():
        candidates[tuple(int(x) for x in k.split(','))] = [tuple(v[0]), v[1]]
    start_from = prev['supports_done']
    print(f'resuming after {start_from} supports, {len(candidates)} cands', flush=True)

all_S = [S for w in (1,2,3) for S in itertools.combinations(range(N), w)]
t0 = time.monotonic()
done = start_from
for idx in range(start_from, len(all_S)):
    S = all_S[idx]
    rb = inter_support_v(set(S))
    if rb:
        for vec in rb:
            M = _normalize(vec, inst.q)
            key = tuple(i for i, x in enumerate(M) if x)
            if key not in candidates:
                candidates[key] = [M, len(rb)]
    done += 1
    if done % 50000 == 0:
        save(candidates, done, 'census-running')
        rate = done / (time.monotonic() - t0)
        print(f'{done}/{len(all_S)}, {len(candidates)} cands, {rate:.0f}/s, eta {((len(all_S)-done)/rate)/60:.1f} min', flush=True)

save(candidates, done, 'census-complete')
print(f'CENSUS COMPLETE: {len(candidates)} candidates. Optimizing...', flush=True)

best = None
proof = None
for n, (key, info) in enumerate(sorted(candidates.items())):
    M = [int(x) for x in info[0]]
    result = delta_milp(inst, M, time_limit=120.0)
    if result.status not in {'kOptimal', 'kModelOptimal'}:
        print('milp non-optimal at', key, result.status, flush=True)
        continue
    wt = sum(x != 0 for x in M)
    ratio = Fraction(wt, result.objective)
    if best is None or ratio < best[0]:
        wt2, delta2 = wt, result.objective
        record = {
            'id': 'B11', 'q': inst.q, 's': list(inst.s), 't': list(inst.t),
            'lam': [list(x) for x in inst.lam], 'M': M, 'weight': wt,
            'delta': result.objective,
            'components': [list(x) for x in result.components],
            'coefficients': [[list(c) for c in rows_] for rows_ in result.coefficients],
        }
        eng2 = DeltaEngine(inst)
        if not hasattr(eng2, 'rank_cache'):
            eng2.rank_cache = {}
        proof = proof_delta(eng2, record['M'], delta2)
        best = (ratio, wt, delta2, record, proof)
        RESULT.write_text(json.dumps({
            'phase': 'optimized-running',
            'ratio': f'{ratio.numerator}/{ratio.denominator}',
            'weight': wt, 'delta': delta2, 'proof': proof,
            'verified': verify_record(record, check_lower=False),
        }, indent=2) + '\n')
    if n % 50 == 0:
        print(f'optimized {n+1}/{len(candidates)} best={best[0]}', flush=True)

ratio, wt, delta, record, proof = best
RESULT.write_text(json.dumps({
    'phase': 'complete',
    'ratio': f'{ratio.numerator}/{ratio.denominator}',
    'weight': wt, 'delta': delta, 'proof': proof,
    'verified': verify_record(record, check_lower=False),
    'record': record, 'candidate_count': len(candidates),
    'beta': f'{beta_of(inst.s).numerator}/{beta_of(inst.s).denominator}',
    'code_sha256': _code_hash(),
}, indent=2) + '\n')
print('B11 FINAL:', f'{ratio.numerator}/{ratio.denominator}', 'wt', wt, 'delta', delta, 'proof', proof, flush=True)
