"""Recompute + verify the best witness record for every completed gate-B row.
This is also an independent re-run of each row's ratio (second pass, same code,
fresh process): any disagreement with the checkpointed ratio is an error signal.
Incremental writes to scratch/gateB_witnesses.json after every row."""
import json, time
from pathlib import Path
from src.gateb import run_instance, INSTANCES
from src.verify import verify_record

ROOT = Path('/Users/jinleic/jinleic-workspace/cs/rs-pe3d')
CKPT = ROOT / 'scratch' / 'gateB_checkpoint.json'
OUT  = ROOT / 'scratch' / 'gateB_witnesses.json'

state = json.loads(CKPT.read_text())
rows = {r['id']: r for r in state['rows']}
specs = {s['id']: s for s in INSTANCES}

acc = {'records': [], 'reruns': []}
if OUT.exists():
    acc = json.loads(OUT.read_text())
done = {r['id'] for r in acc['records']}

order = ['B07','B03','B12','B09','B08','B02','B13','B04','B05','B06','B01','B10']
for sid in order:
    if sid in done or sid not in rows:
        continue
    t0 = time.monotonic()
    row, rec = run_instance(specs[sid])
    chk = verify_record(rec, check_lower=False)
    agree = row['ratio'] == rows[sid]['ratio']
    acc['records'].append(rec)
    acc['reruns'].append({'id': sid, 'ratio_first_pass': rows[sid]['ratio'],
                          'ratio_rerun': row['ratio'], 'agree': agree,
                          'verified_ok': chk['ok'], 'delta': row['delta'],
                          'weight': row['weight'],
                          'proved': row['delta_proven_exact_for_best_witness'],
                          'seconds': round(time.monotonic()-t0, 2)})
    OUT.write_text(json.dumps(acc, indent=2, sort_keys=True) + '\n')
    print(sid, 'rerun', row['ratio'], 'agree', agree, 'verified', chk['ok'],
          '%.1fs' % (time.monotonic()-t0), flush=True)
print('DISAGREEMENTS:', [r['id'] for r in acc['reruns'] if not r['agree']] or 'none')
