"""Controls part 1+2/3 (as run, reconstructed byte-faithfully from the session;
comments annotate which bg job each block corresponds to). All exact F_q.

bg_50: corner censuses C1/C2. bg_51: E3 w=3 census at (41,(4,4,5)) + E2 lines.
bg_2: E4 w<=2 at (61,(4,5,5)) + L1 Lambda draws. bg_7: A0 anchor PN6/PP2.
bg_45: E1 (61,(3,4,5)) + E2 dir-0 lines.
"""
import sys, itertools, time
sys.path.insert(0, '.')
import numpy as np
from src.rs import Inst
from src.delta import DeltaEngine
from src.field import rref


def in_span(rows_, vec, q):
    stacked = [list(map(int, r)) for r in rows_] + [list(map(int, vec))]
    rr, p1 = rref(stacked, q)
    rr2, p0 = rref([list(map(int, r)) for r in rows_], q)
    return len(p1) == len(p0)


def census_nonzero(qs, ss, wcap=3):
    """Vectorized wt<=wcap census: supports with a nonzero V-member."""
    inst = Inst(qs, ss, (1, 1, 1))
    eng = DeltaEngine(inst)
    B = np.array(eng.V_basis(), dtype=np.int64)
    qq = int(qs); d, N = B.shape
    nz = 0; tot = 0
    for w in range(1, wcap + 1):
        for S in itertools.combinations(range(N), w):
            off = [c for c in range(N) if c not in S]
            rr, piv = rref((B[:, off].T % qq).tolist(), qq)
            free = [c for c in range(d) if c not in piv]
            tot += 1
            if free:
                nz += 1
    return N, tot, nz


if __name__ == "__main__":
    t0 = time.monotonic()
    # E3: full w=3 census on P2 shape (41,(4,4,5))
    N, tot, nz = census_nonzero(41, (4, 4, 5), wcap=3)
    print(f"E3 (41,(4,4,5)): N={N} supports={tot} nonzero={nz}", flush=True)
    assert nz == 0
    # E2: every axis line carries a codeword
    inst = Inst(41, (4, 4, 5), (1, 1, 1))
    eng = DeltaEngine(inst)
    B = np.array(eng.V_basis(), dtype=np.int64); qq = int(41); d, N = B.shape
    for i in range(3):
        for x in range(inst.num_lines(i)):
            Sset = set(inst.line_indices(i, x))
            rr, piv = rref((B[:, [c for c in range(N) if c not in Sset]].T % qq).tolist(), qq)
            assert [c for c in range(d) if c not in piv], "missing line witness"
    print("E2: every axis line (w=d=4) carries a codeword  OK", flush=True)
    # E4 + L1
    N, tot, nz = census_nonzero(61, (4, 5, 5), wcap=2)
    print(f"E4 (61,(4,5,5)): w<=2 supports={tot} nonzero={nz}", flush=True)
    assert nz == 0
    import random
    random.seed(20260831)
    base = DeltaEngine(Inst(13, (2, 2, 4), (1, 1, 1))).V_dim()
    assert base == 13
    for _ in range(3):
        lam = [[random.randrange(1, 13) for _ in range(2)],
               [random.randrange(1, 13) for _ in range(2)],
               [random.randrange(1, 13) for _ in range(4)]]
        assert DeltaEngine(Inst(13, (2, 2, 4), (1, 1, 1), lam=lam)).V_dim() == base
    print("L1: Lambda-uniformity dim V = 13 on 3 draws  OK", flush=True)
    # A0 anchor
    for q, s, exp in [(43, (2, 6, 7), 3486), (43, (2, 3, 7), 917)]:
        N, tot, nz = census_nonzero(q, s, wcap=3)
        assert nz == exp, (q, s, nz, exp)
        print(f"A0 ({q},{s}): nonzero={nz} == frozen {exp}  OK", flush=True)
    # E1 + corners + T1 + delta closures
    for q, s, wcap in [(61, (3, 4, 5), 2)]:
        N, tot, nz = census_nonzero(q, s, wcap=wcap)
        print(f"E1 ({q},{s}): w<={wcap} supports={tot} nonzero={nz}", flush=True)
        assert nz == 0
    for qs, ss in [(5, (1, 2, 2)), (7, (1, 2, 3))]:
        N, tot, nz = census_nonzero(qs, ss, wcap=3)
        print(f"CORNER ({qs},{ss}): supports={tot} nonzero={nz}", flush=True)
        assert nz == tot
    inst = Inst(13, (2, 2, 4), (1, 1, 1))
    eng = DeltaEngine(inst)
    s = inst.s; N = inst.N
    rows = []
    for a1 in range(s[1]):
        for a2 in range(s[2]):
            v = [0] * N
            for a0 in range(s[0]): v[(a0*s[1]+a1)*s[2]+a2] = 1
            rows.append(v)
    for a0 in range(s[0]):
        for a2 in range(s[2]):
            v = [0] * N
            for a1 in range(s[1]): v[(a0*s[1]+a1)*s[2]+a2] = 1
            rows.append(v)
    for a0 in range(s[0]):
        for a1 in range(s[1]):
            v = [0] * N
            for a2 in range(s[2]): v[(a0*s[1]+a1)*s[2]+a2] = 1
            rows.append(v)
    rr, piv = rref(rows, inst.q)
    assert len(piv) == eng.V_dim() == 13
    assert all(in_span(rows, b, inst.q) for b in eng.V_basis())
    print("T1: V == triple-sum space at (13,(2,2,4))  OK", flush=True)
    inst1 = Inst(17, (4, 4, 4), (1, 1, 1))
    eng1 = DeltaEngine(inst1)
    M = [1 if c in set(inst1.line_indices(0, 0)) else 0 for c in range(inst1.N)]
    assert in_span([list(map(int, r)) for r in np.array(eng1.V_basis(), dtype=np.int64)], M, 17)
    delta, comp = eng1.delta_exact(M)
    assert delta == 4 and tuple(comp) == ((0,), (), ())
    print("D1: P1 min word delta=4 closed  OK", flush=True)
    inst2 = Inst(5, (1, 2, 2), (1, 1, 1))
    eng2 = DeltaEngine(inst2)
    Mc = [1 if c in set(inst2.line_indices(1, 0)) else 0 for c in range(inst2.N)]
    dc, compc = eng2.delta_exact(Mc)
    assert dc == 2 and tuple(compc) == ((), (0,), ())
    print("D2: C1 line word delta=2 closed  OK", flush=True)
    print(f"ALL CONTROLS PASS in {time.monotonic()-t0:.1f}s")
