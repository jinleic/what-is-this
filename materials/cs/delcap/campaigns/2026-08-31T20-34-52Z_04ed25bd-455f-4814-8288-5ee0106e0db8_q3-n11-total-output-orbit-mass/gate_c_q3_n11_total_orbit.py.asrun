ROWS_PATH = CAMPAIGN / "orbit_rows.jsonl"
ROW_HASH_PATH = CAMPAIGN / "orbit_rows.line_checksums.json"
STATIC_GUARD_PATH = CAMPAIGN / "static_guard.json"
SUMMARY_PATH = CAMPAIGN / "summary.json"
TABLE_PATH = CAMPAIGN / "TABLE_q3_n11_conservative_intervals.csv"
FAILURE_PATH = CAMPAIGN / "FAILURE.json"
LOG_PATH = CAMPAIGN / "run.log"

PREC = 400
SNAP_IN = 1 << 30
SNAP_OUT = 1 << 30
BA_ITERS = 4000
ROW_TIMEOUT_S = 90 * 60
STAGE_TIMEOUT_S = 6 * 60 * 60
RSS_LIMIT_BYTES = 96 * (1 << 30)
