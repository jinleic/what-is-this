def verify_dependencies_before_import() -> None:
    """Hash frozen dependencies before executing their code."""
    manifest = json.loads(MANIFEST_PATH.read_text())
    assert manifest["campaign_id"] == CAMPAIGN_ID
    assert manifest["schema"] == SCHEMA
    for name, path in DEPENDENCIES.items():
        actual = hashlib.sha256(path.read_bytes()).hexdigest()
        assert manifest["source_hashes"][name] == actual, (
            name, actual, manifest["source_hashes"][name])

def require_no_bytecode() -> None:
    if (
        os.environ.get("PYTHONDONTWRITEBYTECODE") != "1"
        or not sys.dont_write_bytecode
    ):
        raise RuntimeError("PYTHONDONTWRITEBYTECODE=1 is required before imports")


require_no_bytecode()

verify_dependencies_before_import()


def load_dependency(name: str, path: Path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(name, loader)
    assert spec is not None
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


# Preload immutable copies under the names imported by the structural backend.
frozen = load_dependency("gate_c_orbit", DEPENDENCIES["gate_c_orbit_dependency.py.asrun"])
dense = load_dependency("gate_c_dhalf", DEPENDENCIES["gate_c_dhalf_dependency.py.asrun"])
q4 = load_dependency("q4_total_orbit_structure", DEPENDENCIES["gate_c_q4_structure_dependency.py.asrun"])

ctx.prec = PREC
ACTIVE_DEADLINE: float | None = None
ALARM_REASON = "resource stop"


class ResourceStop(Exception):
    pass


def utc() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def canonical_json_line(value: dict) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()


def fsync_directory(directory: Path) -> None:
    descriptor = os.open(directory, os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def atomic_write_bytes(path: Path, payload: bytes) -> None:
    temporary = path.with_name(f".{path.name}.tmp.{os.getpid()}")
    try:
        with temporary.open("xb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        fsync_directory(path.parent)
    except BaseException:
        print(
            "ATOMIC_WRITE_FAILURE: temporary evidence is never deleted; "
            f"path={temporary} exists={temporary.exists()}",
            file=sys.stderr,
            flush=True,
        )
        raise


def atomic_write_json(path: Path, value) -> None:
    payload = (json.dumps(value, indent=2, sort_keys=True) + "\n").encode()
    atomic_write_bytes(path, payload)


def log(message: str) -> None:
    line = f"[{utc()}] {message}"
    print(line, flush=True)
    with LOG_PATH.open("a") as handle:
        handle.write(line + "\n")
        handle.flush()


def grid() -> list[tuple[int, int, fmpq]]:
    return [(3, 11, d) for d in D_GRID]


def key_text(ordinal: int, q: int, n: int, d: str) -> str:
    return f"{ordinal}:{q}:{n}:{d}"


def self_source_hash() -> str:
    current = Path(__file__).resolve()
    if current != FROZEN_RUNNER.resolve():
        raise AssertionError(f"runner must execute frozen source: {current}")
    return sha256(current)


def load_and_verify_manifest() -> tuple[dict, str]:
    manifest = json.loads(MANIFEST_PATH.read_text())
    assert manifest["campaign_id"] == CAMPAIGN_ID
    assert manifest["schema"] == SCHEMA
    assert manifest["row_box"] == [
        {"ordinal": ordinal, "q": q, "n": n, "d": str(d)}
        for ordinal, (q, n, d) in enumerate(grid())
    ]
    source_hash = self_source_hash()
    assert manifest["source_hashes"][FROZEN_RUNNER.name] == source_hash
    for name, path in DEPENDENCIES.items():
        assert manifest["source_hashes"][name] == sha256(path)
    assert manifest["dual_candidates"] == list(DUAL_CANDIDATE_NAMES)
    assert manifest["forbidden_dual_candidates"] == ["ba_word"]
    assert manifest["status"] == "FROZEN_PRE_RESULT"
    assert manifest["pre_statement_sha256"] == sha256(
        CAMPAIGN / "pre_statement.md")
    assert manifest["group"] == "S_3 x C_2 on symbol values and whole-word reversal"
    assert manifest["precision_bits"] == PREC
    assert manifest["ba_iterations"] == BA_ITERS
    assert manifest["input_snap"] == SNAP_IN
    assert manifest["output_snap"] == SNAP_OUT
    assert manifest["width_target"] == str(WIDTH_TARGET)
    assert manifest["release_key"] == RELEASE_KEY
    assert manifest["resource_caps"] == {
        "rss_bytes": RSS_LIMIT_BYTES,
        "row_wall_seconds": ROW_TIMEOUT_S,
        "stage_wall_seconds": STAGE_TIMEOUT_S,
        "niceness_minimum": 10,
        "thread_env_value": "1",
        "python_dont_write_bytecode": True,
        "platform": "darwin",
        "one_sequential_process": True,
    }
    return manifest, source_hash


def maximum_rss_bytes() -> int:
    # This campaign is frozen for Darwin, where ru_maxrss is bytes.
    if sys.platform != "darwin":
        raise RuntimeError("Darwin ru_maxrss byte semantics are required")
    return int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss)


def check_resources(label: str) -> None:
    if maximum_rss_bytes() >= RSS_LIMIT_BYTES:
        raise ResourceStop(f"96 GiB RSS stop at {label}")
    if ACTIVE_DEADLINE is not None and time.monotonic() >= ACTIVE_DEADLINE:
        raise ResourceStop(f"row/stage wall stop at {label}")

def require_release() -> None:
    if os.environ.get(RELEASE_KEY) != "1":
        raise RuntimeError(f"heavy slot not released: set {RELEASE_KEY}=1")
    if (
        os.environ.get("PYTHONDONTWRITEBYTECODE") != "1"
        or not sys.dont_write_bytecode
    ):
        raise RuntimeError("PYTHONDONTWRITEBYTECODE=1 is required")
    if not __debug__:
        raise RuntimeError("python -O is refused")
    for name in REQUIRED_THREAD_ENVS:
        if os.environ.get(name) != "1":
            raise RuntimeError(f"{name} must equal 1")
    if os.nice(0) < 10:
        raise RuntimeError("process niceness must be at least 10")


def alarm_handler(signum, frame) -> None:
    del signum, frame
    raise ResourceStop(ALARM_REASON)


def validate_resume(source_hash: str) -> list[dict]:
    staged = sorted(path.name for path in CAMPAIGN.glob(".*.tmp.*"))
    assert not staged, (
        "staged atomic-write evidence exists; preserve and inspect before "
        f"resume: {staged}")
    rows_exist = ROWS_PATH.exists() and ROWS_PATH.stat().st_size > 0
    ledger_exists = ROW_HASH_PATH.exists() and ROW_HASH_PATH.stat().st_size > 0
    assert rows_exist == ledger_exists
    if not rows_exist:
        return []
    ledger = json.loads(ROW_HASH_PATH.read_text())
    assert ledger["algorithm"] == "sha256"
    assert ledger["campaign_id"] == CAMPAIGN_ID
    assert ledger["schema"] == SCHEMA
    assert ledger["source_sha256"] == source_hash
    expected_hashes = ledger["rows"]
    raw_lines = [raw for raw in ROWS_PATH.read_bytes().splitlines(keepends=True) if raw.strip()]
    assert len(raw_lines) == len(expected_hashes)
    assert len(raw_lines) <= len(grid())
    rows: list[dict] = []
    seen: set[str] = set()
    for ordinal, raw in enumerate(raw_lines):
        row = json.loads(raw)
        assert raw == canonical_json_line(row)
        q_expected, n_expected, d_expected = grid()[ordinal]
        assert row["ordinal"] == ordinal
        assert (row["q"], row["n"], row["d"]) == (
            q_expected,
            n_expected,
            str(d_expected),
        )
        assert row["campaign_id"] == CAMPAIGN_ID
        assert row["schema"] == SCHEMA
        assert row["source_sha256"] == source_hash
        key = key_text(ordinal, row["q"], row["n"], row["d"])
        assert key not in seen
        assert hashlib.sha256(raw).hexdigest() == expected_hashes[key]
        seen.add(key)
        rows.append(row)
    assert seen == set(expected_hashes)
    return rows


def commit_row(row: dict, source_hash: str) -> None:
    existing = validate_resume(source_hash)
    ordinal = len(existing)
    q_expected, n_expected, d_expected = grid()[ordinal]
    assert row["ordinal"] == ordinal
    assert (row["q"], row["n"], row["d"]) == (
        q_expected,
        n_expected,
        str(d_expected),
    )
    raw = canonical_json_line(row)
    old_bytes = ROWS_PATH.read_bytes() if ROWS_PATH.exists() else b""
    ledger = {
        "algorithm": "sha256",
        "campaign_id": CAMPAIGN_ID,
        "schema": SCHEMA,
        "source_sha256": source_hash,
        "rows": {},
    }
    if ROW_HASH_PATH.exists():
        ledger = json.loads(ROW_HASH_PATH.read_text())
    key = key_text(ordinal, row["q"], row["n"], row["d"])
    assert key not in ledger["rows"]
    ledger["rows"][key] = hashlib.sha256(raw).hexdigest()
    atomic_write_bytes(ROWS_PATH, old_bytes + raw)
    atomic_write_json(ROW_HASH_PATH, ledger)
    assert len(validate_resume(source_hash)) == ordinal + 1


def generators(q: int, word: tuple[int, ...]):
    swap = list(range(q))
    swap[0], swap[1] = swap[1], swap[0]
    cycle = list(range(1, q)) + [0]
    return (
        tuple(reversed(word)),
        tuple(swap[symbol] for symbol in word),
        tuple(cycle[symbol] for symbol in word),
    )


def assert_census_anchor(structure) -> dict:
    assert structure.q == 3 and structure.n == 11
    expected = CENSUS_ANCHORS[11]
    observed = (
        len(structure.od.gin.reps),
        structure.od.n_out,
        structure.rep_entries,
        structure.orbit_slots,
        structure.rep_entries + structure.orbit_slots,
    )
    assert observed == expected, (structure.n, observed, expected)
    assert sum(structure.od.gin.sizes) == structure.q**structure.n
    assert sum(int(value) for value in structure.flat_sizes) == sum(
        structure.q**k for k in range(structure.n + 1)
    )
    return {
        "n": structure.n,
        "observed": list(observed),
        "input_orbit_size_sum": sum(structure.od.gin.sizes),
        "output_orbit_size_sum": sum(int(value) for value in structure.flat_sizes),
        "status": "PASS",
        "evidence_label": "MACHINE-VERIFIED",
    }


def assert_input_distribution(structure, masses: list[int]) -> dict:
    assert len(masses) == len(structure.od.gin.reps)
    assert all(value >= 0 for value in masses)
    total = sum(masses)
    assert total == SNAP_IN
    per_word = [
        fmpq(masses[j], total * structure.od.gin.sizes[j])
        for j in range(len(masses))
    ]
    assert sum(
        structure.od.gin.sizes[j] * per_word[j] for j in range(len(masses))
    ) == 1
    checks = 0
    positive_words = 0
    for index, word in enumerate(itertools.product(range(structure.q), repeat=structure.n)):
        orbit = structure.od.gin.word_orbit[word]
        value = per_word[orbit]
        positive_words += int(value > 0)
        for transformed in generators(structure.q, word):
            assert value == per_word[structure.od.gin.word_orbit[transformed]]
            checks += 1
        if index and index % 10000 == 0:
            check_resources("input invariance expansion")
    return {
        "orbit_total_mass_numerators": masses,
        "total_mass_denominator": total,
        "per_word_formula": "mass(O)/(S*|O|)",
        "orbit_sizes": list(structure.od.gin.sizes),
        "expanded_g_generator_checks": checks,
        "positive_input_words": positive_words,
        "zero_input_words": structure.q**structure.n - positive_words,
        "exact_sum": "1",
        "status": "PASS",
        "evidence_label": "MACHINE-VERIFIED",
    }


def locator_checked(structure, d: fmpq, iters: int = BA_ITERS) -> dict:
    start = time.perf_counter()
    _, _, denominator, rdata, bmat = q4.weighted_arrays(structure, d)
    n_orbits = len(structure.od.gin.reps)
    masses = np.full(n_orbits, 1.0 / n_orbits, dtype=np.float64)
    log_r = np.log2(rdata)
    completed = 0
    for iteration in range(iters):
        dm = np.maximum(np.asarray(bmat.T.dot(masses)).ravel() / denominator, 1e-300)
        terms = rdata * (log_r - np.log2(dm[structure.rt]))
        row_terms = np.add.reduceat(terms, structure.rptr[:-1])
        row_terms = np.where(
            structure.rptr[:-1] < structure.rptr[1:], row_terms, 0.0
        )
        weights = np.exp2(row_terms - row_terms.max()) * masses
        total = weights.sum()
        if not np.isfinite(total) or total <= 0:
            raise ArithmeticError("float locator produced invalid normalization")
        masses = np.maximum(weights / total, 1e-300)
        masses /= masses.sum()
        completed = iteration + 1
        if completed % 25 == 0:
            check_resources(f"BA iteration {completed}")
    assert completed == iters
    dm = np.maximum(np.asarray(bmat.T.dot(masses)).ravel() / denominator, 1e-300)
    terms = rdata * (log_r - np.log2(dm[structure.rt]))
    row_terms = np.add.reduceat(terms, structure.rptr[:-1])
    row_terms = np.where(structure.rptr[:-1] < structure.rptr[1:], row_terms, 0.0)
    weighted_mass = float(dm @ structure.flat_sizes.astype(np.float64))
    assert abs(weighted_mass - 1.0) < 1e-9
    return {
        "m": masses,
        "dm_orbit": dm,
        "rate": float(masses @ row_terms),
        "dual": float(row_terms.max()),
        "iterations": completed,
        "weighted_mass": weighted_mass,
        "wall_s": round(time.perf_counter() - start, 3),
    }


def kl_evaluation(
    structure,
    dp: list[fmpq],
    d: fmpq,
    *,
    input_masses: list[int] | None = None,
) -> dict:
    """Evaluate representative and every-input KL; optionally sum a primal."""
    ctx.prec = PREC
    log2 = arb(2).log()
    a, b, denominator = q4.d_parts(d, structure.n)
    cache: dict[tuple[int, int], arb] = {}
    entries = 0
    positivity_checks = 0

    def value(word: tuple[int, ...]) -> arb:
        nonlocal entries, positivity_checks
        subtotal = arb(0)
        for output, count in frozen.dpdict(word, structure.n).items():
            entries += 1
            orbit = structure.od.flat_of_word(output)
            dy = dp[orbit]
            if dy == 0:
                return arb(float("inf"))
            assert dy > 0
            positivity_checks += 1
            key = (orbit, count)
            term = cache.get(key)
            if term is None:
                length = len(output)
                weight = fmpq(
                    count * a ** (structure.n - length) * b**length,
                    denominator,
                )
                term = arb(weight) * (arb(weight / dy).log() / log2)
                cache[key] = term
            subtotal += term
        return subtotal

    representative_indices = (
        list(range(len(structure.od.gin.reps)))
        if input_masses is None
        else [j for j, mass in enumerate(input_masses) if mass > 0]
    )
    assert representative_indices
    representative_values: list[arb | None] = [None] * len(structure.od.gin.reps)
    for j in representative_indices:
        representative_values[j] = value(structure.od.gin.reps[j])
    representative_argmax = max(
        representative_indices, key=lambda j: representative_values[j].upper()
    )
    representative_best = representative_values[representative_argmax]
    assert representative_best is not None

    full_best = None
    full_argmax = None
    overlap_failures = 0
    full_mutual = arb(0) if input_masses is not None else None
    input_total = sum(input_masses) if input_masses is not None else None
    positive_input_words = 0
    for index, word in enumerate(itertools.product(range(structure.q), repeat=structure.n)):
        orbit = structure.od.gin.word_orbit[word]
        if input_masses is not None and input_masses[orbit] == 0:
            continue
        current = value(word)
        positive_input_words += 1
        representative = representative_values[orbit]
        assert representative is not None
        if (
            current.upper() < representative.lower()
            or representative.upper() < current.lower()
        ):
            overlap_failures += 1
        if full_best is None or current.upper() > full_best.upper():
            full_best = current
            full_argmax = word
        if input_masses is not None:
            px = fmpq(
                input_masses[orbit],
                input_total * structure.od.gin.sizes[orbit],
            )
            full_mutual += arb(px) * current
        if index and index % 10000 == 0:
            check_resources("direct full-alphabet KL")
            log(
                f"  full KL q={structure.q} n={structure.n}: "
                f"{index}/{structure.q**structure.n}"
            )
    assert full_best is not None
    assert overlap_failures == 0
    assert not (
        full_best.upper() < representative_best.lower()
        or representative_best.upper() < full_best.lower()
    )
    result = {
        "representative_max_ball": str(representative_best),
        "full_alphabet_max_ball": str(full_best),
        "representative_argmax_orbit": representative_argmax,
        "full_argmax_word": list(full_argmax),
        "full_argmax_orbit": structure.od.gin.word_orbit[full_argmax],
        "representatives_evaluated": len(representative_indices),
        "positive_full_input_words_evaluated": positive_input_words,
        "zero_mass_input_words_skipped": (
            structure.q**structure.n - positive_input_words if input_masses is not None else 0
        ),
        "full_word_vs_representative_overlap_failures": overlap_failures,
        "conditional_entries_evaluated": entries,
        "positive_W_terms_with_positive_D_checked": positivity_checks,
        "cached_exact_terms": len(cache),
        "status": "PASS",
        "evidence_label": "MACHINE-VERIFIED",
        "_representative_max_arb": representative_best,
        "_full_alphabet_max_arb": full_best,
    }
    if input_masses is not None:
        orbit_mutual = arb(0)
        for j in representative_indices:
            representative = representative_values[j]
            assert representative is not None
            orbit_mutual += arb(fmpq(input_masses[j], input_total)) * representative
        assert not (
            full_mutual.upper() < orbit_mutual.lower()
            or orbit_mutual.upper() < full_mutual.lower()
        )
        result.update(
            {
                "orbit_weighted_primal_ball": str(orbit_mutual),
                "full_alphabet_primal_ball": str(full_mutual),
                "full_vs_orbit_primal_overlap": "PASS",
                "_orbit_weighted_primal_arb": orbit_mutual,
                "_full_alphabet_primal_arb": full_mutual,
            }
        )
    return result


def output_candidate(structure, name: str, masses: list[int], d: fmpq) -> dict:
    assert name in DUAL_CANDIDATE_NAMES
    assert len(masses) == structure.od.n_out
    assert all(value > 0 for value in masses)
    total = sum(masses)
    dp = [
        fmpq(masses[t], total * int(structure.flat_sizes[t]))
        for t in range(len(masses))
    ]
    assert sum(int(structure.flat_sizes[t]) * dp[t] for t in range(len(dp))) == 1
    invariance_checks = q4.assert_expanded_g_invariance(structure, dp)
    evaluation = kl_evaluation(structure, dp, d)
    representative = evaluation.pop("_representative_max_arb")
    full = evaluation.pop("_full_alphabet_max_arb")
    return {
        "name": name,
        "status": "ADMITTED_EXACT_OUTPUT_ORBIT_INVARIANT",
        "output_orbit_total_mass_numerators": masses,
        "total_mass_denominator": total,
        "output_orbit_sizes": [int(value) for value in structure.flat_sizes],
        "per_word_formula": "mass(T)/(S*|T|)",
        "exact_sum": "1",
        "minimum_orbit_mass_numerator": min(masses),
        "expanded_g_generator_checks": invariance_checks,
        "evaluation": evaluation,
        "_representative_max_arb": representative,
        "_full_alphabet_max_arb": full,
        "evidence_label": "MACHINE-VERIFIED",
    }


def exact_float_rational(value: float) -> fmpq:
    numerator, denominator = value.as_integer_ratio()
    return fmpq(numerator, denominator)


def outward_lower(endpoint) -> tuple[float, fmpq]:
    value = math.nextafter(float(endpoint), -math.inf)
    rational = exact_float_rational(value)
    assert arb(rational).upper() <= endpoint
    return value, rational


def outward_upper(endpoint) -> tuple[float, fmpq]:
    value = math.nextafter(float(endpoint), math.inf)
    rational = exact_float_rational(value)
    assert arb(rational).lower() >= endpoint
    return value, rational


def conservative_interval(primal: arb, dual: arb, n: int) -> dict:
    primal_per_symbol = primal / n
    dual_per_symbol = dual / n
    lower_endpoint = primal_per_symbol.lower()
    upper_endpoint = dual_per_symbol.upper()
    if upper_endpoint < lower_endpoint:
        raise AssertionError("negative certified width")
    width_endpoint = upper_endpoint - lower_endpoint
    lower, lower_q = outward_lower(lower_endpoint)
    upper, upper_q = outward_upper(upper_endpoint)
    width, width_q = outward_upper(width_endpoint)
    assert lower <= upper
    return {
        "primal_per_symbol_arb_ball": str(primal_per_symbol),
        "dual_per_symbol_arb_ball": str(dual_per_symbol),
        "certified_lower_outward_decimal": repr(lower),
        "certified_upper_outward_decimal": repr(upper),
        "certified_width_upper_outward_decimal": repr(width),
        "certified_lower_outward_binary_rational": str(lower_q),
        "certified_upper_outward_binary_rational": str(upper_q),
        "certified_width_upper_outward_binary_rational": str(width_q),
        "lower_containment_assertion": "outward binary rational <= Arb lower endpoint",
        "upper_containment_assertion": "outward binary rational >= Arb upper endpoint",
        "width_containment_assertion": "outward binary rational >= exact endpoint difference",
        "width_target": "1/500",
        "width_target_status": (
            "PASS" if width_endpoint <= arb(WIDTH_TARGET) else "VALID_BUT_WIDTH_MISS"
        ),
        "endpoint_evidence_label": "MACHINE-VERIFIED",
    }


def certificate_row(structure, d: fmpq, ordinal: int, source_hash: str) -> dict:
    start_wall = time.perf_counter()
    start_cpu = time.process_time()
    ctx.prec = PREC
    locator = locator_checked(structure, d)

    input_masses = frozen.snap(locator["m"], SNAP_IN)
    input_archive = assert_input_distribution(structure, input_masses)
    orbit_primal, induced = q4.cert_primal_structure(structure, input_masses, d)
    assert sum(
        int(structure.flat_sizes[t]) * induced[t] for t in range(len(induced))
    ) == 1
    induced_checks = q4.assert_expanded_g_invariance(structure, induced)
    primal_check = kl_evaluation(structure, induced, d, input_masses=input_masses)
    primal_check.pop("_representative_max_arb")
    primal_check.pop("_full_alphabet_max_arb")
    orbit_weighted = primal_check.pop("_orbit_weighted_primal_arb")
    full_primal = primal_check.pop("_full_alphabet_primal_arb")
    for checked in (orbit_weighted, full_primal):
        assert not (
            orbit_primal.upper() < checked.lower()
            or checked.upper() < orbit_primal.lower()
        )

    output_totals_float = [
        float(locator["dm_orbit"][t]) * int(structure.flat_sizes[t])
        for t in range(structure.od.n_out)
    ]
    assert abs(sum(output_totals_float) - 1.0) < 1e-9
    ba_masses = frozen.snap(output_totals_float, SNAP_OUT)
    zero_before_bump = sum(value == 0 for value in ba_masses)
    if zero_before_bump:
        ba_masses = [value + 1 for value in ba_masses]
    uniform_masses = [int(value) for value in structure.flat_sizes]
    candidates = [
        output_candidate(structure, "ba_total_orbit_mass", ba_masses, d),
        output_candidate(structure, "uniform", uniform_masses, d),
    ]
    assert tuple(candidate["name"] for candidate in candidates) == DUAL_CANDIDATE_NAMES
    for candidate in candidates:
        candidate["zero_orbit_masses_before_full_support_bump"] = (
            zero_before_bump if candidate["name"] == "ba_total_orbit_mass" else 0
        )
    finite = [
        candidate
        for candidate in candidates
        if candidate["_full_alphabet_max_arb"].upper() != float("inf")
    ]
    assert finite
    chosen = min(
        finite, key=lambda candidate: candidate["_full_alphabet_max_arb"].upper()
    )
    dual = chosen["_full_alphabet_max_arb"]

    interval = conservative_interval(orbit_primal, dual, structure.n)
    sandwich, delta = q4.sandwich_structure(structure, d)
    primal_per_symbol = orbit_primal / structure.n
    dual_per_symbol = dual / structure.n
    lower_margin = primal_per_symbol.lower() - sandwich["lbplus"].upper()
    upper_margin = sandwich["ub"].lower() - dual_per_symbol.upper()
    published_overlap = not (
        dual_per_symbol.upper() < sandwich["lbplus"].lower()
        or primal_per_symbol.lower() > sandwich["ub"].upper()
    )
    if not published_overlap:
        raise AssertionError("certified interval excludes published sandwich")
    lower_contained = (
        primal_per_symbol.lower() >= sandwich["lbplus"].upper())
    upper_contained = (
        dual_per_symbol.upper() <= sandwich["ub"].lower())
    verdicts = []
    if lower_margin > 0:
        verdicts.append("CERT_LOWER_BEATS_LBplus")
    if upper_margin > 0:
        verdicts.append("CERT_UPPER_BEATS_UB")
    if not verdicts:
        verdicts.append("NO_STRICT_IMPROVEMENT")

    for candidate in candidates:
        candidate.pop("_representative_max_arb")
        candidate.pop("_full_alphabet_max_arb")
    return {
        "campaign_id": CAMPAIGN_ID,
        "schema": SCHEMA,
        "source_sha256": source_hash,
        "ordinal": ordinal,
        "status": (
            "CERTIFIED"
            if interval["width_target_status"] == "PASS"
            else "VALID_BUT_WIDTH_MISS"
        ),
        "q": structure.q,
        "n": structure.n,
        "d": str(d),
        "input_distribution": input_archive,
        "induced_output_exact_sum": "1",
        "induced_output_expanded_g_generator_checks": induced_checks,
        "primal_orbit_ball": str(orbit_primal),
        "primal_full_check": primal_check,
        "dual_candidates": candidates,
        "dual_candidate_names": list(DUAL_CANDIDATE_NAMES),
        "forbidden_dual_candidates": ["ba_word"],
        "dual_selection_rule": (
            "minimum finite direct-full-alphabet Arb upper endpoint; fixed tie "
            "order ba_total_orbit_mass then uniform"
        ),
        "dual_from": chosen["name"],
        "dual_full_alphabet_ball": chosen["evaluation"]["full_alphabet_max_ball"],
        "conservative_interval": interval,
        "report_only_binary64": {
            "cert_lo_per_symbol": float(primal_per_symbol.lower()),
            "cert_hi_per_symbol": float(dual_per_symbol.upper()),
            "cert_width_per_symbol": float(
                dual_per_symbol.upper() - primal_per_symbol.lower()
            ),
            "status": "REPORT_ONLY_BINARY64_NOT_CERTIFICATE_ENDPOINTS",
            "evidence_label": "COMPUTATIONAL-EVIDENCE",
        },
        "lbplus_arb_ball": str(sandwich["lbplus"]),
        "ub_arb_ball": str(sandwich["ub"]),
        "delta_n_arb_ball": str(delta),
        "lower_margin_arb_ball": str(lower_margin),
        "upper_margin_arb_ball": str(upper_margin),
        "published_sandwich_overlap": "PASS",
        "published_lower_containment": lower_contained,
        "published_upper_containment": upper_contained,
        "published_sandwich_containment": (
            "PASS" if lower_contained and upper_contained else "NOT_CERTIFIED"
        ),
        "verdict": "+".join(verdicts),
        "locator": {
            "rate_float_block": locator["rate"],
            "dual_float_block": locator["dual"],
            "weighted_mass_float": locator["weighted_mass"],
            "iterations": locator["iterations"],
            "wall_s": locator["wall_s"],
            "evidence_label": "COMPUTATIONAL-EVIDENCE",
        },
        "census_anchor": assert_census_anchor(structure),
        "n_input_words": structure.q**structure.n,
        "n_input_orbits": len(structure.od.gin.reps),
        "n_output_words": sum(structure.q**k for k in range(structure.n + 1)),
        "n_output_orbits": structure.od.n_out,
        "structure_build_wall_s": structure.build_wall_s,
        "maximum_rss_bytes": maximum_rss_bytes(),
        "wall_s": round(time.perf_counter() - start_wall, 3),
        "cpu_s": round(time.process_time() - start_cpu, 3),
        "evidence_label": "MACHINE-VERIFIED",
        "timing_and_resource_evidence_label": "COMPUTATIONAL-EVIDENCE",
    }


def audit_word_distribution(structure, values: dict[tuple[int, ...], fmpq]) -> dict:
    assert set(values) == set(q4.word_iter(structure.q, structure.n))
    assert all(value > 0 for value in values.values())
    assert sum(values.values()) == 1
    orbit_values: dict[int, set[fmpq]] = {}
    generator_checks = 0
    generator_failures = 0
    for word, value in values.items():
        orbit = structure.od.flat_of_word(word)
        orbit_values.setdefault(orbit, set()).add(value)
        for transformed in generators(structure.q, word):
            generator_checks += 1
            if value != values[transformed]:
                generator_failures += 1
    mixed = {orbit: len(masses) for orbit, masses in orbit_values.items() if len(masses) > 1}
    return {
        "mixed_output_orbits": len(mixed),
        "first_mixed_output_orbit": min(mixed) if mixed else None,
        "generator_checks": generator_checks,
        "generator_failures": generator_failures,
        "status": "SPLIT_REJECT" if mixed else "PASS",
        "evidence_label": "MACHINE-VERIFIED",
    }


def admit_word_distribution_for_compression(structure, values) -> None:
    audit = audit_word_distribution(structure, values)
    if audit["mixed_output_orbits"]:
        raise ValueError("output distribution is not exactly G-invariant")


def split_output_counterfactual(structure) -> dict:
    words = list(q4.word_iter(structure.q, structure.n))
    counts = {word: 2 for word in words}
    counts[(0,)] = 3
    counts[(1,)] = 1
    total = sum(counts.values())
    values = {word: fmpq(count, total) for word, count in counts.items()}
    audit = audit_word_distribution(structure, values)
    assert audit["mixed_output_orbits"] >= 1
    rejected = False
    try:
        admit_word_distribution_for_compression(structure, values)
    except ValueError:
        rejected = True
    assert rejected

    uniform_masses = [int(value) for value in structure.flat_sizes]
    uniform_total = sum(uniform_masses)
    uniform_dp = [
        fmpq(uniform_masses[t], uniform_total * int(structure.flat_sizes[t]))
        for t in range(structure.od.n_out)
    ]
    assert q4.assert_expanded_g_invariance(structure, uniform_dp) == 3 * len(words)
    return {
        "planted_counts": {"(0,)": 3, "(1,)": 1, "all_other_words": 2},
        "split_audit": audit,
        "candidate_rejected_before_KL": rejected,
        "orbit_total_uniform_control": "PASS",
        "status": "BREAKS_AS_REQUIRED",
        "evidence_label": "MACHINE-VERIFIED",
    }


def burnside_q3_orbit_count(n: int) -> int:
    assert n >= 0
    nonreversal = 6 if n == 0 else 3**n + 3
    if n == 0:
        reversal = 6
    elif n % 2 == 0:
        reversal = 4 * 3 ** (n // 2)
    else:
        reversal = 2 * 3 ** ((n + 1) // 2)
    numerator = nonreversal + reversal
    assert numerator % 12 == 0
    return numerator // 12


def equivariance_q3_control() -> dict:
    q_value, n = 3, 3
    outputs = list(q4.word_iter(q_value, n))
    checked = 0
    for x in itertools.product(range(q_value), repeat=n):
        for perm in itertools.permutations(range(q_value)):
            mapping = dict(zip(range(q_value), perm))
            xp = tuple(mapping[symbol] for symbol in x)
            for y in outputs:
                yp = tuple(mapping[symbol] for symbol in y)
                assert frozen.nsub(xp, yp) == frozen.nsub(x, y)
                assert frozen.nsub(
                    tuple(reversed(xp)), tuple(reversed(yp))
                ) == frozen.nsub(x, y)
                checked += 1
    x = (0, 0, 1, 0)
    x_position_permuted = (0, 1, 0, 0)
    y = (1, 0)
    live = frozen.nsub(x, y)
    planted = frozen.nsub(x_position_permuted, y)
    assert live == 1 and planted == 2 and live != planted
    return {
        "q3_joint_equivariance_checks": checked,
        "position_control": {
            "x": list(x),
            "position_permuted_x": list(x_position_permuted),
            "y": list(y),
            "A_original": live,
            "A_position_permuted": planted,
            "status": "BREAKS_AS_REQUIRED",
        },
        "evidence_label": "MACHINE-VERIFIED",
    }


def static_guard(artifact_path: Path = STATIC_GUARD_PATH) -> dict:
    start_wall = time.perf_counter()
    start_cpu = time.process_time()
    manifest, source_hash = load_and_verify_manifest()
    assert len(grid()) == 4
    assert [str(d) for d in D_GRID] == ["1/2", "1/5", "1/10", "1/20"]
    assert DUAL_CANDIDATE_NAMES == ("ba_total_orbit_mass", "uniform")
    assert "ba_word" not in DUAL_CANDIDATE_NAMES
    assert all(q_value == 3 and n == 11 for q_value, n, _ in grid())

    burnside_input = burnside_q3_orbit_count(11)
    burnside_output = sum(burnside_q3_orbit_count(k) for k in range(12))
    assert (burnside_input, burnside_output) == CENSUS_ANCHORS[11][:2]
    reps, sizes, _, _ = q4.rgs_orbit_data(3, 11)
    assert len(reps) == burnside_input
    assert sum(sizes) == 3**11
    structure = q4.build_structure(3, 11, logger=lambda *_: None)
    census = assert_census_anchor(structure)
    del structure

    equivariance = equivariance_q3_control()
    control_structure = q4.build_structure(3, 5, logger=lambda *_: None)
    split = split_output_counterfactual(control_structure)
    uniform_total = sum(int(value) for value in control_structure.flat_sizes)
    uniform_dp = [fmpq(1, uniform_total) for _ in range(control_structure.od.n_out)]
    empty_orbit = control_structure.od.flat_of_word(())
    uniform_dp[empty_orbit] = fmpq(0)
    inf_control = q4.cert_dual_structure(control_structure, uniform_dp, fmpq(1, 2))
    assert inf_control.upper() == float("inf")
    del control_structure

    negative_width_rejected = False
    try:
        conservative_interval(arb(2), arb(1), 1)
    except AssertionError:
        negative_width_rejected = True
    assert negative_width_rejected
    resume_rows = len(validate_resume(source_hash))
    assert resume_rows == 0

    result = {
        "status": "PASS",
        "campaign_id": CAMPAIGN_ID,
        "schema": SCHEMA,
        "source_sha256": source_hash,
        "manifest_sha256": sha256(MANIFEST_PATH),
        "artifact_path": str(artifact_path.relative_to(CAMPAIGN)),
        "row_box_rows": len(grid()),
        "q4_and_non_n11_excluded": True,
        "dual_candidates": list(DUAL_CANDIDATE_NAMES),
        "forbidden_dual_candidates": ["ba_word"],
        "burnside_input_orbits": burnside_input,
        "burnside_output_orbits": burnside_output,
        "q3_n11_census_anchor": census,
        "q3_value_equivariance_and_position_plant": equivariance,
        "split_output_counterfactual": split,
        "zero_support_dual_returns_infinity": "PASS",
        "negative_width_plant_rejected": negative_width_rejected,
        "resume_rows_validated": resume_rows,
        "maximum_rss_bytes": maximum_rss_bytes(),
        "wall_s": round(time.perf_counter() - start_wall, 6),
        "cpu_s": round(time.process_time() - start_cpu, 6),
        "completed_utc": utc(),
        "evidence_label": "MACHINE-VERIFIED",
        "timing_evidence_label": "COMPUTATIONAL-EVIDENCE",
    }
    atomic_write_json(artifact_path, result)
    print(json.dumps(result, sort_keys=True), flush=True)
    return result


def resource_row(
    ordinal: int,
    q: int,
    n: int,
    d: fmpq,
    source_hash: str,
    reason: str,
    status: str = "NOT_REACHED_RESOURCE",
) -> dict:
    return {
        "campaign_id": CAMPAIGN_ID,
        "schema": SCHEMA,
        "source_sha256": source_hash,
        "ordinal": ordinal,
        "status": status,
        "q": q,
        "n": n,
        "d": str(d),
        "reason": reason,
        "maximum_rss_bytes": maximum_rss_bytes(),
        "completed_utc": utc(),
        "evidence_label": "COMPUTATIONAL-EVIDENCE",
    }


def table_stage(source_hash: str) -> None:
    if TABLE_PATH.exists():
        raise RuntimeError(
            f"table evidence already exists; refusing overwrite: {TABLE_PATH}")
    if not SUMMARY_PATH.exists():
        raise RuntimeError("terminal summary is required before table rendering")
    summary = json.loads(SUMMARY_PATH.read_text())
    assert summary["campaign_id"] == CAMPAIGN_ID
    assert summary["schema"] == SCHEMA
    assert summary["source_sha256"] == source_hash
    assert summary["rows"] == len(grid())
    assert summary["status"] in {"PASS", "FAILURE_TO_CERTIFY_RESOURCE"}
    rows = validate_resume(source_hash)
    header = (
        "ordinal,n,d,status,lower_outward,upper_outward,width_upper_outward,"
        "dual_from,verdict\n"
    )
    lines = [header]
    for row in rows:
        interval = row.get("conservative_interval", {})
        lines.append(
            ",".join(
                [
                    str(row["ordinal"]),
                    str(row["n"]),
                    row["d"],
                    row["status"],
                    interval.get("certified_lower_outward_decimal", ""),
                    interval.get("certified_upper_outward_decimal", ""),
                    interval.get("certified_width_upper_outward_decimal", ""),
                    row.get("dual_from", ""),
                    row.get("verdict", ""),
                ]
            )
            + "\n"
        )
    atomic_write_bytes(TABLE_PATH, "".join(lines).encode())


def rows_stage() -> None:
    occupied = [
        path.name for path in (FAILURE_PATH, SUMMARY_PATH, TABLE_PATH)
        if path.exists()
    ]
    if occupied:
        raise RuntimeError(
            f"terminal evidence already exists; refusing rerun: {occupied}")
    _, source_hash = load_and_verify_manifest()
    if not STATIC_GUARD_PATH.exists():
        raise RuntimeError("static guard must pass before production release")
    guard = json.loads(STATIC_GUARD_PATH.read_text())
    assert guard["status"] == "PASS"
    assert guard["campaign_id"] == CAMPAIGN_ID
    assert guard["schema"] == SCHEMA
    assert guard["source_sha256"] == source_hash
    assert guard["manifest_sha256"] == sha256(MANIFEST_PATH)
    assert guard["resume_rows_validated"] == 0
    rows = validate_resume(source_hash)
    start_wall = time.monotonic()
    start_cpu = time.process_time()
    stage_deadline = start_wall + STAGE_TIMEOUT_S
    blocked_reason: str | None = None
    old_handler = signal.signal(signal.SIGALRM, alarm_handler)
    current_structure = None
    current_n = None
    global ACTIVE_DEADLINE, ALARM_REASON
    try:
        while len(rows) < len(grid()):
            ordinal = len(rows)
            q_value, n, d = grid()[ordinal]
            if blocked_reason is not None:
                row = resource_row(
                    ordinal,
                    q_value,
                    n,
                    d,
                    source_hash,
                    blocked_reason,
                    "NOT_REACHED_RESOURCE_UPSTREAM",
                )
                commit_row(row, source_hash)
                rows.append(row)
                continue
            remaining_stage = stage_deadline - time.monotonic()
            if remaining_stage <= 0:
                blocked_reason = "6-hour certificate-stage wall reached"
                continue
            try:
                if current_n != n:
                    current_structure = None
                    current_n = None
                    ACTIVE_DEADLINE = stage_deadline
                    ALARM_REASON = "6-hour stage wall reached during structure build"
                    signal.alarm(max(1, math.ceil(remaining_stage)))
                    check_resources("before structure build")
                    current_structure = q4.build_structure(3, n, logger=log)
                    assert_census_anchor(current_structure)
                    current_n = n
                    check_resources("after structure build")
                    signal.alarm(0)
                row_deadline = min(stage_deadline, time.monotonic() + ROW_TIMEOUT_S)
                ACTIVE_DEADLINE = row_deadline
                ALARM_REASON = (
                    "90-minute certificate-row wall reached"
                    if row_deadline < stage_deadline
                    else "6-hour certificate-stage wall reached"
                )
                signal.alarm(max(1, math.ceil(row_deadline - time.monotonic())))
                assert current_structure is not None
                row = certificate_row(current_structure, d, ordinal, source_hash)
                signal.alarm(0)
            except ResourceStop as error:
                signal.alarm(0)
                row = resource_row(
                    ordinal, q_value, n, d, source_hash, str(error)
                )
                blocked_reason = str(error)
            except Exception as error:
                signal.alarm(0)
                failure = {
                    "status": "FAIL",
                    "campaign_id": CAMPAIGN_ID,
                    "schema": SCHEMA,
                    "source_sha256": source_hash,
                    "ordinal": ordinal,
                    "q": q_value,
                    "n": n,
                    "d": str(d),
                    "error": repr(error),
                    "traceback": traceback.format_exc(),
                    "completed_rows": len(rows),
                    "utc": utc(),
                }
                atomic_write_json(FAILURE_PATH, failure)
                raise
            finally:
                ACTIVE_DEADLINE = None
            commit_row(row, source_hash)
            rows.append(row)
            log(
                f"q=3 n={n} d={d} ordinal={ordinal} status={row['status']} "
                f"rss={maximum_rss_bytes()}"
            )
    finally:
        signal.alarm(0)
        signal.signal(signal.SIGALRM, old_handler)
        ACTIVE_DEADLINE = None
    rows = validate_resume(source_hash)
    assert len(rows) == 4
    summary = {
        "status": (
            "PASS"
            if all(row["status"] in {"CERTIFIED", "VALID_BUT_WIDTH_MISS"} for row in rows)
            else "FAILURE_TO_CERTIFY_RESOURCE"
        ),
        "campaign_id": CAMPAIGN_ID,
        "schema": SCHEMA,
        "source_sha256": source_hash,
        "rows": len(rows),
        "certified_rows": sum(row["status"] == "CERTIFIED" for row in rows),
        "valid_width_miss_rows": sum(
            row["status"] == "VALID_BUT_WIDTH_MISS" for row in rows
        ),
        "resource_rows": sum("RESOURCE" in row["status"] for row in rows),
        "wall_s": round(time.monotonic() - start_wall, 3),
        "cpu_s": round(time.process_time() - start_cpu, 3),
        "completed_utc": utc(),
        "evidence_label": "MACHINE-VERIFIED",
        "timing_and_resource_evidence_label": "COMPUTATIONAL-EVIDENCE",
    }
    atomic_write_json(SUMMARY_PATH, summary)
    table_stage(source_hash)
    log(f"q3 n=11 row stage complete {summary}")


def main() -> None:
    parser = argparse.ArgumentParser()
    modes = parser.add_mutually_exclusive_group(required=True)
    modes.add_argument("--static-guard", action="store_true")
    modes.add_argument("--validate-resume", action="store_true")
    modes.add_argument("--run", action="store_true")
    modes.add_argument("--table", action="store_true")
    args = parser.parse_args()
    if args.run or args.table:
        require_release()
    if args.static_guard:
        artifact_path = STATIC_GUARD_PATH
        if os.path.lexists(artifact_path):
            stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
            artifact_path = CAMPAIGN / (
                f"static_guard_refreeze_{stamp}_{os.getpid()}.json")
        static_guard(artifact_path)
    elif args.validate_resume:
        _, source_hash = load_and_verify_manifest()
        print(json.dumps({"status": "PASS", "rows": len(validate_resume(source_hash))}))
    elif args.run:
        rows_stage()
    else:
        _, source_hash = load_and_verify_manifest()
        table_stage(source_hash)


if __name__ == "__main__":
    main()
