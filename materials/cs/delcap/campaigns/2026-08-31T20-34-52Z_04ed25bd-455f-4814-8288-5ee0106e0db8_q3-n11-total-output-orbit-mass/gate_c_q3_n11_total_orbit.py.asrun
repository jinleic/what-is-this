D_GRID = (fmpq(1, 2), fmpq(1, 5), fmpq(1, 10), fmpq(1, 20))
DUAL_CANDIDATE_NAMES = ("ba_total_orbit_mass", "uniform")
RELEASE_KEY = "DELCAP_Q3_N11_RELEASED"
REQUIRED_THREAD_ENVS = (
    "OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
