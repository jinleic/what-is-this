# Preregistered-orbit-count assertions (Burnside closed form, exact).
def burnside_q3_orbit_count(n: int) -> int:
    assert n >= 0
    nonreversal = 6 if n == 0 else 3**n + 3
    if n == 0:
        reversal = 6
    elif n % 2 == 0:
        reversal = 4 * 3 ** (n // 2)
    else:
        reversal = 2 * 3 ** ((n + 1) // 2)
    numerator = nonreversal + reversal
    assert numerator % 12 == 0
    return numerator // 12


PREREG_INPUT_ORBITS = burnside_q3_orbit_count(12)
PREREG_OUTPUT_ORBITS = sum(burnside_q3_orbit_count(k) for k in range(13))
PREREG_INPUT_WORDS = 3**12
PREREG_OUTPUT_WORDS = sum(3**k for k in range(13))
assert (PREREG_INPUT_ORBITS, PREREG_OUTPUT_ORBITS) == (44530, 66980), (
    PREREG_INPUT_ORBITS, PREREG_OUTPUT_ORBITS)
assert (PREREG_INPUT_WORDS, PREREG_OUTPUT_WORDS) == (531441, 797161)

# Frozen n=11 anchor reproduced by Burnside for the ACCEPT control.
N11_INPUT_ORBITS = burnside_q3_orbit_count(11)
N11_OUTPUT_ORBITS = sum(burnside_q3_orbit_count(k) for k in range(12))
assert (N11_INPUT_ORBITS, N11_OUTPUT_ORBITS) == (14884, 22450)


