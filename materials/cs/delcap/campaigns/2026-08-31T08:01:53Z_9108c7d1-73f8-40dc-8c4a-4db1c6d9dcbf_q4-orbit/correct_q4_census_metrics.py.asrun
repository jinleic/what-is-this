"""Exact, append-only semantic correction of the q=4 population census metrics."""
import json
from pathlib import Path

CAMPAIGN = Path(
    "/Users/jinleic/jinleic-workspace/cs/delcap/campaigns/"
    "2026-08-31T08:01:53Z_9108c7d1-73f8-40dc-8c4a-4db1c6d9dcbf_q4-orbit"
)
PATH = CAMPAIGN / "population_census.json"
BA_ITERS = 4000

value = json.loads(PATH.read_text())
assert value["status"] == "PASS"
for row in value["rows"]:
    representative = row["representative_subsequence_entries"]
    orbit_slots = row["orbit_sum_nonzero_slots"]
    legacy = row["sparse_locator_value_passes_4000"]
    assert legacy == representative * BA_ITERS
    row["RETRACTION_sparse_locator_value_passes_4000"] = (
        "legacy field counts only representative KL-entry visits; it omits "
        "the CSR marginal orbit-sum visits and is not the total per-iteration cost"
    )
    row["sparse_locator_nonzero_visits_per_iteration"] = (
        representative + orbit_slots
    )
    row["sparse_locator_nonzero_visits_4000"] = (
        representative + orbit_slots
    ) * BA_ITERS
value["metric_correction"] = {
    "status": "PASS",
    "evidence_label": "MACHINE-VERIFIED",
    "legacy_field_retained": "sparse_locator_value_passes_4000",
    "correct_total_fields": [
        "sparse_locator_nonzero_visits_per_iteration",
        "sparse_locator_nonzero_visits_4000",
    ],
    "reason": (
        "one BA iteration visits every nonzero CSR marginal slot and every "
        "representative conditional KL entry"
    ),
}
PATH.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")
print(json.dumps(value["metric_correction"], sort_keys=True))
