PREC = 400
D_GRID = (fmpq(1, 2), fmpq(1, 5), fmpq(1, 10), fmpq(1, 20))
SNAP_IN = 1 << 30
SNAP_OUT = 1 << 30
BA_ITERS = 4000
ROW_TIMEOUT_S = 90 * 60
CENSUS_TIMEOUT_S = 60 * 60
LOG_PATH = CAMPAIGN / "run.log"
ROWS_PATH = CAMPAIGN / "orbit_rows.jsonl"
CENSUS_PATH = CAMPAIGN / "population_census.json"
ANCHOR_PATH = CAMPAIGN / "anchor_check.json"
CROSSCHECK_PATH = CAMPAIGN / "crosscheck.json"
INF_PATH = CAMPAIGN / "inf_branch_check.json"
SNAP_REGRESSION_PATH = CAMPAIGN / "snap_invariance_regression.json"
FROZEN_SNAP_AUDIT_PATH = CAMPAIGN / "frozen_snap_invariance_audit.json"
ESCALATE_PATH = CAMPAIGN / "ESCALATE_TO_MAIN.json"


def utc() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def log(message: str) -> None:
    line = f"[{utc()}] {message}"
    print(line, flush=True)
    CAMPAIGN.mkdir(parents=True, exist_ok=True)
    with LOG_PATH.open("a") as fh:
        fh.write(line + "\n")


def write_json(path: Path, value) -> None:
    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")


def d_parts(d: fmpq, n: int) -> tuple[int, int, int]:
    a = int(d.numerator)
    den = int(d.denominator)
    return a, den - a, den**n


def flat_k(od, t: int) -> int:
    for k in range(od.n + 1):
        if od.base[k] <= t < od.base[k] + len(od.gout[k].reps):
            return k
    raise KeyError(t)


def word_iter(q: int, n: int) -> Iterable[tuple[int, ...]]:
    return itertools.chain.from_iterable(
        itertools.product(range(q), repeat=k) for k in range(n + 1)
    )


# ---------------------------------------------------------------------------
# Exact population census


def stirling_second(n: int, k: int) -> int:
    table = [[0] * (k + 1) for _ in range(n + 1)]
    table[0][0] = 1
    for i in range(1, n + 1):
        for j in range(1, min(i, k) + 1):
            table[i][j] = table[i - 1][j - 1] + j * table[i - 1][j]
    return table[n][k]


def rgs_words(n: int, q: int) -> Iterable[tuple[int, ...]]:
    """Restricted-growth strings of length n with at most q blocks."""
    if n == 0:
        yield ()
        return
    buf = [0] * n

    def rec(pos: int, max_seen: int):
        if pos == n:
            yield tuple(buf)
            return
        top = min(max_seen + 1, q - 1)
        for value in range(top + 1):
            buf[pos] = value
            yield from rec(pos + 1, max(max_seen, value))

    yield from rec(1, 0)


def rgs_orbit_data(q: int, n: int) -> tuple[list[tuple[int, ...]], list[int], int, int]:
    """Exact S_q x C_2 representatives/sizes, without q^n enumeration."""
    reps: list[tuple[int, ...]] = []
    sizes: list[int] = []
    rgs_count = 0
    self_reverse = 0
    for r in rgs_words(n, q):
        rgs_count += 1
        rr = frozen.rgs(tuple(reversed(r)))
        assert frozen.rgs(tuple(reversed(rr))) == r
        if r > rr:
            continue
        blocks = len(set(r))
        sq_size = math.factorial(q) // math.factorial(q - blocks)
        if r == rr:
            reps.append(r)
            sizes.append(sq_size)
            self_reverse += 1
        else:
            reps.append(r)
            sizes.append(2 * sq_size)
    expected_rgs = sum(stirling_second(n, b) for b in range(1, min(q, n) + 1))
    if n == 0:
        expected_rgs = 1
    assert rgs_count == expected_rgs
    assert sum(sizes) == q**n
    return reps, sizes, rgs_count, self_reverse


def canon_key(y: tuple[int, ...]) -> tuple[int, tuple[int, ...]]:
    r = frozen.rgs(y)
    rr = frozen.rgs(tuple(reversed(y)))
    return len(y), min(r, rr)


def exact_population_row(q: int, n: int, deadline: float) -> dict:
    start = time.perf_counter()
    reps, sizes, rcount, selfrev = rgs_orbit_data(q, n)
    out_g_orbits = 0
    for k in range(n + 1):
        out_g_orbits += len(rgs_orbit_data(q, k)[0])
    support: set[tuple[int, ...]] = set()
    rep_entries = 0
    orbit_slots = 0
    max_rep_entries = 0
    for index, rep in enumerate(reps):
        if time.monotonic() > deadline:
            raise TimeoutError(f"census timeout at q={q},n={n},rep={index}/{len(reps)}")
        dd = frozen.dpdict(rep, n)
        count = len(dd)
        rep_entries += count
        max_rep_entries = max(max_rep_entries, count)
        support.update(dd)
        orbit_slots += len({canon_key(y) for y in dd})
        if index and index % 10000 == 0:
            log(
                f"census q={q} n={n}: {index}/{len(reps)} reps, "
                f"entries={rep_entries}, support={len(support)}"
            )
    word_support = len(support)
    dense_cells = len(reps) * word_support
    result = {
        "q": q,
        "n": n,
        "input_words": q**n,
        "output_words": sum(q**k for k in range(n + 1)),
        "rgs_classes": rcount,
        "self_reverse_rgs_classes": selfrev,
        "input_g_orbits": len(reps),
        "flat_output_g_orbits": out_g_orbits,
        "orbit_size_sum": sum(sizes),
        "locator_word_support": word_support,
        "representative_subsequence_entries": rep_entries,
        "max_representative_subsequence_entries": max_rep_entries,
        "orbit_sum_nonzero_slots": orbit_slots,
        "dense_locator_cells": dense_cells,
        "dense_locator_bytes_float64": dense_cells * 8,
        "sparse_locator_value_passes_4000": rep_entries * BA_ITERS,
        "census_wall_s": round(time.perf_counter() - start, 3),
        "evidence_label": "MACHINE-VERIFIED",
    }
    del support
    return result


def census_stage() -> None:
    log("population census stage start; no q=4 certificate row may precede it")
    anchor_reps, anchor_sizes, _, _ = rgs_orbit_data(3, 10)
    assert len(anchor_reps) == 5002
    assert sum(len(rgs_orbit_data(3, k)[0]) for k in range(11)) == 7566
    assert sum(anchor_sizes) == 3**10
    rows = []
    deadline = time.monotonic() + CENSUS_TIMEOUT_S
    for n in range(5, 12):
        row = exact_population_row(4, n, deadline)
        rows.append(row)
        write_json(
            CENSUS_PATH,
            {
                "status": "IN_PROGRESS",
                "started_utc": utc(),
                "known_anchor_q3_n10_input_g_orbits": 5002,
                "known_anchor_q3_n10_flat_output_g_orbits": 7566,
                "rows": rows,
            },
        )
        log(
            f"census q=4 n={n}: words={row['input_words']} "
            f"g-orbits={row['input_g_orbits']} out-g={row['flat_output_g_orbits']} "
            f"support={row['locator_word_support']} rep-entries="
            f"{row['representative_subsequence_entries']} B-slots="
            f"{row['orbit_sum_nonzero_slots']} dense-bytes="
            f"{row['dense_locator_bytes_float64']} [{row['census_wall_s']}s]"
        )
    write_json(
        CENSUS_PATH,
        {
            "status": "PASS",
            "completed_utc": utc(),
            "known_anchor_q3_n10_input_g_orbits": 5002,
            "known_anchor_q3_n10_flat_output_g_orbits": 7566,
            "rows": rows,
        },
    )
    log("population census stage PASS")


# ---------------------------------------------------------------------------
# Orbit-native exact channel structure


@dataclass
class OrbitStructure:
    q: int
    n: int
    od: object
    rptr: np.ndarray
    rt: np.ndarray
    ra: np.ndarray
    rlen: np.ndarray
    bptr: np.ndarray
    bt: np.ndarray
    bf: np.ndarray
    brow: np.ndarray
    flat_sizes: np.ndarray
    flat_lengths: np.ndarray
    phi_ks: list[arb]
    rep_entries: int
    orbit_slots: int
    build_wall_s: float


def build_structure(q: int, n: int, *, logger=log) -> OrbitStructure:
    start = time.perf_counter()
    ctx.prec = PREC
    od = frozen.OrbitData(q, n, fmpq(1, 2), log=logger)
    direct_reps, direct_sizes, _, _ = rgs_orbit_data(q, n)
    assert od.gin.reps == direct_reps
    assert od.gin.sizes == direct_sizes

    flat_sizes = np.empty(od.n_out, dtype=np.int64)
    flat_lengths = np.empty(od.n_out, dtype=np.int16)
    for k in range(n + 1):
        for gi, size in enumerate(od.gout[k].sizes):
            t = od.base[k] + gi
            flat_sizes[t] = size
            flat_lengths[t] = k

    rptr = [0]
    rt: list[int] = []
    ra: list[int] = []
    rlen: list[int] = []
    bptr = [0]
    bt: list[int] = []
    bf: list[int] = []
    brow: list[int] = []
    phi_sums = [arb(0) for _ in range(n + 1)]
    log2 = arb(2).log()

    for j, rep in enumerate(od.gin.reps):
        dd = frozen.dpdict(rep, n)
        agg: dict[int, int] = {}
        for y, value in dd.items():
            t = od.flat_of_word(y)
            rt.append(t)
            ra.append(value)
            rlen.append(len(y))
            agg[t] = agg.get(t, 0) + value
            if 0 < len(y) < n and value > 1:
                phi_sums[len(y)] += (
                    arb(fmpz(od.gin.sizes[j] * value))
                    * (arb(fmpz(value)).log() / log2)
                )
        rptr.append(len(rt))
        closure = 0
        for t, total_a in sorted(agg.items()):
            numerator = total_a * od.gin.sizes[j]
            osize = int(flat_sizes[t])
            assert numerator % osize == 0, (q, n, j, t, numerator, osize)
            f_value = numerator // osize
            bt.append(t)
            bf.append(f_value)
            brow.append(j)
            closure += osize * f_value
        bptr.append(len(bt))
        assert closure == od.gin.sizes[j] * (2**n), (q, n, j, closure)
        if j and j % 10000 == 0:
            logger(
                f"structure q={q} n={n}: {j}/{len(od.gin.reps)} reps, "
                f"rep-entries={len(rt)}, B-slots={len(bt)}"
            )

    phi_ks = []
    for k in range(1, n):
        phi_ks.append(
            phi_sums[k]
            / (arb(fmpz(q) ** n) * arb(fmpz(math.comb(n, k))))
        )

    # The new path never consumes member_words; release the q^n tuple lists.
    od.member_words = None
    result = OrbitStructure(
        q=q,
        n=n,
        od=od,
        rptr=np.asarray(rptr, dtype=np.int64),
        rt=np.asarray(rt, dtype=np.int64),
        ra=np.asarray(ra, dtype=np.int64),
        rlen=np.asarray(rlen, dtype=np.int16),
        bptr=np.asarray(bptr, dtype=np.int64),
        bt=np.asarray(bt, dtype=np.int64),
        bf=np.asarray(bf, dtype=np.int64),
        brow=np.asarray(brow, dtype=np.int64),
        flat_sizes=flat_sizes,
        flat_lengths=flat_lengths,
        phi_ks=phi_ks,
        rep_entries=len(rt),
        orbit_slots=len(bt),
        build_wall_s=round(time.perf_counter() - start, 3),
    )
    logger(
        f"structure q={q} n={n}: in-g={len(od.gin.reps)} out-g={od.n_out} "
        f"rep-entries={result.rep_entries} B-slots={result.orbit_slots} "
        f"[{result.build_wall_s}s]"
    )
    return result


def weighted_arrays(structure: OrbitStructure, d: fmpq):
    a, b, dden = d_parts(d, structure.n)
    coeff_len = np.asarray(
        [float(a ** (structure.n - k) * b**k) for k in range(structure.n + 1)],
        dtype=np.float64,
    )
    rdata = structure.ra.astype(np.float64) * coeff_len[structure.rlen] / float(dden)
    bdata = (
        structure.bf.astype(np.float64)
        * coeff_len[structure.flat_lengths[structure.bt]]
        / np.asarray(structure.od.gin.sizes, dtype=np.float64)[structure.brow]
    )
    bmat = csr_matrix(
        (bdata, structure.bt, structure.bptr),
        shape=(len(structure.od.gin.reps), structure.od.n_out),
    )
    return a, b, dden, rdata, bmat


def locator(structure: OrbitStructure, d: fmpq, iters: int = BA_ITERS):
    start = time.perf_counter()
    _, _, dden, rdata, bmat = weighted_arrays(structure, d)
    n_g = len(structure.od.gin.reps)
    m = np.full(n_g, 1.0 / n_g, dtype=np.float64)
    log_r = np.log2(rdata)
    for _ in range(iters):
        dm = np.maximum(np.asarray(bmat.T.dot(m)).ravel() / dden, 1e-300)
        tvals = rdata * (log_r - np.log2(dm[structure.rt]))
        trow = np.add.reduceat(tvals, structure.rptr[:-1])
        trow = np.where(structure.rptr[:-1] < structure.rptr[1:], trow, 0.0)
        w = np.exp2(trow - trow.max()) * m
        total = w.sum()
        if not np.isfinite(total) or total <= 0:
            break
        m = np.maximum(w / total, 1e-300)
        m /= m.sum()
    dm = np.maximum(np.asarray(bmat.T.dot(m)).ravel() / dden, 1e-300)
    tvals = rdata * (log_r - np.log2(dm[structure.rt]))
    trow = np.add.reduceat(tvals, structure.rptr[:-1])
    trow = np.where(structure.rptr[:-1] < structure.rptr[1:], trow, 0.0)
    rate = float(m @ trow)
    dual = float(trow.max())
    weighted_mass = float(dm @ structure.flat_sizes.astype(np.float64))
    assert abs(weighted_mass - 1.0) < 1e-9, weighted_mass
    return {
        "m": m,
        "dm_orbit": dm,
        "rate": rate,
        "dual": dual,
        "wall_s": round(time.perf_counter() - start, 3),
        "weighted_mass": weighted_mass,
    }


def exact_dp_orbit(structure: OrbitStructure, m_in: list[int], d: fmpq) -> list[fmpq]:
    a, b, dden = d_parts(d, structure.n)
    total_m = sum(m_in)
    dp = [fmpq(0) for _ in range(structure.od.n_out)]
    for j, mj in enumerate(m_in):
        if mj == 0:
            continue
        den = total_m * structure.od.gin.sizes[j] * dden
        for pos in range(structure.bptr[j], structure.bptr[j + 1]):
            t = int(structure.bt[pos])
            k = int(structure.flat_lengths[t])
            numerator = int(structure.bf[pos]) * a ** (structure.n - k) * b**k
            dp[t] += fmpq(mj * numerator, den)
    total = fmpq(0)
    for t, value in enumerate(dp):
        total += int(structure.flat_sizes[t]) * value
    assert total == 1, total
    return dp


def cert_primal_structure(
    structure: OrbitStructure, m_in: list[int], d: fmpq
) -> tuple[arb, list[fmpq]]:
    ctx.prec = PREC
    log2 = arb(2).log()
    a, b, dden = d_parts(d, structure.n)
    total_m = sum(m_in)
    dp = exact_dp_orbit(structure, m_in, d)
    result = arb(0)
    for j, mj in enumerate(m_in):
        if mj == 0:
            continue
        weight = arb(fmpq(mj, total_m))
        subtotal = arb(0)
        for pos in range(structure.rptr[j], structure.rptr[j + 1]):
            t = int(structure.rt[pos])
            k = int(structure.rlen[pos])
            w = fmpq(int(structure.ra[pos]) * a ** (structure.n - k) * b**k, dden)
            dy = dp[t]
            assert dy > 0
            subtotal += arb(w) * (arb(w / dy).log() / log2)
        result += weight * subtotal
    return result, dp


def assert_expanded_g_invariance(
    structure: OrbitStructure, dp: list[fmpq]
) -> int:
    """Expand exact orbit masses to words and check generators of S_q x C_2.

    This runs before representative-only KL compression.  A transposition and
    q-cycle generate S_q; reversal generates C_2.
    """
    q = structure.q
    swap = list(range(q))
    if q > 1:
        swap[0], swap[1] = swap[1], swap[0]
    cycle = list(range(1, q)) + [0] if q > 1 else [0]
    checks = 0
    for y in word_iter(q, structure.n):
        mass = dp[structure.od.flat_of_word(y)]
        transformed = (
            tuple(reversed(y)),
            tuple(swap[s] for s in y),
            tuple(cycle[s] for s in y),
        )
        for gy in transformed:
            assert mass == dp[structure.od.flat_of_word(gy)]
            checks += 1
    return checks


def counts_to_dp(
    structure: OrbitStructure, counts: list[int]
) -> tuple[list[fmpq], int]:
    assert len(counts) == structure.od.n_out
    assert all(v > 0 for v in counts)
    total = sum(int(structure.flat_sizes[t]) * counts[t] for t in range(len(counts)))
    dp = [fmpq(counts[t], total) for t in range(len(counts))]
    checks = assert_expanded_g_invariance(structure, dp)
    return dp, checks


def cert_dual_structure(
    structure: OrbitStructure, dp: list[fmpq], d: fmpq
) -> arb:
    ctx.prec = PREC
    log2 = arb(2).log()
    a, b, dden = d_parts(d, structure.n)
    best = None
    for j in range(len(structure.od.gin.reps)):
        subtotal = arb(0)
        for pos in range(structure.rptr[j], structure.rptr[j + 1]):
            t = int(structure.rt[pos])
            k = int(structure.rlen[pos])
            w = fmpq(int(structure.ra[pos]) * a ** (structure.n - k) * b**k, dden)
            dy = dp[t]
            if dy == 0:
                return arb(float("inf"))
            subtotal += arb(w) * (arb(w / dy).log() / log2)
        if best is None or subtotal.upper() > best.upper():
            best = subtotal
    return best if best is not None else arb(0)


def word_snap_candidate(structure: OrbitStructure, dm: np.ndarray) -> tuple[list[int] | None, dict]:
    words = sorted(word_iter(structure.q, structure.n))
    orbit_ids = [structure.od.flat_of_word(y) for y in words]
    snapped = frozen.snap([float(dm[t]) for t in orbit_ids], SNAP_OUT)
    if min(snapped) == 0:
        snapped = [v + 1 for v in snapped]
    per_orbit: list[int | None] = [None] * structure.od.n_out
    mixed: set[int] = set()
    for t, value in zip(orbit_ids, snapped):
        prior = per_orbit[t]
        if prior is None:
            per_orbit[t] = value
        elif prior != value:
            mixed.add(t)
    info = {
        "word_count": len(words),
        "mixed_orbits": len(mixed),
        "first_mixed_orbits": sorted(mixed)[:10],
        "admission_rule": "STRUCTURAL_G_INVARIANCE_ONLY_not_objective_value",
    }
    if mixed:
        info["disposition"] = "DISCARDED_NONINVARIANT"
        return None, info
    assert all(v is not None for v in per_orbit)
    info["disposition"] = "ADMITTED_EXACT_INVARIANT"
    return [int(v) for v in per_orbit], info


def dual_candidates(structure: OrbitStructure, dm: np.ndarray, d: fmpq):
    # These invariant candidates are independently constructed in orbit
    # coordinates before the frozen word-level candidate is even inspected.
    candidate_counts: list[tuple[str, list[int]]] = []
    orbit_counts = frozen.snap([float(v) for v in dm], SNAP_OUT)
    if min(orbit_counts) == 0:
        orbit_counts = [v + 1 for v in orbit_counts]
    candidate_counts.append(("ba_orbit", orbit_counts))
    inv_round = [max(1, int(math.floor(float(v) * SNAP_OUT + 0.5))) for v in dm]
    candidate_counts.append(("ba_invariant_round", inv_round))
    candidate_counts.append(("uniform", [1] * structure.od.n_out))

    # The legacy per-word candidate is admitted solely by exact invariance,
    # never because its objective is favorable.  A split candidate is discarded
    # while the separately named invariant candidates above remain.
    word_counts, word_info = word_snap_candidate(structure, dm)
    if word_counts is not None:
        candidate_counts.append(("ba_word", word_counts))

    values = []
    invariant_checks: dict[str, int] = {}
    value_by_key: dict[tuple[int, ...], arb] = {}
    checks_by_key: dict[tuple[int, ...], int] = {}
    for name, counts in candidate_counts:
        key = tuple(counts)
        if key in value_by_key:
            value = value_by_key[key]
            checks = checks_by_key[key]
        else:
            dp, checks = counts_to_dp(structure, counts)
            value = cert_dual_structure(structure, dp, d)
            value_by_key[key] = value
            checks_by_key[key] = checks
        invariant_checks[name] = checks
        values.append((name, value))
    finite = [
        (name, value)
        for name, value in values
        if value.upper() != float("inf")
    ]
    assert finite
    chosen_name, chosen = min(finite, key=lambda pair: pair[1].upper())
    return chosen_name, chosen, values, word_info, invariant_checks


def sandwich_structure(structure: OrbitStructure, d: fmpq):
    ctx.prec = PREC
    delta = arb(0)
    for idx, k in enumerate(range(1, structure.n)):
        weight = fmpq(math.comb(structure.n, k)) * d ** (structure.n - k) * (
            fmpq(1) - d
        ) ** k
        delta += arb(weight) * structure.phi_ks[idx]
    sw = frozen.sandwich(structure.q, structure.n, d, delta)
    return sw, delta


def certificate_row(structure: OrbitStructure, d: fmpq) -> dict:
    start = time.perf_counter()
    loc = locator(structure, d)
    m_uniform = list(structure.od.gin.sizes)
    m_ba = frozen.snap(loc["m"], SNAP_IN)
    prim_candidates = []
    prim_uniform, _ = cert_primal_structure(structure, m_uniform, d)
    prim_candidates.append(("uniform", prim_uniform))
    prim_ba, _ = cert_primal_structure(structure, m_ba, d)
    prim_candidates.append(("ba", prim_ba))
    primal_name, primal = max(prim_candidates, key=lambda pair: pair[1].upper())

    dual_name, dual, all_duals, word_info, invariant_checks = dual_candidates(
        structure, loc["dm_orbit"], d
    )
    # Permanent sign guard: any finite dual below a primal is an invalid shape.
    if dual.upper() < primal.lower():
        raise AssertionError(
            f"NEGATIVE WIDTH q={structure.q} n={structure.n} d={d}: "
            f"primal={primal} dual={dual}"
        )

    sw, delta = sandwich_structure(structure, d)
    per_primal = primal / structure.n
    per_dual = dual / structure.n
    lower_beats = per_primal.lower() > sw["lbplus"].upper()
    lower_beats_lb1 = per_primal.lower() > sw["lb1"].upper()
    upper_beats = per_dual.upper() < sw["ub"].lower()
    verdicts = []
    if upper_beats:
        verdicts.append("CERT_UPPER_BEATS_UB")
    if lower_beats:
        verdicts.append("CERT_LOWER_BEATS_LBplus")
    elif lower_beats_lb1:
        verdicts.append("CERT_LOWER_BEATS_LB1_ONLY")
    if not verdicts:
        verdicts.append("NO_STRICT_IMPROVEMENT")

    lo = float(per_primal.lower())
    hi = float(per_dual.upper())
    if hi < lo:
        raise AssertionError(("NEGATIVE WIDTH FLOAT", lo, hi))
    return {
        "status": "CERTIFIED",
        "q": structure.q,
        "n": structure.n,
        "d": str(d),
        "lb1": float(sw["lb1"]),
        "lbplus": float(sw["lbplus"]),
        "ub": float(sw["ub"]),
        "delta_n": float(delta),
        "cert_lo_block": float(primal.lower()),
        "cert_hi_block": float(dual.upper()),
        "cert_lo_per_symbol": lo,
        "cert_hi_per_symbol": hi,
        "cert_width_per_symbol": hi - lo,
        "lower_gain_over_lbplus": lo - float(sw["lbplus"].upper()),
        "upper_gain_below_ub": float(sw["ub"].lower()) - hi,
        "primal_ball": str(primal),
        "dual_ball": str(dual),
        "primal_rad": float(primal.rad()),
        "dual_rad": float(dual.rad()),
        "primal_from": primal_name,
        "dual_from": dual_name,
        "dual_candidates": {name: str(value) for name, value in all_duals},
        "word_snap_guard": word_info,
        "dual_expanded_g_invariance_checks": invariant_checks,
        "width_sign_check": "PASS",
        "n_g_orbits": len(structure.od.gin.reps),
        "n_out_g_orbits": structure.od.n_out,
        "n_words": structure.q**structure.n,
        "n_out_words": sum(structure.q**k for k in range(structure.n + 1)),
        "representative_subsequence_entries": structure.rep_entries,
        "orbit_sum_nonzero_slots": structure.orbit_slots,
        "snap_in": SNAP_IN,
        "snap_out": SNAP_OUT,
        "ba_iters": BA_ITERS,
        "ba_rate_float_block": loc["rate"],
        "ba_dual_float_block": loc["dual"],
        "ba_weighted_mass": loc["weighted_mass"],
        "locator_wall_s": loc["wall_s"],
        "structure_build_wall_s": structure.build_wall_s,
        "verdict": "+".join(verdicts),
        "evidence_label": "MACHINE-VERIFIED",
        "wall_s": round(time.perf_counter() - start, 3),
    }


# ---------------------------------------------------------------------------
# Startup anchors


def assert_frozen_row(anchor: dict, frozen_row: dict) -> None:
    for field in (
        "cert_lo_per_symbol",
        "cert_hi_per_symbol",
        "primal_ball",
        "dual_ball",
        "verdict",
    ):
        if anchor[field] != frozen_row[field]:
            raise AssertionError(
                f"frozen row mismatch field={field}: {anchor[field]!r} != "
                f"{frozen_row[field]!r}"
            )


def equivariance_q4_control() -> dict:
    q, n = 4, 3
    outputs = list(word_iter(q, n))
    checked = 0
    for x in itertools.product(range(q), repeat=n):
        for perm in itertools.permutations(range(q)):
            mapping = dict(zip(range(q), perm))
            xp = tuple(mapping[s] for s in x)
            for y in outputs:
                yp = tuple(mapping[s] for s in y)
                assert frozen.nsub(xp, yp) == frozen.nsub(x, y)
                assert frozen.nsub(tuple(reversed(xp)), tuple(reversed(yp))) == frozen.nsub(x, y)
                checked += 1
    x = (0, 0, 1, 0)
    x_position_permuted = (0, 1, 0, 0)
    y = (1, 0)
    live = frozen.nsub(x, y)
    planted = frozen.nsub(x_position_permuted, y)
    assert live == 1 and planted == 2 and live != planted
    return {
        "q4_joint_equivariance_checks": checked,
        "position_control": {
            "x": list(x),
            "position_permuted_x": list(x_position_permuted),
            "y": list(y),
            "A_original": live,
            "A_position_permuted": planted,
            "status": "BREAKS_AS_REQUIRED",
        },
    }


def compare_structure_with_frozen(q: int, n: int, d: fmpq) -> dict:
    structure = build_structure(q, n)
    odf = frozen.OrbitData(q, n, d, log=lambda *_: None)
    os_rows = frozen.merged_OS(odf)
    a, b, _ = d_parts(d, n)
    mismatches = 0
    checked = 0
    # Every canonical output representative, every input representative.
    for k in range(n + 1):
        for gi, y0 in enumerate(odf.gout[k].reps):
            t = odf.base[k] + gi
            coeff = a ** (n - k) * b**k
            for j in range(len(odf.gin.reps)):
                start = structure.bptr[j]
                stop = structure.bptr[j + 1]
                pos = np.searchsorted(structure.bt[start:stop], t)
                f_value = 0
                if pos < stop - start and int(structure.bt[start + pos]) == t:
                    f_value = int(structure.bf[start + pos])
                expected = f_value * coeff
                actual = os_rows[j].get(y0, 0)
                checked += 1
                if expected != actual:
                    mismatches += 1
                    if mismatches <= 5:
                        log(
                            f"orbit-sum mismatch q={q} n={n} j={j} t={t}: "
                            f"new={expected} frozen={actual}"
                        )
    assert mismatches == 0
    # Deterministic per-word sample, all words for sampled input orbits.
    rng = random.Random(20260831)
    sample_js = rng.sample(range(len(odf.gin.reps)), min(12, len(odf.gin.reps)))
    per_word_checked = 0
    per_word_mismatches = 0
    for j in sample_js:
        mapping = {
            int(structure.bt[pos]): int(structure.bf[pos])
            for pos in range(structure.bptr[j], structure.bptr[j + 1])
        }
        for y in word_iter(q, n):
            t = odf.flat_of_word(y)
            coeff = a ** (n - len(y)) * b ** len(y)
            expected = mapping.get(t, 0) * coeff
            actual = os_rows[j].get(y, 0)
            per_word_checked += 1
            if expected != actual:
                per_word_mismatches += 1
    assert per_word_mismatches == 0
    return {
        "q": q,
        "n": n,
        "d": str(d),
        "canonical_checks": checked,
        "canonical_mismatches": mismatches,
        "per_word_sample_input_orbits": sample_js,
        "per_word_checks": per_word_checked,
        "per_word_mismatches": per_word_mismatches,
        "status": "PASS",
    }


def frozen_word_snap_audit_row(q: int, n: int, d: fmpq) -> dict:
    """Reconstruct the frozen float locator and inspect its integer word snap."""
    od = frozen.OrbitData(q, n, d, log=lambda *_: None)
    os_rows = frozen.merged_OS(od)
    _, dword, rate, dual = frozen.ba_orbit_fine(
        od, os_rows, iters=BA_ITERS
    )
    words = sorted(word_iter(q, n))
    orbit_ids = []
    float_masses = []
    for y in words:
        og = od.gout[len(y)]
        gi = og.word_orbit[y]
        rep = og.reps[gi]
        value = dword.get(rep)
        if value is None:
            value = dword.get(tuple(reversed(rep)))
        if value is None:
            for z, candidate in dword.items():
                if len(z) == len(y) and og.word_orbit[z] == gi:
                    value = candidate
                    break
        assert value is not None
        orbit_ids.append(od.base[len(y)] + gi)
        float_masses.append(float(value))
    snapped = frozen.snap(float_masses, SNAP_OUT)
    zeroed_before_offset = sum(value == 0 for value in snapped)
    if min(snapped) == 0:
        snapped = [value + 1 for value in snapped]
    values_by_orbit: dict[int, set[int]] = {}
    for t, value in zip(orbit_ids, snapped):
        values_by_orbit.setdefault(t, set()).add(value)
    flat_sizes = [
        size
        for k in range(n + 1)
        for size in od.gout[k].sizes
    ]
    mixed = [
        {
            "flat_orbit": t,
            "orbit_size": flat_sizes[t],
            "min_count": min(values_by_orbit[t]),
            "max_count": max(values_by_orbit[t]),
        }
        for t in sorted(values_by_orbit)
        if len(values_by_orbit[t]) != 1
    ]
    return {
        "q": q,
        "n": n,
        "d": str(d),
        "word_count": len(words),
        "mixed_orbits": len(mixed),
        "first_mixed_orbits": mixed[:10],
        "zeroed_before_offset": zeroed_before_offset,
        "ba_rate_float_block": rate,
        "ba_dual_float_block": dual,
        "integer_snap_invariance_evidence_label": "MACHINE-VERIFIED",
        "float_locator_evidence_label": "COMPUTATIONAL-EVIDENCE",
        "status": "PASS" if not mixed else "FAIL_NONINVARIANT",
    }


def snap_invariance_regression() -> dict:
    """Preserve the out-of-grid split-snap counterexample as a regression."""
    d = fmpq(1, 2)
    structure = build_structure(3, 3)
    guarded = certificate_row(structure, d)
    dense_row = dense.row(3, 3, d)
    legacy = frozen.row(3, 3, d, log=lambda *_: None)
    good, overlap_length = overlap(guarded, dense_row)
    assert legacy["cert_width_per_symbol"] < 0
    assert guarded["word_snap_guard"]["mixed_orbits"] > 0
    assert guarded["word_snap_guard"]["disposition"] == "DISCARDED_NONINVARIANT"
    assert guarded["dual_from"] != "ba_word"
    assert good
    return {
        "q": 3,
        "n": 3,
        "d": "1/2",
        "campaign_grid_membership": "OUT_OF_GRID_CONTROL",
        "legacy_interval": [
            legacy["cert_lo_per_symbol"],
            legacy["cert_hi_per_symbol"],
        ],
        "legacy_width": legacy["cert_width_per_symbol"],
        "legacy_dual_from": legacy["dual_from"],
        "legacy_word_snap_guard": guarded["word_snap_guard"],
        "guarded_interval": [
            guarded["cert_lo_per_symbol"],
            guarded["cert_hi_per_symbol"],
        ],
        "guarded_dual_from": guarded["dual_from"],
        "guarded_invariance_checks": guarded[
            "dual_expanded_g_invariance_checks"
        ],
        "dense_interval": [
            dense_row["cert_lo_per_symbol"],
            dense_row["cert_hi_per_symbol"],
        ],
        "guarded_dense_overlap_length": overlap_length,
        "integer_and_Arb_checks_evidence_label": "MACHINE-VERIFIED",
        "float_locator_evidence_label": "COMPUTATIONAL-EVIDENCE",
        "status": "REGRESSION_PASS",
    }


def append_rows(rows: list[dict]) -> None:
    done = set()
    if ROWS_PATH.exists():
        for line in ROWS_PATH.read_text().splitlines():
            if not line.strip():
                continue
            row = json.loads(line)
            done.add((row.get("q"), row.get("n"), row.get("d")))
    with ROWS_PATH.open("a") as fh:
        for row in rows:
            key = (row.get("q"), row.get("n"), row.get("d"))
            if key in done:
                continue
            fh.write(json.dumps(row, sort_keys=True) + "\n")
            fh.flush()
            done.add(key)


def overlap(a: dict, b: dict) -> tuple[bool, float]:
    lo = max(a["cert_lo_per_symbol"], b["cert_lo_per_symbol"])
    hi = min(a["cert_hi_per_symbol"], b["cert_hi_per_symbol"])
    return lo <= hi, hi - lo


def anchors_stage() -> None:
    census = json.loads(CENSUS_PATH.read_text())
    assert census["status"] == "PASS"
    log("anchor stage start")
    anchor: dict = {"status": "IN_PROGRESS", "started_utc": utc()}
    write_json(ANCHOR_PATH, anchor)

    frozen._selftest(log=log)
    anchor["frozen_selftest_A1_A6"] = "PASS"
    write_json(ANCHOR_PATH, anchor)

    inf = frozen.raw_snap_dual_check(2, 10, fmpq(1, 20))
    assert inf["dual_raw_is_inf"] and inf["n_zeroed"] == 1
    write_json(INF_PATH, inf)
    anchor["inf_branch"] = inf
    write_json(ANCHOR_PATH, anchor)

    frozen_rows = [json.loads(line) for line in (FROZEN / "orbit_rows.jsonl").read_text().splitlines()]
    frozen_by_key = {(row["q"], row["n"], row["d"]): row for row in frozen_rows}
    bit_anchors = []
    for q, n, d in ((3, 6, fmpq(1, 2)), (3, 10, fmpq(1, 2))):
        actual = frozen.row(q, n, d, log=log)
        expected = frozen_by_key[(q, n, str(d))]
        assert_frozen_row(actual, expected)
        bit_anchors.append(
            {
                "q": q,
                "n": n,
                "d": str(d),
                "cert_lo_per_symbol": actual["cert_lo_per_symbol"],
                "cert_hi_per_symbol": actual["cert_hi_per_symbol"],
                "primal_ball_match": actual["primal_ball"] == expected["primal_ball"],
                "dual_ball_match": actual["dual_ball"] == expected["dual_ball"],
                "status": "BIT_FOR_BIT_PASS",
            }
        )
    anchor["frozen_q3_bit_anchors"] = bit_anchors
    write_json(ANCHOR_PATH, anchor)

    regression = snap_invariance_regression()
    write_json(SNAP_REGRESSION_PATH, regression)
    anchor["out_of_grid_snap_regression"] = regression
    write_json(ANCHOR_PATH, anchor)

    snap_audit = {
        "status": "IN_PROGRESS",
        "scope": "all 20 frozen q=3 rows: n=6..10, d in {1/2,1/5,1/10,1/20}",
        "rows": [],
        "started_utc": utc(),
    }
    write_json(FROZEN_SNAP_AUDIT_PATH, snap_audit)
    for n in range(6, 11):
        for d in D_GRID:
            audited = frozen_word_snap_audit_row(3, n, d)
            audited["frozen_artifact_dual_from"] = frozen_by_key[
                (3, n, str(d))
            ]["dual_from"]
            snap_audit["rows"].append(audited)
            write_json(FROZEN_SNAP_AUDIT_PATH, snap_audit)
            if audited["mixed_orbits"] != 0:
                snap_audit["status"] = "FAIL_NONINVARIANT_FROZEN_GRID"
                write_json(FROZEN_SNAP_AUDIT_PATH, snap_audit)
                write_json(
                    ESCALATE_PATH,
                    {
                        "reason": "frozen published row used a non-invariant word snap",
                        "row": audited,
                        "status": "ESCALATE_TO_MAIN",
                    },
                )
                raise AssertionError(
                    "frozen-grid non-invariant word snap; escalate before recording"
                )
    snap_audit["status"] = "PASS_ALL_20_EXACTLY_INVARIANT_AFTER_SNAP"
    snap_audit["completed_utc"] = utc()
    snap_audit["rows_checked"] = len(snap_audit["rows"])
    write_json(FROZEN_SNAP_AUDIT_PATH, snap_audit)
    anchor["frozen_q3_snap_invariance_audit"] = {
        "status": snap_audit["status"],
        "rows_checked": snap_audit["rows_checked"],
    }
    write_json(ANCHOR_PATH, anchor)

    eq = equivariance_q4_control()
    anchor["q4_equivariance_and_position_control"] = eq
    write_json(ANCHOR_PATH, anchor)

    b_compare = compare_structure_with_frozen(3, 9, fmpq(1, 2))
    anchor["orbit_sum_vs_frozen"] = b_compare
    write_json(ANCHOR_PATH, anchor)

    sparse_overlaps = []
    for n in (6, 10):
        structure = build_structure(3, n)
        new_row = certificate_row(structure, fmpq(1, 2))
        old_row = frozen_by_key[(3, n, "1/2")]
        good, length = overlap(new_row, old_row)
        assert good
        assert new_row["word_snap_guard"]["mixed_orbits"] == 0
        assert (
            new_row["word_snap_guard"]["disposition"]
            == "ADMITTED_EXACT_INVARIANT"
        )
        sparse_overlaps.append(
            {
                "q": 3,
                "n": n,
                "d": "1/2",
                "frozen": [old_row["cert_lo_per_symbol"], old_row["cert_hi_per_symbol"]],
                "new": [new_row["cert_lo_per_symbol"], new_row["cert_hi_per_symbol"]],
                "overlap_length": length,
                "word_snap_guard": new_row["word_snap_guard"],
                "status": "OVERLAP_PASS",
            }
        )
        del structure
    anchor["sparse_path_q3_overlaps"] = sparse_overlaps
    write_json(ANCHOR_PATH, anchor)

    crosschecks = []
    staged_rows = []
    structure5 = build_structure(4, 5)
    for d in D_GRID:
        orbit_row = certificate_row(structure5, d)
        dense_row = dense.row(4, 5, d)
        good, length = overlap(orbit_row, dense_row)
        assert good
        crosschecks.append(
            {
                "q": 4,
                "n": 5,
                "d": str(d),
                "dense": [dense_row["cert_lo_per_symbol"], dense_row["cert_hi_per_symbol"]],
                "orbit": [orbit_row["cert_lo_per_symbol"], orbit_row["cert_hi_per_symbol"]],
                "overlap_length": length,
                "status": "OVERLAP_PASS",
            }
        )
        staged_rows.append(orbit_row)
    del structure5

    structure6 = build_structure(4, 6)
    d = fmpq(1, 2)
    orbit_row6 = certificate_row(structure6, d)
    dense_row6 = dense.row(4, 6, d)
    good, length = overlap(orbit_row6, dense_row6)
    assert good
    crosschecks.append(
        {
            "q": 4,
            "n": 6,
            "d": str(d),
            "dense": [dense_row6["cert_lo_per_symbol"], dense_row6["cert_hi_per_symbol"]],
            "orbit": [orbit_row6["cert_lo_per_symbol"], orbit_row6["cert_hi_per_symbol"]],
            "overlap_length": length,
            "status": "OVERLAP_PASS",
        }
    )
    staged_rows.append(orbit_row6)
    del structure6

    write_json(CROSSCHECK_PATH, crosschecks)
    append_rows(staged_rows)
    anchor["q4_dense_crosschecks"] = crosschecks
    anchor["status"] = "PASS"
    anchor["completed_utc"] = utc()
    write_json(ANCHOR_PATH, anchor)
    log("anchor stage PASS")


# ---------------------------------------------------------------------------
# Fixed-grid row execution and table generation


class RowTimeout(Exception):
    pass


def alarm_handler(signum, frame):
    del signum, frame
    raise RowTimeout("pre-registered 90-minute row wall reached")


def read_done_keys() -> set[tuple[int, int, str]]:
    done = set()
    if ROWS_PATH.exists():
        for line in ROWS_PATH.read_text().splitlines():
            if line.strip():
                row = json.loads(line)
                done.add((row.get("q"), row.get("n"), row.get("d")))
    return done


def row_grid() -> list[tuple[int, int, fmpq]]:
    grid = []
    for n in range(5, 11):
        for d in D_GRID:
            grid.append((4, n, d))
    for d in D_GRID:
        grid.append((3, 11, d))
    return grid


def rows_stage() -> None:
    anchor = json.loads(ANCHOR_PATH.read_text())
    assert anchor["status"] == "PASS"
    done = read_done_keys()
    grouped: dict[tuple[int, int], list[fmpq]] = {}
    for q, n, d in row_grid():
        if (q, n, str(d)) not in done:
            grouped.setdefault((q, n), []).append(d)
    old_handler = signal.signal(signal.SIGALRM, alarm_handler)
    try:
        for (q, n), ds in grouped.items():
            log(f"fixed-grid structure build q={q} n={n} for {len(ds)} remaining rows")
            structure = build_structure(q, n)
            for d in ds:
                signal.alarm(ROW_TIMEOUT_S)
                try:
                    row = certificate_row(structure, d)
                except RowTimeout as error:
                    row = {
                        "status": "NOT_REACHED_RESOURCE",
                        "q": q,
                        "n": n,
                        "d": str(d),
                        "reason": str(error),
                        "evidence_label": "FAILURE TO CERTIFY",
                        "n_g_orbits": len(structure.od.gin.reps),
                        "n_out_g_orbits": structure.od.n_out,
                        "representative_subsequence_entries": structure.rep_entries,
                        "orbit_sum_nonzero_slots": structure.orbit_slots,
                    }
                    log(f"RESOURCE STOP q={q} n={n} d={d}: {error}")
                finally:
                    signal.alarm(0)
                append_rows([row])
                if row["status"] == "CERTIFIED":
                    lo = row["cert_lo_per_symbol"]
                    hi = row["cert_hi_per_symbol"]
                    log(
                        f"q={q} n={n} d={d}: LB+={row['lbplus']:.9f} "
                        f"UB={row['ub']:.9f} cert=[{lo:.9f},{hi:.9f}] "
                        f"w={row['cert_width_per_symbol']:.3e} "
                        f"lower_gain={row['lower_gain_over_lbplus']:.3e} "
                        f"upper_gain={row['upper_gain_below_ub']:.3e} "
                        f"{row['verdict']} [{row['wall_s']}s]"
                    )
                    if hi < row["lbplus"] or lo > row["ub"]:
                        payload = {
                            "q": q,
                            "n": n,
                            "d": str(d),
                            "row": row,
                            "reason": "certified interval excludes published sandwich",
                        }
                        write_json(ESCALATE_PATH, payload)
                        raise RuntimeError("ESCALATE_TO_MAIN before README write")
            del structure
    finally:
        signal.signal(signal.SIGALRM, old_handler)
    log("fixed-grid row stage complete")


def table_stage() -> None:
    rows = [json.loads(line) for line in ROWS_PATH.read_text().splitlines() if line.strip()]
    by_key = {(row["q"], row["n"], row["d"]): row for row in rows}
    expected = {(q, n, str(d)) for q, n, d in row_grid()}
    missing = sorted(expected - set(by_key))
    certified = [row for row in rows if row.get("status") == "CERTIFIED"]
    for row in certified:
        assert row["cert_width_per_symbol"] >= 0
        assert row["width_sign_check"] == "PASS"
    path = CAMPAIGN / "TABLE_rows.csv"
    fields = [
        "q",
        "n",
        "d",
        "lbplus",
        "ub",
        "cert_lo_per_symbol",
        "cert_hi_per_symbol",
        "cert_width_per_symbol",
        "lower_gain_over_lbplus",
        "upper_gain_below_ub",
        "verdict",
        "evidence_label",
        "status",
    ]
    with path.open("w", newline="") as fh:
        writer = csv.DictWriter(fh, fieldnames=fields, extrasaction="ignore")
        writer.writeheader()
        for key in sorted(by_key, key=lambda item: (item[0] != 4, item[0], item[1], item[2])):
            writer.writerow(by_key[key])
    summary = {
        "expected_rows": len(expected),
        "present_rows": len(expected & set(by_key)),
        "certified_rows": len([by_key[k] for k in expected & set(by_key) if by_key[k].get("status") == "CERTIFIED"]),
        "missing_rows": missing,
        "resource_stops": [row for row in rows if row.get("status") == "NOT_REACHED_RESOURCE"],
        "both_ends_improved": sum(
            row.get("verdict")
            == "CERT_UPPER_BEATS_UB+CERT_LOWER_BEATS_LBplus"
            for row in certified
        ),
        "min_width": min((row["cert_width_per_symbol"] for row in certified), default=None),
        "max_width": max((row["cert_width_per_symbol"] for row in certified), default=None),
        "status": "PASS" if not missing else "INCOMPLETE",
    }
    write_json(CAMPAIGN / "row_summary.json", summary)
    log(f"table stage {summary}")


def selfcheck_small() -> None:
    log("small selfcheck start")
    for q, n in ((2, 3), (3, 3), (4, 3)):
        direct_reps, direct_sizes, _, _ = rgs_orbit_data(q, n)
        frozen_orbits = frozen.GOrbits(q, n)
        assert direct_reps == frozen_orbits.reps
        assert direct_sizes == frozen_orbits.sizes
    structure = build_structure(3, 3)
    row = certificate_row(structure, fmpq(1, 2))
    dense_row = dense.row(3, 3, fmpq(1, 2))
    frozen_row = frozen.row(3, 3, fmpq(1, 2), log=lambda *_: None)
    # Counterfactual plant: the frozen per-word largest-remainder snap splits
    # an output orbit here and yields a negative width.  The guarded path must
    # detect/discard it and overlap the independent dense certificate.
    assert frozen_row["cert_width_per_symbol"] < 0
    assert row["word_snap_guard"]["mixed_orbits"] > 0
    assert row["dual_from"] != "ba_word"
    assert overlap(row, dense_row)[0]
    assert row["width_sign_check"] == "PASS"
    log("small selfcheck PASS")


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "stage", choices=("selfcheck", "census", "anchors", "rows", "table")
    )
    args = parser.parse_args()
    ctx.prec = PREC
    code_hash = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
    log(f"stage={args.stage}; code_sha256={code_hash}; Arb={PREC} bits")
    if args.stage == "selfcheck":
        selfcheck_small()
    elif args.stage == "census":
        census_stage()
    elif args.stage == "anchors":
        anchors_stage()
    elif args.stage == "rows":
        rows_stage()
    else:
        table_stage()


if __name__ == "__main__":
    main()
