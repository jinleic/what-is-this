import sys,itertools
CAMP='/Users/jinleic/jinleic-workspace/cs/delcap/campaigns/2026-08-30T17:50:25Z_ddd57c90-d088-47c1-acda-dcb54bcf3555'
SRC='/Users/jinleic/jinleic-workspace/cs/delcap/src'
sys.path.insert(0,CAMP); sys.path.insert(0,SRC)
import gate_c_orbit as go
from flint import fmpq

def check(q,n,d):
    OD=go.OrbitData(q,n,d,log=lambda *_:None); OS=go.merged_OS(OD)
    m,Dword,rate,dual=go.ba_orbit_fine(OD,OS,iters=4000)
    word_full={}
    for y in itertools.chain.from_iterable(itertools.product(range(q), repeat=k) for k in range(n+1)):
        og=OD.gout[len(y)]; gi=og.word_orbit[y]; rep=og.reps[gi]
        v=Dword.get(rep)
        if v is None:
            v=Dword.get(tuple(reversed(rep)),0.0)
            if v==0.0:
                for z,vz in Dword.items():
                    if og.word_orbit[z]==gi:
                        v=vz; break
        word_full[y]=v if v is not None else 0.0
    words=sorted(word_full); mi=go.snap([word_full[y] for y in words],1<<30)
    if min(mi)==0: mi=[v+1 for v in mi]
    vals={y:v for y,v in zip(words,mi)}
    mixed=[]
    for k in range(n+1):
        og=OD.gout[k]
        for gi in range(len(og.reps)):
            s={vals[y] for y in itertools.product(range(q),repeat=k) if og.word_orbit[y]==gi}
            if len(s)>1: mixed.append((k,gi,og.sizes[gi],min(s),max(s),len(s)))
    print(q,n,d,'mixed_orbits',len(mixed),'first',mixed[:10])
    # compare finite rep-only value for word snap; full input max catches noninvariance
    OD.Dp_word={y:fmpq(v,sum(mi)) for y,v in vals.items()}
    rep=go.cert_dual(OD,None)
    best=None
    for x in itertools.product(range(q),repeat=n):
        s=go.arb(0); log2=go.arb(2).log()
        for y,c0 in go.dpdict(x,n).items():
            W=fmpq(OD.transition(y,c0),OD.Dden); Dy=OD.Dp_word[y]
            if Dy==0: s=go.arb(float('inf')); break
            s += go.arb(W)*(go.arb(W/Dy).log()/log2)
        if best is None or s.upper()>best.upper(): best=s
    print('rep_upper',float(rep.upper()),'full_upper',float(best.upper()),'diff',float(best.upper()-rep.upper()))

check(3,6,fmpq(1,2))
