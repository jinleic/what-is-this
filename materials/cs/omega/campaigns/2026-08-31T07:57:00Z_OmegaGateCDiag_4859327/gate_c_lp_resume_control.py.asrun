"""Cheap control for gate_c_endgame LP/ANY-y stage from frozen checkpoint.

Uses one-ULP outward expansion of checkpointed float endpoints. This validates
LP algebra and the ANY-y Arb residual without rerunning the 2x slope passes.
"""
import json, sys
import numpy as np
from scipy.optimize import linprog
from flint import arb

SRC = "/Users/jinleic/jinleic-workspace/cs/omega/src"
sys.path.insert(0, SRC)
import interval_core as IC

ROOT = "/Users/jinleic/jinleic-workspace/cs/omega"
CAMP = ROOT + "/campaigns/2026-08-30T11:24:41Z_17bdaeb6_099b1224d603"
ck = json.load(open(ROOT + "/scratch/endgame_gatecdiag.json"))
lo = np.nextafter(np.asarray(ck["slope_box"]["grad_lo"]), -np.inf)
hi = np.nextafter(np.asarray(ck["slope_box"]["grad_hi"]), np.inf)
A = np.load(CAMP + "/margin_matrix_M.npy")
Vq = json.load(open(CAMP + "/kernel_basis_V_exact_rational.json"))
V = np.column_stack([[p / q for p, q in Vq[str(j)]] for j in range(21)])
assert np.max(np.abs(A @ V)) == 0.0
assert np.max(np.abs(V.sum(axis=0))) == 0.0

mid = (lo + hi) / 2.0
Aub = np.vstack([V, -V])
r = linprog(V.T @ mid, A_ub=Aub, b_ub=np.ones(90),
            bounds=[(None, None)] * 21, method="highs")
assert r.status == 0
candidate = 1e-7 * float(r.fun)
delta = 1e-7 * (V @ r.x)
assert np.max(np.abs(delta)) <= 1e-7
assert np.max(np.abs(A @ delta)) < 1e-20

fit_obj = np.concatenate([np.zeros(27), np.ones(45)])
fit_A = np.vstack([np.hstack([A.T, -np.eye(45)]),
                   np.hstack([-A.T, -np.eye(45)])])
fit_b = np.concatenate([lo, -hi])
fit = linprog(fit_obj, A_ub=fit_A, b_ub=fit_b,
              bounds=[(None, None)] * 27 + [(0, None)] * 45,
              method="highs")
assert fit.status == 0
y = fit.x[:27]

with IC.prec():
    z = IC.Ival(arb(0), arb(0))
    g = [IC.Ival(IC.const(float(lo[i])).lo, IC.const(float(hi[i])).hi)
         for i in range(45)]
    def residual_for(yv):
        total = z
        for i, gi in enumerate(g):
            aty = z
            for j in np.flatnonzero(A[:, i]):
                aty = aty + IC.const(float(yv[j]))
            total = total + (gi - aty).pos()
        return total
    resid = residual_for(y)
    control = residual_for(np.zeros(27))
    swing = IC.const(1e-7) * resid
    swing0 = IC.const(1e-7) * control
    out = {
        "midpoint_candidate_COMPUTATIONAL_EVIDENCE": candidate,
        "any_y_fit_objective_float": float(fit.fun),
        "any_y_residual_hi_buffered_MACHINE_VERIFIED": float(resid.up()),
        "linear_swing_hi_buffered_MACHINE_VERIFIED": float(swing.up()),
        "width_MACHINE_VERIFIED": 2.0 * float(swing.up()),
        "zero_y_control_swing_hi_MACHINE_VERIFIED": float(swing0.up()),
    }
print(json.dumps(out, indent=1))
assert out["zero_y_control_swing_hi_MACHINE_VERIFIED"] > \
       out["linear_swing_hi_buffered_MACHINE_VERIFIED"]
