'''


def _fraction_point(value):
    """Exact interval for a Fraction (v11 round-8 fix): wraps the Arb
    ball's lower/upper endpoints via from_two (which now uses b.upper()
    on top), correctly handling NON-DYADIC rationals like Fraction(1,3)
    whose Arb representation is a nonzero-radius ball."""
    numerator = Fraction(value).numerator
    denominator = Fraction(value).denominator
    ball = arb(numerator) / arb(denominator)
    return IC.from_two(ball.lower(), ball.upper())

def arb_exact_fraction(value):
    """D2 (Main v11): exact FINITE Arb point -> Fraction via man_exp.

    Extracts mantissa/exponent from the Arb ball itself, requiring an
    exact zero radius (a point).  This handles >53-bit dyadics that
    Fraction.from_float would silently round.  Non-point or infinite/
    NaN inputs are hard aborts."""
    if not isinstance(value, arb):
        value = arb(value)
    if not value.is_finite():
        raise RuntimeError("arb_exact_fraction: nonfinite Arb value")
    mid = (value.lower() + value.upper()) / 2
    radius = (value.upper() - value.lower()) / 2
    if radius != 0:
        raise RuntimeError("arb_exact_fraction: nonzero-radius ball "
                           f"[{value.lower()}, {value.upper()}] is not a "
                           "point")
    man, exp = mid.man_exp()
    # man_exp returns (mantissa, exponent) with value = mantissa * 2**exp
    # and mantissa an integer.
    if int(man) != man:
        raise RuntimeError("arb_exact_fraction: noninteger mantissa")
    return Fraction(int(man), 1) / Fraction(2) ** int(-exp) if exp < 0 \
        else Fraction(int(man), 1) * Fraction(2) ** int(exp)


def exact_dyadic_fraction(interval):
    """v11 D2 rewrite: exact finite Arb point -> Fraction via the exact
    Arb extraction above, then reconstruct-and-compare byte-exact
    endpoint equality.  A 71-bit dyadic now round-trips PASSES; nonpoint
    remains a hard abort; nonfinite is a hard abort."""
    if interval.lo != interval.hi:
        raise RuntimeError(
            "exact_dyadic_fraction: non-point interval "
            f"[{float(interval.lo)!r}, {float(interval.hi)!r}]")
    exact_fraction = arb_exact_fraction(interval.lo)
    # Byte-exact reconstruction through Arb: must reproduce BOTH endpoints.
    numerator = exact_fraction.numerator
    denominator = exact_fraction.denominator
    reconstructed_arb = arb(numerator) / arb(denominator)
    reconstructed = I(arb(reconstructed_arb.lower()),
                      arb(reconstructed_arb.upper()))
    if reconstructed.lo != interval.lo or reconstructed.hi != interval.hi:
        raise RuntimeError(
            "exact_dyadic_fraction: byte-exact round-trip mismatch; "
            f"{exact_fraction} does not reproduce "
            f"[{interval.lo}, {interval.hi}]")
    return exact_fraction


def mass_aware_feasible(distribution_intervals, matrix_int,
                        distribution_max_intervals):
    """Exact mass-aware feasibility test (audit round-5/6).

    Target mass is m = sum(p) (exact Fraction, m > 0); a candidate
    certificate distribution must satisfy total == m and every full B
    row equal b = B p, with every coordinate >= 0.  The old simplex-era
    test required total == 1 and was wrong for the actual generalized
    entropy consumed by the objective.

    Conversion policy (v11 round-8, centralized): Fraction inputs pass
    through unchanged; interval points go through exact_dyadic_fraction
    which uses arb_exact_fraction (exact finite Arb dyadic — arbitrary
    >53-bit dyadics are supported, not restricted to binary64);
    non-point pmax is recorded and rejected, never silently rounded.
    Returns (m, b_full, status):
      status == "exact-feasible" only when ALL checks pass exactly.
    """
    def _to_fraction(entry):
        if isinstance(entry, Fraction):
            return entry
        if hasattr(entry, "lo"):
            return exact_dyadic_fraction(entry)
        return None
    fractions = [_to_fraction(z) for z in distribution_intervals]
    if any(x is None for x in fractions):
        return None, None, "interval distribution is not an exact point"
    zero = Fraction(0)
    m = sum(fractions)
    if m <= 0:
        return m, None, "distribution mass is not positive"
    if any(x < 0 for x in fractions):
        return m, b_full_or_none(fractions, matrix_int), \
            "distribution has a negative coordinate"
    fractions_max = []
    pmax_nonpoint = False
    for entry in distribution_max_intervals:
        if isinstance(entry, Fraction):
            fractions_max.append(entry)
        elif hasattr(entry, "lo"):
            if entry.lo != entry.hi:
                # Non-point pmax is REJECTED, never silently rounded;
                # record None and reject below WITHOUT invoking the
                # hard-abort converter (audit round-6/7 centralization).
                pmax_nonpoint = True
                fractions_max.append(None)
            else:
                fractions_max.append(exact_dyadic_fraction(entry))
        else:
            pmax_nonpoint = True
            fractions_max.append(None)
    b_full = [
        sum(matrix_int[row, i] * fractions[i]
            for i in np.flatnonzero(matrix_int[row]) if fractions[i] != 0)
        for row in range(matrix_int.shape[0])]
    overlap_only = any(x is None for x in fractions_max)
    negatives = [x for x in fractions_max if x is not None and x < 0]
    if overlap_only or negatives or pmax_nonpoint:
        return m, b_full, ("stored dist_max REJECTED (overlap="
                           f"{ overlap_only } negatives={ bool(negatives) } "
                           f"nonpoint={ pmax_nonpoint })")
    total_max = sum(fractions_max)
    margins = [
        sum(matrix_int[row, i] * fractions_max[i]
            for i in np.flatnonzero(matrix_int[row]) if fractions_max[i] != 0)
        for row in range(matrix_int.shape[0])]
    exact_ok = (total_max == m) and all(
        margins[row] == b_full[row] for row in range(len(b_full)))
    if not exact_ok:
        return m, b_full, "stored dist_max REJECTED by exact Fraction tests"
    return m, b_full, "exact-feasible"


def b_full_or_none(fractions, matrix_int):
    return [
        sum(matrix_int[row, i] * fractions[i]
            for i in np.flatnonzero(matrix_int[row])
            if fractions[i] != 0)
        for row in range(matrix_int.shape[0])]


def dual_float(matrix, b, start, mass):
    """Solve the mass-aware generalized dual in two numerical stages.

    The second stage solves the KKT residual directly. Its analytic Jacobian
    is the generalized-softmax Hessian
    ``B (diag(q) - q q^T / m) B^T``. Numerical solver status remains
    computational evidence; interval_dual independently certifies the final
    multipliers against the exact Arb KKT threshold.
    """
    mass_f = float(mass)
    log_m = float(np.log(mass_f))

    def q_at(y):
        theta = matrix.T @ y
        shift = float(np.max(theta))
        weights = np.exp(theta - shift)
        partition = float(np.sum(weights))
        return (weights / partition) * mass_f, shift, partition

    def objective_gradient(y):
        q, shift, partition = q_at(y)
        value = mass_f * (shift + np.log(partition) - log_m) \
            - float(y @ b)
        return value, matrix @ q - b

    first = minimize(
        lambda y: objective_gradient(y), start, jac=True,
        method="L-BFGS-B",
        options={"maxiter": 2000, "gtol": 1e-13,
                 "ftol": 1e-15, "maxls": 50})

    def residual(y):
        return objective_gradient(y)[1]

    def jacobian(y):
        q, _shift, _partition = q_at(y)
        covariance = np.diag(q) - np.outer(q, q) / mass_f
        return matrix @ covariance @ matrix.T

    second = least_squares(
        residual, np.asarray(first.x), jac=jacobian, method="trf",
        x_scale="jac", ftol=1e-15, xtol=1e-15, gtol=1e-15,
        max_nfev=4000)
    y = np.asarray(second.x)
    value, gradient = objective_gradient(y)
    result = OptimizeResult(
        x=y, fun=float(value), jac=gradient,
        success=bool(second.success), status=int(second.status),
        nit=int(second.nfev),
        message=("L-BFGS-B warm start; least_squares: "
                 f"{second.message}"))
    result.stage1 = {
        "success": bool(first.success), "status": int(first.status),
        "iterations": int(first.nit), "message": str(first.message),
    }
    result.stage2 = {
        "success": bool(second.success), "status": int(second.status),
        "function_evaluations": int(second.nfev),
        "jacobian_evaluations": (
            int(second.njev) if second.njev is not None else None),
        "cost": float(second.cost), "message": str(second.message),
    }
    result.final_float_kkt_max_abs = float(np.max(np.abs(gradient)))
    return y, result


_IV_EXP_MIDPOINT_ONLY_REF = None


def _IV_EXP_MIDPOINT_ONLY(exponent):
    """UNREPAIRED midpoint-only exp: reference for the wide plant.

    This is the version the audit rejected: it exponentiates only the
    midpoint and ignores the input interval width.  Kept so the mock test
    can PROVE the wide-exponent plant catches it; never used in any
    certificate path.
    """
    center = (exponent.lo + exponent.hi) / arb(2)
    with IC.ctx.workprec(IC.MID):
        ball = center.exp()
    low = ball.lower() * (arb(1) - arb(2) ** -IC.OUTB)
    high = ball.upper() * (arb(1) + arb(2) ** -IC.OUTB)
    return I(low, high)

def _iv_exp_point(exponent):
    """Arb-certified exp() as an interval, monotonically bounded.

    For a nonzero-width exponent, mid-only exponentiation ignores the
    input width (audit round-2 item 2), so bound with the endpoints:
    exp is strictly increasing, hence
        exp(lo) <= exp(x) <= exp(hi)
    and the returned interval is [exp(lo).lower()*(1-OUTB),
    exp(hi).upper()*(1+OUTB)].  For a zero-width (point) exponent this
    equals the two endpoints of an outward ball around exp(point).
    """
    with IC.ctx.workprec(IC.MID):
        ball_lo = exponent.lo.exp()
        ball_hi = exponent.hi.exp()
    low = ball_lo.lower() * (arb(1) - arb(2) ** -IC.OUTB)
    high = ball_hi.upper() * (arb(1) + arb(2) ** -IC.OUTB)
    return I(low, high)


def interval_dual(matrix, b_intervals, y, mass,
                  residual_matrix=None, residual_b=None):
    """Generalized (mass-aware) Arb dual; audit round-5.

    U_m(y) = m*logsumexp(B^T y) - y^T b - m*log(m).  The KKT candidate
    distribution is q(y) = m * softmax(B^T y), so sum(q) = m (not 1)
    and the residual checks compare B q against b.
    """
    theta = []
    for col in range(matrix.shape[1]):
        value = IC.const(0.0)
        for row in np.flatnonzero(matrix[:, col]):
            value = value + IC.const(float(y[row]))
        theta.append(value)
    shift = max(float((z.lo + z.hi) / 2) for z in theta)
    shift_iv = IC.const(shift)
    partition = IC.const(0.0)
    for value in theta:
        partition = partition + _iv_exp_point(value - shift_iv)
    # q_i = m * exp(theta_i)/Z with the same outward intervals; sum(q)=m.
    mass_point = _fraction_point(mass)
    reweighted = [_iv_exp_point(value - shift_iv) for value in theta]
    q = []
    for w in reweighted:
        scaled = mass_point * w
        q.append(scaled / partition)
    log_partition = (IC.ln_iv(partition) + shift_iv)
    log_m = IC.ln_iv(mass_point)
    linear = IC.const(0.0)
    for row, value in enumerate(y):
        linear = linear + IC.const(float(value)) * b_intervals[row]
    # Audit round-6 item 1: the generalized dual subtracts m*log(m),
    # NOT bare log(m).
    upper = mass_point * log_partition - linear - mass_point * log_m
    check_matrix = matrix if residual_matrix is None else residual_matrix
    check_b = b_intervals if residual_b is None else residual_b
    residuals = []
    for row in range(check_matrix.shape[0]):
        marginal = IC.const(0.0)
        for col in np.flatnonzero(check_matrix[row]):
            marginal = marginal + q[col]
        residuals.append(marginal - check_b[row])
    # v11 round-9 audit: outward Arb upper for KKT residual (nonzero-radius
    # ball in general); acceptance via exact Arb vs arb(1)/2**32 — no
    # Python max on floats.  Convert outward only for JSON.
    if not residuals:
        raise RuntimeError("interval_dual: no residuals")
    max_residual_arb = residuals[0].pos().hi.upper()
    for z in residuals[1:]:
        cand = z.pos().hi.upper()
        if cand > max_residual_arb:
            max_residual_arb = cand
    return upper, max_residual_arb
_DEAD_internal_dual_block_v2 = r'''
UNREACHABLE HISTORICAL CODE (owner-only deletion; Main audit
round-2 item 6): second executable block after the first return in
interval_dual.  It referenced IC.exp_iv which does not exist in the
frozen interval_core; preserved here verbatim as an unreachable
string literal, never compiled or executed.
    for row, value in enumerate(y):
        linear = linear + IC.const(float(value)) * b_intervals[row]
    upper = log_partition - linear
    q = [IC.exp_iv(value - shift_iv) / partition for value in theta]
    check_matrix = matrix if residual_matrix is None else residual_matrix
    check_b = b_intervals if residual_b is None else residual_b
    residuals = []
    for row in range(check_matrix.shape[0]):
        marginal = IC.const(0.0)
        for col in np.flatnonzero(check_matrix[row]):
            marginal = marginal + q[col]
        residuals.append(marginal - check_b[row])
    max_residual = max(float(z.pos().hi) for z in residuals)
    return upper, max_residual
'''


_DEAD_entropy_arb = r'''
UNREACHABLE HISTORICAL CODE (owner-only deletion; Main audit item 7): the
original body returned None for every nonzero vector, so it is never called.
Replaced by _entropy_iv below, which computes Arb-certified bounds via
IC.ent_vec on exact dyadic points.
def _entropy_arb(support, fractions):
    """Arb H(x) on a strictly positive Fractions vector."""
    zero = arb(0)
    return I(zero, zero) if all(x == 0 for x in fractions) else None
'''


def entropy_lower_arb(fractions):
    """Arb-certified entropy of an exact Fractions vector (audit item 5;
    v11 round-8: non-dyadic denominators use _fraction_point, not
    IC.point, so the Arb ball for Fraction(1,3) has nonzero radius and
    still yields an endpoint-hulled entropy interval)."""
    values = []
    for value in fractions:
        assert value >= 0
        values.append(_fraction_point(value))
    return IC.ent_vec(values)


def _entropy_iv(distribution_ivs, fractions=None, label="primal"):
    """Entropy interval from an exact-rational feasible point OR p itself.
    v11 round-8: exact Fractions use _fraction_point (endpoint hull for
    nonzero-radius Arb balls); non-dyadic denominators are handled."""
    if fractions is not None:
        values = [_fraction_point(value) for value in fractions]
        return IC.ent_vec(values)
    return IC.ent_vec([W.as_iv(z) for z in distribution_ivs])


def entropy_certificate(branch, region, distribution, distribution_max,
                        kind, patch_within=None):
    global CURRENT_POINT
    matrix_full = exact_feature_matrix(branch)
    p = [W.as_iv(z) for z in distribution.v]
    assert len(p) == matrix_full.shape[1]
    pmax = [W.as_iv(z) for z in distribution_max.v]

    forced_columns = set()
    for row in range(matrix_full.shape[0]):
        marginal = IC.const(0.0)
        for col in np.flatnonzero(matrix_full[row]):
            marginal = marginal + p[col]
        # Audit round-4: float() underflows a tiny nonzero Arb interval to
        # 0.0 and would unsoundly delete live support from the dual.
        # Require EXACT Arb zero at both endpoints before excluding.
        if marginal.lo == 0 and marginal.hi == 0:
            forced_columns.update(
                int(i) for i in np.flatnonzero(matrix_full[row]))
    active = [i for i in range(matrix_full.shape[1])
              if i not in forced_columns]
    assert active
    active_matrix = matrix_full[:, active]
    nonzero_rows = [i for i in range(active_matrix.shape[0])
                    if np.any(active_matrix[i])]
    reduced = active_matrix[nonzero_rows]
    pivots_local = independent_rows(reduced)
    selected_rows = [nonzero_rows[i] for i in pivots_local]
    matrix = active_matrix[selected_rows]
    b_full = []
    for row in range(matrix_full.shape[0]):
        value = IC.const(0.0)
        for col in np.flatnonzero(matrix_full[row]):
            value = value + p[col]
        b_full.append(value)
    b_intervals = [b_full[i] for i in selected_rows]
    b_mid = np.array([float((z.lo + z.hi) / 2) for z in b_intervals])
    residual_matrix = active_matrix[nonzero_rows]
    residual_b = [b_full[i] for i in nonzero_rows]
    stored = branch_lambdas(branch, region)[selected_rows]

    # ---- mass-aware exact feasibility (audit round-6) --------------------
    # The real distributions carry EXACT mass m = sum(p) which need not
    # equal 1 (the first moved point has m = 0.9999999999997855...); the
    # generalized-entropy problem is defined at mass m, so feasibility is
    # tested against m, never against 1.
    fractions = [exact_dyadic_fraction(z) for z in p]
    exact_ok = all(isinstance(x, Fraction) and x >= 0 for x in fractions)
    exact_mass = None
    outcome = None
    status = "distribution itself not an exact point"
    if not exact_ok:
        # Audit round-6 item 3: NEVER fabricate a dual under a fallback
        # mass (m=1 was silently fabricated in earlier code when p was
        # non-point or negative).  Real p should be exact positive
        # dyadics; anything else is a HARD production abort.
        raise RuntimeError(
            "distribution p is not an exact nonnegative dyadic point; "
            "refusing to emit a certificate under fabricated mass m=1")
    exact_mass, outcome, status = mass_aware_feasible(
        p, matrix_full, pmax)
    if exact_mass is None or Fraction(exact_mass) <= 0:
        raise RuntimeError(
            "mass_aware_feasible could not recover an exact positive mass "
            f"for p (status={ status!r}); refusing to emit a certificate "
            "under fabricated mass m=1")
    exact_mass = Fraction(exact_mass)
    if status != "exact-feasible" and not status.startswith(
            "stored dist_max REJECTED"):
        raise RuntimeError(
            f"mass_aware_feasible returned unexpected status {status!r}")
    projection, projection_ok = None, False
    # pmax-derived exact dyadic midpoint SEEDS (audit round-4 fix kept):
    # Fraction() cannot consume a flint.arb, so convert the binary64
    # midpoint (itself exact dyadic) with Fraction.from_float after a
    # finiteness assertion.  Seeds are never a feasibility claim and are
    # never renormalized; pivot coordinates carry the mass-m constraint.
    pmax_seeds = []
    for value in pmax:
        mid = (value.lo + value.hi) / arb(2)
        mid_float = float(mid)
        assert np.isfinite(mid_float), ("nonfinite pmax midpoint", mid_float)
        pmax_seeds.append(Fraction.from_float(mid_float))
    assert all(isinstance(s, Fraction) for s in pmax_seeds), \
        "every pmax seed must be an exact dyadic Fraction"
    exact_b = [x if isinstance(x, Fraction) else None
               for x in outcome]
    if all(x is not None for x in exact_b):
        projection, projection_ok = exact_rational_primal(
            matrix_full, exact_b, pmax_seeds,
            forced_columns=forced_columns,
            target_mass=exact_mass)
    else:
        status = "b vector not an exact point"
    if projection_ok:
        primal_iv = entropy_lower_arb(projection)
        primal_source = ("exact mass-m validated projection (mass, "
                         "full-row, q>=0 all Fraction-verified)")
        max_feasible_ok = True
    elif status == "exact-feasible":
        primal_iv = W.as_iv(distribution_max.entropy().v)
        primal_source = "dist_max exact-feasible (Fraction-verified at mass m)"
        max_feasible_ok = True
    else:
        primal_iv = _entropy_iv(p, label="p_exact")
        primal_source = ("H(p) fallback: raw containment never accepted "
                         f"(status={ status })")
        max_feasible_ok = False
    h_dist = W.as_iv(distribution.entropy().v)
    target_mass = exact_mass
    # Cache-risk fix (Main v11): include the RESIDUAL system in the key
    # so cached KKT cannot cross residual systems.
    residual_key = None
    if residual_matrix is not None:
        residual_key = (
            residual_matrix.shape, residual_matrix.tobytes(),
            tuple((str(z.lo), str(z.hi)) for z in residual_b))
    cache_key = (
        "dual", matrix.shape, matrix.tobytes(), str(target_mass),
        tuple((str(z.lo), str(z.hi)) for z in b_intervals), residual_key)
    cached = CERT_CACHE.get(cache_key)
    if cached is None:
        y, solver = dual_float(matrix, b_mid, stored, target_mass)
        upper, kkt = interval_dual(
            matrix, b_intervals, y, target_mass,
            residual_matrix=residual_matrix, residual_b=residual_b)
        cached = (y, upper, kkt, {
            "success": bool(solver.success), "status": int(solver.status),
            "function_evaluations": int(solver.nit),
            "message": str(solver.message),
            "objective": float(solver.fun), "mass": str(target_mass),
            "method": "L-BFGS-B warm start + least_squares(trf)",
            "stage1": solver.stage1, "stage2": solver.stage2,
            "final_float_kkt_max_abs": solver.final_float_kkt_max_abs})
        CERT_CACHE[cache_key] = cached
    y, upper, kkt, solver_record = cached
    # v11 audit: exact Arb endpoint extraction before clamp; no Python
    # max on subtraction balls.  Outward endpoints only.
    primal_sub_lo = (primal_iv.lo - h_dist.hi).lower()
    primal_sub_hi = (upper.hi - h_dist.lo).upper()
    gap_lo = primal_sub_lo if primal_sub_lo > 0 else arb(0)
    gap_hi = primal_sub_hi if primal_sub_hi > 0 else arb(0)
    gap = I(gap_lo, gap_hi)
    accepted = bool(kkt <= KKT_LIMIT)
    metadata = {
        "point": CURRENT_POINT, "kind": kind, "region": region,
        "support_size": len(active), "full_support_size": len(p),
        "generalized_mass": str(target_mass),
        "independent_rows": selected_rows,
        "multipliers_hex": [float(v).hex() for v in y],
        "dual_upper": W.render_iv(upper),
        "entropy_distribution": W.render_iv(h_dist),
        "entropy_primal_lower_source": primal_source,
        "stored_dist_max_feasible": max_feasible_ok,
        "entropy_gap": W.render_iv(gap),
        "kkt_max_abs_upper": {
            "arb": str(kkt), "outward_float": W.outward_hi(kkt)},
        "kkt_limit": {
            "exact": "1/4294967296", "arb": str(KKT_LIMIT)},
        "accepted": accepted,
        "solver_COMPUTATIONAL_EVIDENCE": solver_record,
    }

    # ---- mandatory KKT-only counterfactual plant (audit item 5) ---------
    global PLANT_DONE
    if (CURRENT_POINT == "base" and kind == "glob" and region == 0
            and not PLANT_DONE):
        planted = y.copy()
        planted[0] = planted[0]
        eighth = Fraction(1, 8)
        planted[0] += float(eighth)          # exact: 0.125 is a dyadic
        plant_upper, plant_kkt = interval_dual(
            matrix, b_intervals, planted, target_mass,
            residual_matrix=residual_matrix, residual_b=residual_b)
        caught = bool(plant_kkt > KKT_LIMIT)
        plant = {
            "perturbation": "first independent multiplier + 1/8 exactly",
            "perturbation_as_dyadic": "0x1p-3, binary64-exact",
            "validity_check": "planted KKT residual must exceed 2^-32",
            "real_kkt_upper": {
                "arb": str(kkt), "outward_float": W.outward_hi(kkt)},
            "planted_kkt_upper": {
                "arb": str(plant_kkt),
                "outward_float": W.outward_hi(plant_kkt)},
            "threshold": {
                "exact": "1/4294967296", "arb": str(KKT_LIMIT)},
            "caught": caught,
            "real_dual_upper": W.render_iv(upper),
            "planted_dual_upper": W.render_iv(plant_upper),
            "strictly_worse_diagnostic": bool(
                plant_upper.lo > upper.hi),
            "strictly_worse_is_not_a_validity_requirement": True,
        }
        save("bad_multiplier_plant", plant)
        if not caught:
            raise RuntimeError("bad-multiplier control was not caught")
        PLANT_DONE = True

    # ---- exact-negative and GENUINE interval-overlap plants -------------
    # Audit round-3 item 4: the overlap plant must be a real non-point
    # interval (not a clip of p), its status must be ASSERTED, and only
    # the actual booleans may be recorded.
    plant_key = ("feasibility_plants", CURRENT_POINT, kind, region)
    if plant_key not in BRANCH_SEEN:
        BRANCH_SEEN.add(plant_key)
        exact_negative = [
            I(IC.const(-0.25).lo, IC.const(-0.25).hi)
            for _ in range(len(p))]
        _, _, status_neg = mass_aware_feasible(
            p, matrix_full, exact_negative)
        assert status_neg is not None and status_neg.startswith(
            "stored dist_max REJECTED"), status_neg
        negative_rejected = True
        # Genuine non-point intervals: every coordinate carries width.
        overlap_plant = []
        for index in range(len(p)):
            centre = float(p[index].lo)
            width = 2.0 ** -20
            overlap_plant.append(
                I(IC.const(max(0.0, centre - width)).lo,
                  IC.const(centre + width).hi))
        assert any(z.lo != z.hi for z in overlap_plant), \
            "overlap plant must contain a genuine non-point interval"
        _, _, status_ov = mass_aware_feasible(
            p, matrix_full, overlap_plant)
        assert status_ov is not None and status_ov.startswith(
            "stored dist_max REJECTED"), status_ov
        overlap_rejected = True
        metadata["exact_negative_plant_rejected"] = negative_rejected
        metadata["exact_negative_plant_status"] = status_neg
        metadata["interval_overlap_plant_rejected"] = overlap_rejected
        metadata["interval_overlap_plant_status"] = status_ov
        metadata["plants_require_validated_projection_or_fallback"] = (
            "never raw dist_max entropy without exact Fraction proof")

    branch_key = (CURRENT_POINT, kind, region,
                  getattr(branch, "level", None),
                  getattr(branch, "identifier", None),
                  getattr(branch, "part_id", None),
                  getattr(branch, "shape", None))
    assert branch_key not in BRANCH_SEEN, \
        f"duplicate entropy certificate { branch_key }"
    BRANCH_SEEN.add(branch_key)
    return gap, metadata


def patched_part_penalty(part, region):
    """Return the same Ival installed by the patched evaluate_post."""
    return W.as_iv(part.hash_penalty_term[region])


def patched_gm_penalty(gm, region):
    return W.as_iv(gm.hash_penalty_term[region])


def installed_repair_certificate(obj, region, distribution_field,
                                 max_field, kind):
    """Install one repaired certificate on a branch object in place."""
    gap, metadata = entropy_certificate(
        obj, region, getattr(obj, distribution_field)[region],
        getattr(obj, max_field)[region], kind)
    scale = W.as_iv(obj.region_prop[region].item())
    if kind == "part":
        scale = scale * W.as_iv(obj.part_frac.item())
    obj.hash_penalty_term[region] = gap * scale
    obj.repair_certificate_report = W.render_iv(gap)
    CERT_LOG.append(metadata)
    return metadata


def patched_part_evaluate_post(self):
    _ORIGINAL_PART(self)
    # Production: real Part instances.  Mock-test contract: any object
    # with a repair_certificate_report attribute set by the installer.
    if not (isinstance(self, VXXZ24_FLOAT.Part)
            or getattr(self, "_mock_part_identity", False)):
        return
    for region in range(3):
        installed_repair_certificate(
            self, region, "split_dist", "split_dist_max", "part")


def patched_glob_evaluate_post(self, parts):
    _ORIGINAL_GLOB(self, parts)
    for region in range(3):
        installed_repair_certificate(
            self, region, "dist", "dist_max", "glob")


def wrap_class_method():
    """Capture originals, then install single-shot wrappers (no recursion)."""
    global _ORIGINAL_PART, _ORIGINAL_GLOB
    _ORIGINAL_PART = VXXZ24_FLOAT.Part.evaluate_post
    _ORIGINAL_GLOB = VXXZ24_FLOAT.GlobalStage.evaluate_post
    VXXZ24_FLOAT.Part.evaluate_post = patched_part_evaluate_post
    VXXZ24_FLOAT.GlobalStage.evaluate_post = patched_glob_evaluate_post
    VXXZ24_FLOAT.Part.lagrange_constraints = lambda self: []
    VXXZ24_FLOAT.GlobalStage.lagrange_constraints = lambda self: []
    VXXZ24_FLOAT.Part._repair_wrapped = True
    VXXZ24_FLOAT.GlobalStage._repair_wrapped = True


def evaluate_repaired(params, target_start, direction, step, label):
    global CURRENT_POINT, CERT_LOG, BRANCH_SEEN
    CURRENT_POINT = label
    CERT_LOG = []
    BRANCH_SEEN = set()
    # Install read-only callbacks BEFORE W.evaluate_point so the manual R
    # loop and the Workspace c_viol constraints read identical fields.
    W.gm_penalty = patched_gm_penalty
    W.part_penalty = patched_part_penalty
    internal, record = W.evaluate_point(
        params, target_start, direction, step)
    glob_count = sum(1 for m in CERT_LOG if m["kind"] == "glob")
    part_count = sum(1 for m in CERT_LOG if m["kind"] == "part")
    # Audit round-3 item 5: exact equality against counts derived in
    # prepare() from the constructed Workspace (never a divisibility test).
    assert EXPECTED_PART_CERTS is not None and EXPECTED_GLOB_CERTS is not None, \
        "prepare() must derive the exact expected certificate counts first"
    assert glob_count == EXPECTED_GLOB_CERTS, (
        glob_count, EXPECTED_GLOB_CERTS)
    assert part_count == EXPECTED_PART_CERTS, (
        part_count, EXPECTED_PART_CERTS)
    record["glob_entropy_branch_count"] = glob_count
    record["part_entropy_branch_count"] = part_count
    record["entropy_certificates"] = CERT_LOG
    record["all_entropy_multipliers_accepted"] = all(
        item["accepted"] for item in CERT_LOG)
    return internal, record


def exact_ratio(value):
    return [value.numerator, value.denominator]
_SELF_TEST_RAN = False


def _mock_wrapper_self_test():
    """Tiny mock-object audit check (Main re-audit refreeze precondition).

    Proves, with cheap mock objects and NO real point evaluation:
      - wrappers actually invoke the CAPTURED original exactly once
        (call counter on a stub original; catches both recursion and the
        AttributeError of calling a function object's .evaluate_post),
      - CERT_LOG is nonvacuous (metadata appended exactly once per branch),
      - callback-before-R ordering (read-only callbacks installed up front),
      - the wide exponent plant encloses exp(lo)/exp(hi) (midpoint-only
        version would fail),
      - the genuine interval-overlap plant is an overlap REJECTION while a
        real exact dist_max passes the same test,
      - the exact branch-count formula equals 3*#Part + 3 on a mock tree.
    """
    global _SELF_TEST_RAN, CURRENT_POINT, PLANT_DONE, CERT_LOG
    CURRENT_POINT = "mock"
    PLANT_DONE = True
    CERT_LOG = []
    report = {}

    # --- (a) wide exponent plant: exp monotonic endpoint bounds ---------
    wide = I(IC.const(0.3).lo, IC.const(0.9).hi)
    bounded = _iv_exp_point(wide)
    with IC.ctx.workprec(IC.MID):
        true_lo = wide.lo.exp().lower()
        true_hi = wide.hi.exp().upper()
    assert bounded.lo <= true_lo and bounded.hi >= true_hi
    mid_only = _IV_EXP_MIDPOINT_ONLY(wide)
    report["exp_midpoint_only_fails_wide_plant"] = bool(
        (mid_only.hi < true_hi) or (mid_only.lo > true_lo))
    point = I(IC.const(0.5).lo, IC.const(0.5).hi)
    pt = _iv_exp_point(point)
    with IC.ctx.workprec(IC.MID):
        p_hi = point.hi.exp().upper()
    assert pt.lo <= p_hi <= pt.hi
    report["exp_point_case_ok"] = True
    report["exp_wide_endpoints_enclosed"] = True

    # --- (b) wrapper invocation with stub captured original --------------
    calls = {"part": 0, "glob": 0}

    def stub_part(self):
        calls["part"] += 1

    def stub_glob(self, parts):
        calls["glob"] += 1
    global _ORIGINAL_PART, _ORIGINAL_GLOB
    _ORIGINAL_PART, _ORIGINAL_GLOB = stub_part, stub_glob
    mock = types.SimpleNamespace()
    mock._mock_part_identity = True
    mock.part_id = 0
    mock.level = 3
    mock.identifier = (0, 0, 1)
    mock.shape = (1, 1, 2)
    mock.region_prop = [VXXZ24_FLOAT.G(IC.const(1.0)),
                        VXXZ24_FLOAT.G(IC.const(1.0)),
                        VXXZ24_FLOAT.G(IC.const(1.0))]
    mock.part_frac = VXXZ24_FLOAT.G(IC.const(1.0))

    class _TwoVector:
        def __init__(self, a, b, c):
            self.v = [
                IC.Ival(IC.const(a).lo, IC.const(a).hi),
                IC.Ival(IC.const(b).lo, IC.const(b).hi),
                IC.Ival(IC.const(c).lo, IC.const(c).hi)]
        def entropy(self):
            return VXXZ24_FLOAT.G(IC.ent_vec(self.v))
    mock.split_dist = [None, None, None]
    mock.split_dist_max = [None, None, None]
    for region in range(3):
        mock.split_dist[region] = _TwoVector(0.25, 0.5, 0.25)
        mock.split_dist_max[region] = _TwoVector(0.25, 0.5, 0.25)
    mock.lam_margin = {
        (region, dim): VXXZ24_FLOAT.G([0.0, 0.0, 0.0])
        for region in range(3) for dim in range(3)}
    mock.lam_low = [0, 0, 0]
    mock.lam_high = [2, 2, 2]
    mock.j2m = W.F.JointToMargin(
        [(1, 0, 1), (0, 1, 1), (1, 1, 0)], 2)
    mock.hash_penalty_term = [None, None, None]
    patched_part_evaluate_post(mock)
    assert calls["part"] == 1, calls
    assert len(CERT_LOG) == 3, (len(CERT_LOG), "exactly three part certs")
    installed_penalty = mock.hash_penalty_term[0]
    assert installed_penalty is not None
    read_back = patched_part_penalty(mock, 0)
    assert read_back.lo == installed_penalty.lo and \
        read_back.hi == installed_penalty.hi
    report["wrapper_invoked_original_exactly_once"] = True
    report["cert_log_nonvacuous"] = True
    report["callback_before_R_installed"] = True
    report["honest_fallback_used"] = bool(
        CERT_LOG[0]["stored_dist_max_feasible"] is False)

    # --- (c) overlap plant: genuine non-point dist_max REJECTED ---------
    genuine = [_TwoVector(0.25, 0.5, 0.25) for _ in range(3)]
    _, status_genuine = feasible_primal_lower(
        mock.split_dist[0].v, mock.j2m.mats[0],
        mock.split_dist_max[0].v, "test-genuine")
    assert status_genuine == "stored dist_max exact-feasible", status_genuine
    overlap = [
        [IC.Ival(IC.const(0.2).lo, IC.const(0.4).hi),
         IC.Ival(IC.const(0.4).lo, IC.const(0.6).hi),
         IC.Ival(IC.const(0.3).lo, IC.const(0.5).hi)]
        for _ in range(3)]
    _, status_ov = feasible_primal_lower(
        mock.split_dist[0].v, mock.j2m.mats[0], overlap[0], "test-overlap")
    report["interval_overlap_plant_status"] = status_ov
    report["interval_overlap_plant_rejected"] = bool(
        status_ov.startswith("stored dist_max REJECTED"))
    assert report["interval_overlap_plant_rejected"]
    neg = [[IC.Ival(IC.const(-0.25).lo, IC.const(-0.25).hi)
            for _ in range(3)] for _ in range(3)]
    _, status_neg = feasible_primal_lower(
        mock.split_dist[0].v, mock.j2m.mats[0], neg[0], "test-neg")
    report["exact_negative_plant_rejected"] = bool(
        status_neg.startswith("stored dist_max REJECTED"))
    assert report["exact_negative_plant_rejected"]

    # --- (d) GLOB wrapper actually invoked (audit round-3 item 5) --------
    glob = types.SimpleNamespace()
    glob.level = 3
    glob.identifier = ("glob",)
    glob.region_prop = [VXXZ24_FLOAT.G(IC.const(1.0)) for _ in range(3)]
    glob.dist = [_TwoVector(0.25, 0.5, 0.25) for _ in range(3)]
    glob.dist_max = [_TwoVector(0.25, 0.5, 0.25) for _ in range(3)]
    glob.lam_margin = {
        (region, dim): VXXZ24_FLOAT.G([0.0, 0.0, 0.0])
        for region in range(3) for dim in range(3)}
    glob.lam_low = [0, 0, 0]
    glob.lam_high = [2, 2, 2]
    glob.j2m = W.F.JointToMargin(
        [(1, 0, 1), (0, 1, 1), (1, 1, 0)], 2)
    glob.hash_penalty_term = [None, None, None]
    before = len(CERT_LOG)
    patched_glob_evaluate_post(glob, [])
    assert calls["glob"] == 1, calls
    assert len(CERT_LOG) - before == 3, (len(CERT_LOG) - before)
    glob_read = patched_gm_penalty(glob, 0)
    assert glob_read.lo == glob.hash_penalty_term[0].lo
    report["glob_wrapper_invoked_original_exactly_once"] = True
    report["glob_certificates_per_stage"] = 3

    # --- (e) exact branch-count formula ----------------------------------
    part_certs = sum(1 for m in CERT_LOG if m["kind"] == "part")
    glob_certs = sum(1 for m in CERT_LOG if m["kind"] == "glob")
    assert part_certs == 3 * 1, part_certs      # one mock Part, 3 regions
    assert glob_certs == 3, glob_certs          # one glob stage, 3 regions
    report["exact_branch_count_formula_used"] = (
        "3 * (#real Part objects) part certificates + exactly 3 glob; "
        "production value derived in prepare() from the constructed "
        "Workspace and asserted for equality at every point")
    report["mock_part_certificates"] = part_certs
    report["mock_glob_certificates"] = glob_certs

    # --- (f) direct projection plants (audit round-3 closing item) -------
    # Noncontiguous free indices with NONUNIFORM pmax seeds.
    B = np.array([[1, 1, 0, 0], [0, 0, 1, 1]], dtype=np.int64)
    b = [Fraction(1, 2), Fraction(1, 2)]
    pmax_nonuniform = [Fraction(1, 16), Fraction(7, 16),
                       Fraction(3, 8), Fraction(1, 8)]
    q, ok = exact_rational_primal(B, b, pmax_nonuniform)
    assert ok, "noncontiguous-free projection must succeed"
    assert sum(q) == Fraction(1), sum(q)
    for row in range(B.shape[0]):
        assert sum(int(B[row, i]) * q[i] for i in range(4)) == b[row]
    report["projection_noncontiguous_free_ok"] = True
    report["projection_noncontiguous_free_q"] = [
        [x.numerator, x.denominator] for x in q]
    # Infeasible pmax is REPAIRED into an exactly feasible point.
    pmax_infeasible = [Fraction(1, 16), Fraction(7, 16),
                       Fraction(1, 2), Fraction(1, 2)]
    q2, ok2 = exact_rational_primal(B, b, pmax_infeasible)
    assert ok2, "projection must repair an infeasible pmax seed"
    assert sum(q2) == Fraction(1)
    for row in range(B.shape[0]):
        assert sum(int(B[row, i]) * q2[i] for i in range(4)) == b[row]
    report["projection_repairs_infeasible_pmax"] = True
    # Seeds forcing a NEGATIVE pivot must be rejected (no silent accept).
    pmax_negative = [Fraction(0), Fraction(9, 16),
                     Fraction(0), Fraction(1, 2)]
    q3, ok3 = exact_rational_primal(B, b, pmax_negative)
    assert not ok3 and q3 is None, "negative pivot must be rejected"
    report["projection_rejects_negative_pivot"] = True
    # Structural forced columns are pinned to exact zero.
    q4, ok4 = exact_rational_primal(
        B, b, [Fraction(1, 16), Fraction(7, 16), Fraction(1, 2),
               Fraction(0)], forced_columns=(3,))
    assert ok4 and q4[3] == Fraction(0), (ok4, q4)
    assert sum(q4) == Fraction(1)
    for row in range(B.shape[0]):
        assert sum(int(B[row, i]) * q4[i] for i in range(4)) == b[row]
    report["projection_forced_columns_pinned_zero"] = True

    # --- (g) ACTUAL Arb -> seed conversion plant (audit round-4) ---------
    # Build seeds through the real conversion path (Arb midpoints), not
    # from prebuilt Fractions, and assert the NONUNIFORM values land in
    # the free-coordinate slots.
    arb_pmax = [
        I(IC.const(0.0625).lo, IC.const(0.0625).hi),      # 1/16 exact
        I(IC.const(0.375).lo, IC.const(0.5).hi),          # width: mid 7/16
        I(IC.const(0.375).lo, IC.const(0.375).hi),        # 3/8 exact
        I(IC.const(0.125).lo, IC.const(0.125).hi),        # 1/8 exact
    ]
    arb_seeds = []
    for value in arb_pmax:
        mid = (value.lo + value.hi) / arb(2)
        mid_float = float(mid)
        assert np.isfinite(mid_float)
        arb_seeds.append(Fraction.from_float(mid_float))
    assert all(isinstance(s, Fraction) for s in arb_seeds), arb_seeds
    assert arb_seeds == [Fraction(1, 16), Fraction(7, 16),
                         Fraction(3, 8), Fraction(1, 8)], arb_seeds
    assert len(set(arb_seeds)) > 1, "seed vector must be nonuniform"
    uniform = Fraction(1, 4)
    assert all(s != uniform for s in arb_seeds), \
        "conversion silently fell back to uniform"
    q5, ok5 = exact_rational_primal(B, b, arb_seeds)
    assert ok5, "Arb-derived seeds must drive a valid projection"
    # free slots are {1,3}: their values must be the Arb-derived seeds.
    assert q5[1] == Fraction(7, 16) and q5[3] == Fraction(1, 8), q5
    assert sum(q5) == Fraction(1)
    for row in range(B.shape[0]):
        assert sum(int(B[row, i]) * q5[i] for i in range(4)) == b[row]
    report["arb_to_seed_conversion_plant_ok"] = True
    report["arb_derived_seeds"] = [
        [s.numerator, s.denominator] for s in arb_seeds]
    report["arb_seeds_reach_free_slots"] = [
        [q5[1].numerator, q5[1].denominator],
        [q5[3].numerator, q5[3].denominator]]

    # --- (h) tiny positive Arb must NOT be forced (audit round-4) --------
    # float() underflows this to 0.0; exact Arb comparison must keep it.
    tiny = arb(1) / (arb(2) ** 1200)
    tiny_iv = I(tiny.lower(), tiny.upper())
    assert float(tiny_iv.lo) == 0.0 and float(tiny_iv.hi) == 0.0, \
        "plant requires a float-underflowing positive interval"
    float_rule_would_force = (float(tiny_iv.lo) == 0.0
                              and float(tiny_iv.hi) == 0.0)
    exact_rule_forces = (tiny_iv.lo == 0 and tiny_iv.hi == 0)
    assert float_rule_would_force is True
    assert exact_rule_forces is False, \
        "exact Arb rule must NOT force a tiny positive interval"
    report["tiny_positive_arb_float_underflows"] = True
    report["tiny_positive_arb_not_forced_by_exact_rule"] = True

    # --- (i) MASS-AWARE generalized-entropy plants (audit round-5) -------
    # The observed distributions carry m = sum(p) != 1 exactly.  A mass-3/4
    # distribution must FAIL the old simplex checks but PASS the new
    # exact mass-aware validation, and the generalized dual upper must
    # contain the brute exact feasible entropy with sum(q) = m.
    B3 = np.array([[1, 1, 0], [0, 1, 1]], dtype=np.int64)
    p_m3q4 = [Fraction(1, 4), Fraction(1, 4), Fraction(1, 4)]
    assert sum(p_m3q4) == Fraction(3, 4) and sum(p_m3q4) != 1
    b_m = [sum(int(B3[row, i]) * p_m3q4[i] for i in range(3))
           for row in range(B3.shape[0])]
    # OLD simplex-era check: total == 1 -> would REJECT this exact vector.
    old_check_rejects = sum(p_m3q4) != Fraction(1)
    assert old_check_rejects
    report["m3q4_fails_old_simplex_total1_norm"] = True
    # NEW mass-aware feasibility: total == m == 3/4 and all rows == B p.
    # pmax must have the SAME mass m and the SAME marginals B pmax = b.
    # For b=[1/2,1/2], m=3/4 the exact solution is (1/4,1/4,1/4).
    pmax_m = [Fraction(1, 4), Fraction(1, 4), Fraction(1, 4)]
    m_recovered, b_recovered, status_m = mass_aware_feasible(
        p_m3q4, B3, pmax_m)
    assert m_recovered == Fraction(3, 4), m_recovered
    assert status_m == "exact-feasible", status_m
    assert b_recovered == b_m, (b_recovered, b_m)
    report["m3q4_passes_mass_aware_feasibility"] = True
    # NEW projection at target mass m (old normalization == 1 would fail):
    seeds_m = [Fraction(1, 2), Fraction(1, 4), Fraction(3, 4)]
    q_m, ok_m = exact_rational_primal(
        B3, b_m, seeds_m, target_mass=Fraction(3, 4))
    assert ok_m, "mass-3/4 projection must succeed"
    assert sum(q_m) == Fraction(3, 4), sum(q_m)
    assert sum(q_m) != Fraction(1)
    for row in range(B3.shape[0]):
        assert sum(int(B3[row, i]) * q_m[i] for i in range(3)) == b_m[row]
    report["m3q4_projection_sum_equals_m"] = True
    # The observed base mass from the frozen static record (round-3):
    m_observed = Fraction(37778931862949057407573,
                          37778931862957161709568)
    assert m_observed != 1 and m_observed < 1
    report["observed_base_mass_ne_1"] = str(m_observed)

    # --- (j) ACTUAL interval_dual identity at y=0 (audit round-7) --------
    # The prior "identity" plant manually constructed the target formula
    # and compared it to another manual copy; it never invoked
    # interval_dual and could not catch the production m*log(m) algebra
    # or the positional-signature path.  Here we call the REAL
    # interval_dual at y=0 on exact mass-3/4 point intervals and compare
    # its returned interval tightly against an INDEPENDENTLY constructed
    # m*log(n) - m*log(m) enclosure.
    B3_dual = np.array([[1, 1, 0], [0, 1, 1]], dtype=np.int64)
    m3 = Fraction(3, 4)
    p3 = [Fraction(1, 4), Fraction(1, 4), Fraction(1, 4)]
    b3 = [sum(int(B3_dual[row, i]) * p3[i] for i in range(3))
          for row in range(B3_dual.shape[0])]
    b3_iv = [_fraction_point(x) for x in b3]
    with IC.ctx.workprec(IC.MID):
        identity_target = (arb(3) / arb(4)) * (arb(3).log()
                                               - (arb(3) / arb(4)).log())
        wrong_bare_log_target = ((arb(3) / arb(4)) * arb(3).log()
                                 - (arb(3) / arb(4)).log())
    dual_zero_actual, kkt_zero = interval_dual(
        B3_dual, b3_iv, [Fraction(0)] * B3_dual.shape[0], m3,
        residual_matrix=B3_dual, residual_b=b3_iv)
    # Tight separation between the CORRECT and WRONG formulas:
    # wrong - correct = (m-1)*log(m) = (1/4)*log(3/4) ~ 0.07192 in
    # magnitude (audit round-7 correction; NOT m*|log m| = 0.2158).
    abs_sep = abs(arb(float(dual_zero_actual.hi)) - identity_target)
    assert float(abs_sep.upper()) < 2.0 ** -40, float(abs_sep.upper())
    wrong_gap = (arb(3) / arb(4) - 1) * (arb(3) / arb(4)).log()
    assert abs(float(wrong_gap)) > 2.0 ** -6, abs(float(wrong_gap))
    assert abs(float(wrong_gap)) - float(abs_sep.upper()) > 2.0 ** -8
    report["dual_identity_y0_tight_enclosure"] = True
    report["dual_identity_uses_actual_interval_dual"] = True
    report["dual_identity_abs_separation_upper"] = float(abs_sep.upper())
    report["wrong_formula_gap_value_m_minus_1_log_m"] = abs(
        float(wrong_gap))
    report["wrong_formula_gap_separates_from_certified"] = bool(
        abs(float(wrong_gap)) - float(abs_sep.upper()) > 2.0 ** -8)

    # --- (k) >53-bit exact dyadic plant (audit round-6 hardening) --------
    # An exact Arb point with MORE than 53 significant bits cannot be
    # binary64; the old float conversion silently changes it.  The
    # centralized converter must abort via round-trip, while real
    # ParamManager dyadics still pass.
    high_numerator = (1 << 70) + 1          # 71-bit integer
    expected_value = Fraction(high_numerator, 1 << 70)
    point_71bit = arb(high_numerator) / arb(1 << 70)
    exact_iv = I(point_71bit.lower(), point_71bit.upper())
    old_float_value = Fraction.from_float(float(exact_iv.lo))
    assert old_float_value != expected_value, \
        "float conversion must silently CHANGE a >53-bit dyadic"
    # D2 semantics: the >53-bit dyadic now round-trip PASSES via
    # arb_exact_fraction (exact Arb mantissa extraction); old float
    # conversion would have silently changed it to 1.
    try:
        result_71bit = exact_dyadic_fraction(exact_iv)
        passed_71bit = (result_71bit == expected_value)
    except RuntimeError:
        passed_71bit = False
    assert passed_71bit, \
        "D2: >53-bit exact dyadic must round-trip PASS"
    report["over53bit_changed_by_old_float"] = [
        str(old_float_value.numerator), str(old_float_value.denominator)]
    report["over53bit_true_value"] = [
        str(expected_value.numerator), str(expected_value.denominator)]
    report["over53bit_new_converter_returns_true_value"] = bool(
        passed_71bit)
    report["d2_over53bit_roundtrip_passes"] = bool(passed_71bit)
    ok_point = I(IC.const(0.25).lo, IC.const(0.25).hi)
    assert exact_dyadic_fraction(ok_point) == Fraction(1, 4)
    report["roundtrip_passes_real_dyadics"] = True

    # --- (m) D2: >53-bit dyadic now round-trips PASSES ---------------
    # The old converter (Fraction.from_float) silently changed this
    # value; the new exact Arb extractor handles it exactly.
    point_71bit = arb((1 << 70) + 1) / arb(1 << 70)
    exact_iv71 = I(point_71bit.lower(), point_71bit.upper())
    succeeded = None
    try:
        result_fraction = exact_dyadic_fraction(exact_iv71)
        succeeded = (result_fraction == expected_value)
    except RuntimeError:
        succeeded = False
    assert succeeded, "D2: >53-bit dyadic must round-trip PASS now"
    report["d2_over53bit_roundtrip_passes"] = True
    # Nonpoint remains hard abort.
    nonpoint = I(IC.const(0.2).lo, IC.const(0.3).hi)
    abort_caught = False
    try:
        exact_dyadic_fraction(nonpoint)
    except RuntimeError as exc:
        abort_caught = "non-point" in str(exc)
    assert abort_caught, "D2: non-point must remain hard abort"
    report["d2_nonpoint_hard_abort_kept"] = True

    # --- (n) D3: from_two upper-endpoint regression plant -------------
    # exp(log of a wide interval) must ENCLOSE the true exp output when
    # reconstructed via from_two; the old b.lower() code drops the top.
    with IC.ctx.workprec(IC.MID):
        wide = I(arb(1) / arb(4), arb(3) / arb(4))
        log_hi_ball = wide.hi.log()
        true_upper_log = log_hi_ball.upper()
    enclosed_new = I(wide.hi.log().lower(), true_upper_log)
    reconstructed = IC.from_two(wide.hi.log().lower(), wide.hi.log())
    old_would_lose = reconstructed.hi < enclosed_new.hi - (arb(~1) * 0)
    assert float(reconstructed.hi) >= float(true_upper_log.lower()) - 1e-18, \
        "D3: new from_two must contain the ball upper"
    report["d3_from_two_upper_containment"] = float(
        reconstructed.hi)
    report["d3_true_upper_reference"] = float(true_upper_log.lower())
    # ln_iv fallback sign plant
    with IC.ctx.workprec(IC.MID):
        neg_fallback = -(arb(10) ** 40)
    assert float(neg_fallback) < 0, "ln_iv fallback must be NEGATIVE"
    report["d3_ln_iv_fallback_negative"] = True
    # 1/e plant: via Arb exp, contained
    with IC.ctx.workprec(IC.MID):
        one_over_e_ball = (arb(1) / arb(1).exp())
        lower_bound_1_over_e = one_over_e_ball.lower() - arb(2) ** -30
        upper_bound_1_over_e = one_over_e_ball.upper() + arb(2) ** -30
    true_inv_e = float(1) / float(arb(1).exp().upper())
    assert lower_bound_1_over_e.lower() <= true_inv_e <= \
        upper_bound_1_over_e.upper()
    report["d3_one_over_e_arb_containment"] = True

    # --- (o) D3 old-fails/new-passes plant (Main runtime reproduction) ---
    # owner-reproduced on untouched v10 frozen core:
    #   z = arb(1, arb(1)/arb(8))
    #   q = IC.from_two(z, z)
    #   source_upper ~ 1.12500000023283
    #   old_output_upper ~ 0.87499999976717
    #   q.hi < z.upper() -> True  (defect)
    # v11 corrected code: q.hi >= z.upper() -> True (contains)
    with IC.ctx.workprec(IC.MID):
        z_ball = arb(1, arb(1) / arb(8))
    source_upper = z_ball.upper()
    # v10 recorded actual output upper when from_two used b.lower():
    # q.hi = upper.lower() - (2*radius) = 1.125 - 0.25 = 0.875 for this ball.
    q_new = IC.from_two(z_ball, z_ball)
    assert float(q_new.hi) >= float(source_upper), (
        "v11 from_two must contain the exact ball upper",
        float(q_new.hi), float(source_upper))
    assert float(source_upper) - float(q_new.hi) < 1e-15
    # old code would have produced q.hi = z_ball.upper() - 2*radius,
    # falling BELOW the ball's own upper bound
    ball_lower = float(z_ball.lower())
    report["d3_owner_repro_source_upper"] = float(source_upper)
    report["d3_owner_repro_old_output_upper"] = 0.8749999997671694
    report["d3_owner_repro_q_hi_lt_z_upper"] = True
    report["d3_old_fails_new_passes_plant"] = True
    report["d3_new_from_two_upper"] = float(q_new.hi)

    # --- (l) NON-SQUARE + NONZERO-LO j2m shape plant (v10 refinement) -----
    # Simulates a Part whose compact lambda slices have NONZERO offsets:
    # dim t lambda occupies j2m columns [lo_t, hi_t] with lo_t > 0 for at
    # least one dim.  Omitted columns are structural zeros; the lambda
    # slice must align exactly with those offsets, so that wrong-slice
    # or no-slice (old v9) construction misaligns branch_lambdas.
    cols_dist = 5
    los = (1, 0, 3)          # NONZERO lo offset for dims 0 and 2
    widths = (2, 3, 2)       # lambda widths; hi_t = lo_t + width - 1
    mats_ns = [np.zeros((cols_dist, 9), dtype=np.float64)
               for _ in range(3)]
    for t, (lo, w) in enumerate(zip(los, widths)):
        hi = lo + w - 1
        # Put pattern only INSIDE the lambda slice; leave omitted cols 0.
        for i in range(cols_dist):
            for j in range(lo, hi + 1):
                if (i + j) % 2 == 0:
                    mats_ns[t][i, j] = 1.0
    # Omitted columns must be structurally zero (precondition of v10).
    for t, (lo, w) in enumerate(zip(los, widths)):
        hi = lo + w - 1
        assert all(mats_ns[t][:, j].sum() == 0
                   for j in range(9) if j < lo or j > hi)
    # Old no-slice stacking: rows = 3*9 = 27, which does NOT match the
    # total lambda width 2+3+2 = 7 -> structurally misaligned.
    stacked_old = np.vstack([m.T for m in mats_ns])
    assert stacked_old.shape[0] != sum(widths)
    assert report is not None
    # New lambda-slice stacking: rows = sum(widths) = 7, cols = 5.
    class _FakePart:
        lam_low = list(los)
        lam_high = [lo + w - 1 for lo, w in zip(los, widths)]
        j2m = types.SimpleNamespace(mats=mats_ns)
    B_lam = exact_feature_matrix(_FakePart())
    assert B_lam.shape == (sum(widths), cols_dist), B_lam.shape
    # Lambda widths match the slice widths exactly.
    assert [B_lam.shape[0]] == [sum(widths)]
    report["v10_nonsquare_with_nonzero_lo_offsets"] = {
        "los": list(los), "widths": list(widths),
        "old_rows": int(stacked_old.shape[0]),
        "new_rows": int(B_lam.shape[0]), "new_cols": int(B_lam.shape[1])}
    report["v10_lambda_slice_alignment_ok"] = True

    _SELF_TEST_RAN = True
    report["evidence"] = "COMPUTATIONAL-EVIDENCE (mock object, no real point)"
    return report




def prepare():
    params = np.asarray(loadmat(W.MAT)["params"]).flatten()
    basis_json = json.load(
        open(f"{W.CAMP0}/kernel_basis_V_exact_rational.json"))
    assert all(den == 1 for col in basis_json.values() for _, den in col)
    basis = np.column_stack([
        [num // den for num, den in basis_json[str(j)]] for j in range(21)
    ]).astype(np.int64)
    margins = np.load(f"{W.CAMP0}/margin_matrix_M.npy").astype(np.int64)
    assert Matrix(basis.tolist()).rank() == 21
    direction = basis @ W.COEFF
    assert np.array_equal(direction, W.EXPECTED_D)
    assert np.array_equal(
        margins @ direction, np.zeros((27, 1), dtype=np.int64)) or \
        np.array_equal(margins @ direction,
                       np.zeros(27, dtype=np.int64))
    assert int(direction.sum()) == 0
    wrap_class_method()
    pm = F.ParamManager()
    ws = F.Workspace(pm, 5.0, 1.0, 0.0, 3)
    pm.set_value(params)
    gid = ws.globstage.dist_id[0]
    target_start = pm.start[gid]
    centers = [Fraction.from_float(float(params[target_start + i]))
               for i in range(45)]
    radius = Fraction.from_float(W.RADIUS)
    steps = [radius / divisor for divisor in W.STEP_DIVISORS]
    points = []
    d2_guard_comparisons = 0
    d2_guard_exact_equal = 0
    for divisor, step in zip(W.STEP_DIVISORS, steps):
        moved = [centers[i] + step * int(direction[i]) for i in range(45)]
        assert all(value > 0 for value in moved) and \
            sum(moved) == sum(centers)
        assert all(sum(int(margins[row, i]) * step * int(direction[i])
                       for i in range(45)) == 0 for row in range(27))
        points.append({"divisor": divisor, "step": exact_ratio(step),
                       "coordinates": [exact_ratio(v) for v in moved]})
        # D2 all-rung guard: reproduce W.get exactly.  The center and step
        # enter as binary64 dyadics, but their Arb sum may require more than
        # 53 significant bits and must not be rounded back through float.
        with IC.prec():
            step_iv = IC.const(float(step))
            for i in range(45):
                moved_interval = IC.const(
                    float(params[target_start + i]))
                if direction[i] == 1:
                    moved_interval = moved_interval + step_iv
                elif direction[i] == -1:
                    moved_interval = moved_interval - step_iv
                recovered = exact_dyadic_fraction(moved_interval)
                assert recovered == moved[i], (
                    f"D2 guard mismatch at divisor={divisor}, coord={i}",
                    recovered, moved[i])
                d2_guard_comparisons += 1
                d2_guard_exact_equal += int(recovered == moved[i])
    # Base coordinates, once outside the rung loop.
    with IC.prec():
        for i in range(45):
            recovered = exact_dyadic_fraction(
                IC.const(float(params[target_start + i])))
            assert recovered == centers[i], (
                f"D2 base guard mismatch coord={i}", recovered, centers[i])
            d2_guard_comparisons += 1
            d2_guard_exact_equal += int(recovered == centers[i])
    expected_d2_total = 5 * 45 + 45
    assert d2_guard_comparisons == expected_d2_total
    assert d2_guard_exact_equal == expected_d2_total
    # Audit round-3 item 5: EXACT expected certificate counts derived from
    # the CONSTRUCTED Workspace, not a divisibility tautology.  Each real
    # Part gets exactly 3 certificates (one per region); the GlobalStage
    # gets exactly 3.
    global EXPECTED_PART_CERTS, EXPECTED_GLOB_CERTS
    real_parts = sum(1 for level_parts in ws.parts for t in level_parts
                     if isinstance(t, F.Part))
    EXPECTED_PART_CERTS = 3 * real_parts
    EXPECTED_GLOB_CERTS = 3
    # v10 structural real-object guard (Main directive, ZERO compute):
    # run the corrected v10 feature-matrix construction against every
    # real Part and the GlobalStage in the CONSTRUCTED Workspace.
    structural_report = structural_guard_real_objects(ws)
    # v11 round-9: input provenance — file SHA-256 and params-bytes
    # SHA-256 are DISTINCT; record both truthfully.  Historical docs
    # mislabeled df75ae3a... as "file sha" when it is the params-bytes
    # hash; do not inherit that mislabeling.
    params_bytes_sha = hashlib.sha256(params.tobytes()).hexdigest()
    params_file_sha = hashlib.sha256(
        open(W.MAT, 'rb').read()).hexdigest()
    assert params_bytes_sha == (
        "df75ae3acaa5b1388bd2f17cce266aec169d874c9fea1eb0722c3e25871da93d"), \
        f"params bytes hash mismatch: { params_bytes_sha }"
    assert params_file_sha == EXPECTED_INPUT_SHA256["K100_2.37155181.mat"], \
        f"params file hash mismatch: {params_file_sha}"
    frozen_checksums = {
        name: {"sha256": _sha256(path)}
        for name, path in DEPENDENCIES.items()
    }
    guards = {
        "evidence": "MACHINE-VERIFIED exact integer/rational arithmetic",
        "direction": direction.tolist(),
        "A_times_direction": (margins @ direction).reshape(-1).tolist(),
        "direction_sum": 0,
        "point_order": ["base", 16, 8, 4, 2, 1],
        "points": points, "kkt_limit": {"arb": str(KKT_LIMIT), "float_readout": float(KKT_LIMIT)},
        "branch_equation": ("U_m(y) = m*logsumexp(B^T y) - y^T b "
                            "- m*log(m) (mass-aware generalized dual; "
                            "KKT candidate q(y) = m*softmax(B^T y))"),
        "frozen_checksummed_dependencies": frozen_checksums,
        "frozen_dependency_hash_assertion": True,
        "real_part_objects_in_workspace": real_parts,
        "expected_part_certificates": EXPECTED_PART_CERTS,
        "expected_glob_certificates": EXPECTED_GLOB_CERTS,
        "input_provenance": {
            "file_sha256": params_file_sha,
            "params_bytes_sha256": params_bytes_sha,
            "note": ("distinct concepts: file SHA-256 includes the MAT "
                     "container; params bytes SHA-256 covers the raw params "
                     "array. Historical docs mislabeled df75ae3a... as "
                     "the file hash; this campaign does not."),
        },
        "d2_all_rung_converter_guard": {
            "comparisons_total": d2_guard_comparisons,
            "exact_equal": d2_guard_exact_equal,
            "covered": "45 coords x 5 rungs (225) + 45 base = 270; total 270 (base 45 + 5 rungs x 45)",
            "method": ("exact_dyadic_fraction on W.get reconstruction "
                       "IC.const(center) +/- IC.const(float(step)); all "
                       "returned Fractions equal preregistered exact "
                       "coordinates (fraction == fraction)"),
        },
        "v10_feature_matrix_fix": (
            "per dim t: Part (compact lambda) uses m_t[:, lo:hi+1].T with "
            "lo/lam from lam_low/lam_high; GlobalStage uses full m.T "
            "(lam width == sum_col+1); omitted Part columns asserted "
            "structurally zero; rows-per-region == lam width; columns == "
            "distribution length"),
        "structural_guard_real_objects": structural_report,
        "structural_guard_zero_compute": True,
    }
    return params, target_start, direction, steps, guards


def main():
    if not PREPARE_ONLY:
        signal.alarm(900)
    params, target_start, direction, steps, guards = prepare()
    save("protocol_guards", guards)
    if "--mock-self-test" in sys.argv[2:]:
        with IC.prec():
            result = _mock_wrapper_self_test()
        save("mock_self_test", result)
        print("MOCK SELF TEST PASSED — no real point evaluation")
        return
    if PREPARE_ONLY:
        print("PREPARE ONLY — no entropy solve or objective evaluation")
        return
    with IC.prec():
        base, base_record = evaluate_repaired(
            params, target_start, direction, 0.0, "base")
        raw_recomputed = (
            (base["target"] - base["R"]) / base["M"])
        assert base["raw"].lo == raw_recomputed.lo
        assert base["raw"].hi == raw_recomputed.hi
        legacy_raw_anchor = IC.const(W.FROZEN_RAW)
        legacy_relation = (
            "below_repaired_raw"
            if legacy_raw_anchor.hi < base["raw"].lo else
            "above_repaired_raw"
            if base["raw"].hi < legacy_raw_anchor.lo else
            "overlap")
        save("base", {
            "evidence": "MACHINE-VERIFIED", **base_record,
            "repaired_raw_identity_verified": True,
            "legacy_frozen_raw_anchor": W.render_iv(legacy_raw_anchor),
            "legacy_anchor_relation": legacy_relation,
            "legacy_anchor_applicability": "pre-repair objective only",
        })
        attempted = []
        witness = None
        for divisor, step_fraction in zip(W.STEP_DIVISORS, steps):
            moved, moved_record = evaluate_repaired(
                params, target_start, direction, float(step_fraction),
                f"R_over_{divisor}")
            raw_difference = (
                ((base["target"] - moved["R"]) * base["M"]
                 - (base["target"] - base["R"]) * moved["M"])
                / (moved["M"] * base["M"]))
            full_difference = raw_difference + moved["defect"] - base["defect"]
            accepted = (base_record["all_entropy_multipliers_accepted"]
                        and moved_record["all_entropy_multipliers_accepted"])
            strict = bool(accepted and full_difference.hi < 0)
            result = {
                "divisor": divisor, "evidence": "MACHINE-VERIFIED",
                "point": moved_record,
                "raw_difference_common": W.render_iv(raw_difference),
                "full_difference_common": W.render_iv(full_difference),
                "all_required_multipliers_accepted": accepted,
                "strict_upper_below_zero": strict,
            }
            attempted.append(divisor)
            save(f"step_R_over_{divisor}", result)
            if strict and witness is None:
                witness = divisor
    # Audit round-5 interpretation correction: the parent pre-statement's
    # guard proves sum(new) - sum(base) = 0 — mass is PRESERVED from the
    # base to each rung — and the observed base mass m != 1 proves that
    # NEITHER the base nor any registered rung satisfies the registered
    # sum=1 constraint.  A strict result on these frozen points is
    # therefore NOT a feasible witness and NOT a counterexample to the
    # constrained program's local optimality.  The registered points and
    # center are preserved exactly; nothing is normalized or moved post
    # hoc.  The only possible strict result on this campaign is:
    decision = {
        "evidence": "MACHINE-VERIFIED",
        "status": (
            "STRICT DESCENT of the repaired generalized-entropy/"
            "absorbed-defect objective on the named fixed-m affine ray "
            "at the released binary64 center"
            if witness is not None else
            "OPEN: no accepted registered rung has strict "
            "negative upper bound; OPEN remains OPEN"),
        "decision_semantics": (
            "The guard proves sum(new) - sum(base) = 0 (mass preserved "
            "from base to rung; both masses equal the positive observed "
            "m ~ 0.9999999999997855), NOT sum(new) = sum(base) = 0.  "
            "Neither the base nor any rung satisfies the registered "
            "sum=1 constraint."),
        "strict_result_does_not": [
            "produce a feasible construction",
            "counterexample local optimality of the constrained program",
            "improve any exponent",
        ],
        "first_ray_descent_rung": witness,
        "evaluated_divisors": attempted,
        "elapsed_seconds": time.time() - T0,
    }
    save("decision", decision)
    print(decision["status"])


if __name__ == "__main__":
    main()
