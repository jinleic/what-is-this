def save(key, value):
    """Atomically replace this run's checkpoint; never reuse prior evidence."""
    checkpoint[key] = value
    temp_path = OUT + ".tmp"
    with open(temp_path, "x") as fh:
        json.dump(checkpoint, fh, indent=1)
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(temp_path, OUT)
    directory_fd = os.open(os.path.dirname(OUT), os.O_RDONLY)
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)
    print("CKPT", key, json.dumps(value)[:240])
    sys.stdout.flush()


def iv_from_render(pair):
    return I(IC.const(float(pair[0])).lo, IC.const(float(pair[1])).hi)


def exact_feature_matrix(branch):
    """Correct per-region feature matrix in lambda coordinate order
    (v10; Main refinement before freeze).

    JointToMargin.mats[t] is shaped (num_distribution_entries,
    margin_width=sum_half+1).  The stored Part lambdas are COMPACT:
    lam_margin[(r,t)] has length highs[t]-lows[t]+1 (lam width), NOT the
    full j2m width.  Therefore B is built in EXACT lambda coordinate
    order by SLICING each block on [lo:hi+1] BEFORE transposing:

        for each dim t in 0,1,2:
            Part (has lam_low/lam_high): m_t[:, lo:hi+1].T
            GlobalStage (no lam_low/lam_high): m_t.T  (full width)

    then vstack t=0,1,2.  Guarantees asserted here:
      - every OMITTED Part margin column is structurally all zero;
      - each retained slice width equals that lambda vector length;
      - total B rows equal len(branch_lambdas(branch, region)) for each
        of the 3 regions (verified by the structural guard against the
        ParamManager table without touching live distributions);
      - B columns equal the distribution length.

    The GlobalStage stores full-width lambdas, so full m.T is used with
    no slicing.  v9 stacked raw blocks (no transpose, no slice) and
    crashed at the first real Part.
    """
    is_part = hasattr(branch, "lam_low") and hasattr(branch, "lam_high")
    blocks = []
    omitted_all_zero = True
    for t, m in enumerate(branch.j2m.mats):
        if is_part:
            lo = int(branch.lam_low[t])
            hi = int(branch.lam_high[t])
            omitted = [j for j in range(m.shape[1]) if j < lo or j > hi]
            if any(m[:, j].sum() != 0 for j in omitted):
                omitted_all_zero = False
            blocks.append(m[:, lo:hi + 1].T)
        else:
            blocks.append(m.T)
    assert omitted_all_zero, (
        "v10 refinement violated: an omitted Part margin column is "
        "structurally nonzero; a compact-lambda slice would lose mass")
    matrix = np.vstack(blocks)
    integer = np.asarray(matrix, dtype=np.int64)
    assert np.array_equal(matrix, integer)
    assert set(np.unique(integer)) <= {0, 1}
    return integer


def structural_guard_real_objects(ws):
    """Structural real-object guard (v10; Main directive, ZERO compute).

    For every real Part and the GlobalStage in the CONSTRUCTED Workspace,
    assert that the corrected feature matrix B satisfies:
      - B columns == registered distribution length
        (num_split for Part, n_shape for GlobalStage),
      - B rows == sum of the three margin widths,
      - entries exactly 0/1,
      - the concatenated lam_margin widths (= branch_lambdas length
        after evaluate_init) equal B rows for all 3 regions.  Widths are
        read from the ParamManager TABLE (numbers registered at
        construction), not from live Distribution objects, so this works
        before evaluate_init without any point evaluation.
    Structural shape/int read only; no evaluate_point, no entropy solve,
    no objective evaluation.
    """
    report = {"parts": [], "glob": None}
    pm = ws.pm

    def lam_widths(obj):
        widths = []
        for region in range(3):
            total = 0
            for dim in range(3):
                gid = obj.lam_margin_id[(region, dim)]
                total += pm.size[gid]
            widths.append((region, total))
        return widths
    for level_parts in ws.parts:
        for part in level_parts:
            if not isinstance(part, F.Part):
                continue
            B = exact_feature_matrix(part)
            n_expected = part.num_split
            rows_expected = sum(
                pm.size[part.lam_margin_id[(0, d)]] for d in range(3))
            assert B.shape[1] == n_expected, (B.shape, n_expected)
            assert B.shape[0] == rows_expected, (B.shape, rows_expected)
            for region, width in lam_widths(part):
                assert width == B.shape[0], (
                    region, width, B.shape[0])
            report["parts"].append({
                "part_id": part.part_id, "level": part.level,
                "shape": list(part.shape), "B_rows": int(B.shape[0]),
                "B_cols": int(B.shape[1]), "num_split": n_expected})
    gm = ws.globstage
    Bg = exact_feature_matrix(gm)
    assert Bg.shape[1] == gm.n_shape, (Bg.shape, gm.n_shape)
    rows_expected_g = sum(pm.size[gm.lam_margin_id[(0, d)]]
                          for d in range(3))
    assert Bg.shape[0] == rows_expected_g, (Bg.shape, rows_expected_g)
    for region, width in lam_widths(gm):
        assert width == Bg.shape[0], (region, width, Bg.shape[0])
    report["glob"] = {"B_rows": int(Bg.shape[0]), "B_cols": int(Bg.shape[1]),
                      "n_shape": gm.n_shape}
    report["part_count"] = len(report["parts"])
    return report


def branch_lambdas(branch, region):
    values = []
    for dim in range(3):
        values.extend(float(W.as_iv(z).lo) for z in
                      branch.lam_margin[(region, dim)].v)
    return np.asarray(values)


def independent_rows(matrix):
    key = (matrix.shape, matrix.tobytes())
    cached = CERT_CACHE.get(("rows", key))
    if cached is not None:
        return cached
    pivots = tuple(int(i) for i in Matrix(matrix.T.tolist()).rref()[1])
    assert len(pivots) == len({i for i in pivots})
    CERT_CACHE[("rows", key)] = pivots
    return pivots


# ------------------------------------------- rational feasible-point search

def feasible_primal_lower(distribution_intervals, matrix_int,
                          distribution_max_intervals, region_label):
    """Exact Fraction feasibility test on full rows (Main-audit item 2)."""
    fractions = [Fraction.from_float(float(z.lo)) if z.lo == z.hi else None
                 for z in distribution_intervals]
    if any(x is None for x in fractions):
        return None, "interval distribution is not an exact point"
    one = Fraction(1)
    if any(x < 0 for x in fractions) or sum(fractions) != one:
        return None, "distribution itself infeasible"
    b_full = [
        sum(matrix_int[row, i] * fractions[i]
            for i in np.flatnonzero(matrix_int[row]) if fractions[i] != 0)
        for row in range(matrix_int.shape[0])]
    fractions_max = [Fraction.from_float(float(z.lo))
                     if z.lo == z.hi else None
                     for z in distribution_max_intervals]
    overlap_only = any(x is None for x in fractions_max)
    negatives = [x for x in fractions_max if x is not None and x < 0]
    if overlap_only or negatives:
        return b_full, ("stored dist_max REJECTED (overlap="
                        f"{ overlap_only } negatives={ bool(negatives) })")
    total = sum(fractions_max)
    margins = [
        sum(matrix_int[row, i] * fractions_max[i]
            for i in np.flatnonzero(matrix_int[row]) if fractions_max[i] != 0)
        for row in range(matrix_int.shape[0])]
    exact_ok = (total == one) and all(
        margins[row] == b_full[row] for row in range(len(b_full)))
    if not exact_ok:
        return b_full, "stored dist_max REJECTED by exact Fraction tests"
    return b_full, "stored dist_max exact-feasible"


def exact_rational_primal(matrix_full_int, b_full_fractions,
                          pmax_seeds=None, forced_columns=(),
                          target_mass=None):
    """Audited exact near-dual primal projection (audit round-5,
    MASS-AWARE).

    Arguments
      matrix_full_int : FULL 0/1 B (all rows, all columns).
      b_full_fractions: exact Fractions target marginals per FULL row
                        (b = B p at the observed distribution).
      pmax_seeds      : exact dyadic Fraction seeds (one per column),
                        built by the caller as the midpoint of each
                        finite pmax interval.  Seeds only; never a
                        feasibility claim; never renormalized (pivot
                        coordinates carry the mass constraint).
      forced_columns  : STRUCTURAL forced-zero column set proven by zero
                        target marginals (not a pmax heuristic).
      target_mass     : exact Fraction m = sum(p).  The generalized
                        entropy objective is defined at THIS mass, not
                        at 1; normalization is sum(q) == m.  Defaults
                        to 1 only for explicit simplex-era mock plants.

    Construction: fix forced columns to exact 0; project on ACTIVE
    columns; augment with a mass-m normalization row (all ones, rhs
    m); select exact independent rows; choose an invertible pivot
    column set; assign each FREE active coordinate its pmax-derived
    seed value; solve pivot coordinates exactly over Fractions; expand
    back; validate normalization == m, EVERY full B row equality, and
    q_i >= 0 exactly.  Square/full-rank (no free columns) solves
    directly.  Returns (Fractions q, ok).
    """
    n_cols = matrix_full_int.shape[1]
    n_rows = matrix_full_int.shape[0]
    mass = Fraction(target_mass) if target_mass is not None else Fraction(1)
    forced = set(int(j) for j in forced_columns)
    active = [j for j in range(n_cols) if j not in forced]
    if not active:
        return None, False
    active_matrix = matrix_full_int[:, active]
    augmented = np.vstack([
        active_matrix,
        np.ones((1, len(active)), dtype=np.int64),
    ])
    rhs_augmented = list(b_full_fractions) + [mass]
    rows = independent_rows(augmented)
    if len(rows) < 1:
        return None, False
    selected = list(rows)
    sub = augmented[selected]
    column_rank = Matrix(sub.tolist()).rank()
    candidate_pivots = []
    for j in range(len(active)):
        trial = candidate_pivots + [j]
        if Matrix(sub[:, trial].tolist()).rank() == len(trial):
            candidate_pivots.append(j)
            if len(candidate_pivots) == column_rank:
                break
    if len(candidate_pivots) != column_rank:
        return None, False
    pivot_set = set(candidate_pivots)
    free = [j for j in range(len(active)) if j not in pivot_set]
    sub_pivot = sub[:, candidate_pivots]
    # Per-FREE-position seeds (indexed by position, not column id);
    # uniform fallback is m/n_active, not 1/n.
    seeds = []
    for position, active_index in enumerate(free):
        column = active[active_index]
        if pmax_seeds is not None and pmax_seeds[column] is not None:
            seeds.append(Fraction(pmax_seeds[column]))
        else:
            seeds.append(mass / len(active))
    rhs_pivot = []
    for row in selected:
        reduction = Fraction(0)
        for position, active_index in enumerate(free):
            reduction += int(augmented[row, active_index]) * seeds[position]
        rhs_pivot.append(rhs_augmented[row] - reduction)
    try:
        solution, _ = Matrix(sub_pivot.tolist()).gauss_jordan_solve(
            Matrix(rhs_pivot))
    except Exception:
        return None, False
    if len(solution) != len(candidate_pivots):
        return None, False
    pivot_values = [Fraction(cell) for cell in solution]
    q_active = [None] * len(active)
    for pivot_position, active_index in enumerate(candidate_pivots):
        q_active[active_index] = pivot_values[pivot_position]
    for position, active_index in enumerate(free):
        q_active[active_index] = seeds[position]
    if any(x is None for x in q_active):
        return None, False
    if sum(q_active) != mass:
        return None, False
    if any(x < 0 for x in q_active):
        return None, False
    q = [Fraction(0)] * n_cols
    for position, column in enumerate(active):
        q[column] = q_active[position]
    for row in range(n_rows):
        marginal = sum(int(matrix_full_int[row, i]) * q[i]
                       for i in range(n_cols))
        if marginal != b_full_fractions[row]:
            return None, False
    return q, True


