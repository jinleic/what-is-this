def _sha256(path):
    return hashlib.sha256(open(path, "rb").read()).hexdigest()


def _load_frozen_dependencies():
    """Load hard-hash-verified dependencies from this v12 campaign only.

    Each dependency's SHA-256 is verified against the hard-coded digest
    above before loading; a mismatch hard-aborts rather than loading a
    silently substituted file."""
    for module_name, path in DEPENDENCIES.items():
        actual = _sha256(path)
        expected = EXPECTED_DEPENDENCY_SHA256[module_name]
        if actual != expected:
            raise RuntimeError(
                f"{module_name}: SHA-256 { actual } != expected "
                f"{ expected }; refusing to load")
        spec = importlib.util.spec_from_file_location(
            module_name, path,
            loader=importlib.machinery.SourceFileLoader(module_name, path))
        module = importlib.util.module_from_spec(spec)
        sys.modules[module_name] = module
        spec.loader.exec_module(module)
    return sys.modules



