def _fraction_point(value):
    """Exact Arb point interval for a Fraction (audit round-5)."""
    numerator = Fraction(value).numerator
    denominator = Fraction(value).denominator
    point = arb(numerator) / arb(denominator)
    return I(point.lower(), point.upper())


def mass_aware_feasible(distribution_intervals, matrix_int,
                        distribution_max_intervals):
    """Exact mass-aware feasibility test (audit round-5).

    Target mass is m = sum(p) (exact Fraction, m > 0); a candidate
    certificate distribution must satisfy total == m and every full B
    row equal b = B p, with every coordinate >= 0.  The old simplex-era
    test required total == 1 and was wrong for the actual generalized
    entropy consumed by the objective.
    Returns (m, b_full, status):
      status == "exact-feasible" only when ALL checks pass exactly.
    """
    def _to_fraction(entry):
        if isinstance(entry, Fraction):
            return entry
        if hasattr(entry, "lo"):
            mid_symbol = entry.lo
            return (Fraction.from_float(float(mid_symbol))
                    if mid_symbol == entry.hi else None)
        return None
    fractions = [_to_fraction(z) for z in distribution_intervals]
    if any(x is None for x in fractions):
        return None, None, "interval distribution is not an exact point"
    zero = Fraction(0)
    m = sum(fractions)
    if m <= 0:
        return m, None, "distribution mass is not positive"
    if any(x < 0 for x in fractions):
        return m, b_full_or_none(fractions, matrix_int), \
            "distribution has a negative coordinate"
    fractions_max = [_to_fraction(z) for z in distribution_max_intervals]
    b_full = [
        sum(matrix_int[row, i] * fractions[i]
            for i in np.flatnonzero(matrix_int[row]) if fractions[i] != 0)
        for row in range(matrix_int.shape[0])]
    overlap_only = any(x is None for x in fractions_max)
    negatives = [x for x in fractions_max if x is not None and x < 0]
    if overlap_only or negatives:
        return m, b_full, ("stored dist_max REJECTED (overlap="
                           f"{ overlap_only } negatives={ bool(negatives) })")
    total_max = sum(fractions_max)
    margins = [
        sum(matrix_int[row, i] * fractions_max[i]
            for i in np.flatnonzero(matrix_int[row]) if fractions_max[i] != 0)
        for row in range(matrix_int.shape[0])]
    exact_ok = (total_max == m) and all(
        margins[row] == b_full[row] for row in range(len(b_full)))
    if not exact_ok:
        return m, b_full, "stored dist_max REJECTED by exact Fraction tests"
    return m, b_full, "exact-feasible"


def b_full_or_none(fractions, matrix_int):
    return [
        sum(matrix_int[row, i] * fractions[i]
            for i in np.flatnonzero(matrix_int[row])
            if fractions[i] != 0)
        for row in range(matrix_int.shape[0])]


def dual_float(matrix, b, start, mass):
    """Generalized dual (audit round-5): U_m(y)=m*logsumexp(B^T y)
    - y^T b - m*log(m); q(y)=m*softmax(B^T y).
    """
    mass_f = float(mass)
    log_m = float(np.log(mass_f))

    def objective_gradient(y):
        theta = matrix.T @ y
        shift = float(np.max(theta))
        weights = np.exp(theta - shift)
        partition = float(np.sum(weights))
        q = (weights / partition) * mass_f
        value = mass_f * (shift + np.log(partition) - log_m) \
            - float(y @ b)
        gradient = matrix @ q - b
        return value, gradient

    result = minimize(
        lambda y: objective_gradient(y), start, jac=True,
        method="L-BFGS-B",
        options={"maxiter": 2000, "gtol": 1e-13,
                 "ftol": 1e-15, "maxls": 50})
    return np.asarray(result.x), result


_IV_EXP_MIDPOINT_ONLY_REF = None


def _IV_EXP_MIDPOINT_ONLY(exponent):
    """UNREPAIRED midpoint-only exp: reference for the wide plant.

    This is the version the audit rejected: it exponentiates only the
    midpoint and ignores the input interval width.  Kept so the mock test
    can PROVE the wide-exponent plant catches it; never used in any
    certificate path.
    """
    center = (exponent.lo + exponent.hi) / arb(2)
    with IC.ctx.workprec(IC.MID):
        ball = center.exp()
    low = ball.lower() * (arb(1) - arb(2) ** -IC.OUTB)
    high = ball.upper() * (arb(1) + arb(2) ** -IC.OUTB)
    return I(low, high)

def _iv_exp_point(exponent):
    """Arb-certified exp() as an interval, monotonically bounded.

    For a nonzero-width exponent, mid-only exponentiation ignores the
    input width (audit round-2 item 2), so bound with the endpoints:
    exp is strictly increasing, hence
        exp(lo) <= exp(x) <= exp(hi)
    and the returned interval is [exp(lo).lower()*(1-OUTB),
    exp(hi).upper()*(1+OUTB)].  For a zero-width (point) exponent this
    equals the two endpoints of an outward ball around exp(point).
    """
    with IC.ctx.workprec(IC.MID):
        ball_lo = exponent.lo.exp()
        ball_hi = exponent.hi.exp()
    low = ball_lo.lower() * (arb(1) - arb(2) ** -IC.OUTB)
    high = ball_hi.upper() * (arb(1) + arb(2) ** -IC.OUTB)
    return I(low, high)


def interval_dual(matrix, b_intervals, y, mass,
                  residual_matrix=None, residual_b=None):
    """Generalized (mass-aware) Arb dual; audit round-5.

    U_m(y) = m*logsumexp(B^T y) - y^T b - m*log(m).  The KKT candidate
    distribution is q(y) = m * softmax(B^T y), so sum(q) = m (not 1)
    and the residual checks compare B q against b.
    """
    theta = []
    for col in range(matrix.shape[1]):
        value = IC.const(0.0)
        for row in np.flatnonzero(matrix[:, col]):
            value = value + IC.const(float(y[row]))
        theta.append(value)
    shift = max(float((z.lo + z.hi) / 2) for z in theta)
    shift_iv = IC.const(shift)
    partition = IC.const(0.0)
    for value in theta:
        partition = partition + _iv_exp_point(value - shift_iv)
    # q_i = m * exp(theta_i)/Z with the same outward intervals; sum(q)=m.
    mass_point = _fraction_point(mass)
    reweighted = [_iv_exp_point(value - shift_iv) for value in theta]
    q = []
    for w in reweighted:
        scaled = mass_point * w
        q.append(scaled / partition)
    log_partition = (IC.ln_iv(partition) + shift_iv) * mass_point
    log_m = IC.ln_iv(mass_point)
    linear = IC.const(0.0)
    for row, value in enumerate(y):
        linear = linear + IC.const(float(value)) * b_intervals[row]
    upper = log_partition - linear - log_m
    check_matrix = matrix if residual_matrix is None else residual_matrix
    check_b = b_intervals if residual_b is None else residual_b
    residuals = []
    for row in range(check_matrix.shape[0]):
        marginal = IC.const(0.0)
        for col in np.flatnonzero(check_matrix[row]):
            marginal = marginal + q[col]
        residuals.append(marginal - check_b[row])
    max_residual = max(float(z.pos().hi) for z in residuals)
    return upper, max_residual
