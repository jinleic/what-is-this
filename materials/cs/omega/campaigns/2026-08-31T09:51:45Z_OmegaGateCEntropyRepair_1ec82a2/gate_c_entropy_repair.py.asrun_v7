def _sha256(path):
    return hashlib.sha256(open(path, "rb").read()).hexdigest()


def _load_frozen_dependencies():
    """Main-audit item 1: frozen-source loading, no live omega/src imports."""
    for module_name, path in DEPENDENCIES.items():
        expected = _sha256(path)
        live = f"/Users/jinleic/jinleic-workspace/cs/omega/src/{module_name}.py"
        if module_name != "gate_c_candidate_witness_dependency" \
                and _sha256(live) != expected:
            raise RuntimeError(
                f"{module_name}: live checksum { _sha256(live) } "
                f"!= frozen { expected }")
        spec = importlib.util.spec_from_file_location(
            module_name, path,
            loader=importlib.machinery.SourceFileLoader(module_name, path))
        module = importlib.util.module_from_spec(spec)
        sys.modules[module_name] = module
        spec.loader.exec_module(module)
    return sys.modules



