@Krawczyk.krawczyk_exists : ∀ {N : ℕ} (g : (Fin N → ℝ) → Fin N → ℝ) (x₀ : Fin N → ℝ) (Y : Matrix (Fin N) (Fin N) ℝ),
  Function.Injective Y.mulVec →
    ∀ (ρ : ℝ),
      ∀ K < 1,
        Set.MapsTo (fun x => x - Y.mulVec (g x)) (Metric.closedBall x₀ ρ) (Metric.closedBall x₀ ρ) →
          LipschitzOnWith K (fun x => x - Y.mulVec (g x)) (Metric.closedBall x₀ ρ) →
            x₀ ∈ Metric.closedBall x₀ ρ → ∃ x ∈ Metric.closedBall x₀ ρ, g x = 0
@Krawczyk.krawczyk_exists_of_bounds : ∀ {N : ℕ} (g : (Fin N → ℝ) → Fin N → ℝ) (x₀ : Fin N → ℝ)
  (Y : Matrix (Fin N) (Fin N) ℝ),
  Function.Injective Y.mulVec →
    ∀ (ρ : ℝ),
      ∀ K < 1,
        Differentiable ℝ g →
          (∀ x ∈ Metric.closedBall x₀ ρ, ‖fderiv ℝ (fun z => z - Y.mulVec (g z)) x‖₊ ≤ K) →
            dist (x₀ - Y.mulVec (g x₀)) x₀ ≤ (1 - ↑K) * ρ → ∃ x ∈ Metric.closedBall x₀ ρ, g x = 0
Krawczyk.slicesRank_le_of_residual_zero : ∀ (A B C : Fin 25 → Fin 8 → ℝ),
