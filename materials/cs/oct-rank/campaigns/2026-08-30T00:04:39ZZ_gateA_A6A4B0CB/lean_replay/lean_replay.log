Krawczyk.slicesRank_le_of_residual_zero_tau : ∀ (A : Fin 7 → Fin 3 → ℝ) (B C : Fin 7 → Fin 4 → ℝ),
  (∀ (p : Fin 3) (b c : Fin 4), ∑ s, A s p * B s b * C s c = tau p b c) → IsSlicesOfRank 7 tau
@pencil_rank_ge : ∀ {n : ℕ},
  Even n →
    ∀ (C : Matrix (Fin n) (Fin n) ℝ) (a b : ℝ), a ^ 2 < b → C * C - (2 * a) • C + b • 1 = 0 → n + n / 2 ≤ pencilRank 1 C
@slicesRank_L_family_ge : ∀ {n : ℕ} (Φ : (Fin n → ℝ) → Matrix (Fin n) (Fin n) ℝ),
  (∀ (x y : Fin n → ℝ), Φ (x + y) = Φ x + Φ y) →
    (∀ (t : ℝ) (x : Fin n → ℝ), Φ (t • x) = t • Φ x) →
      (∀ (x : Fin n → ℝ), Φ x = 0 ↔ x = 0) →
        (∀ (u v : Fin n → ℝ),
            LinearIndependent ℝ ![u, v] → ∀ {r : ℕ}, IsSlicesOfRank r (pencil (Φ u) (Φ v)) → n + n / 2 ≤ r) →
          ∀ (k : ℕ) (w : Fin (k + 2) → Fin n → ℝ),
            LinearIndependent ℝ w → ∀ {r : ℕ}, (IsSlicesOfRank r fun a => Φ (w a)) → n + n / 2 + k ≤ r
@substitution_pivot_last : ∀ {k n : ℕ} (S : Fin (k + 1) → Matrix (Fin n) (Fin n) ℝ),
  S (Fin.last k) ≠ 0 →
    ∀ {r : ℕ}, IsSlicesOfRank r S → ∃ l, IsSlicesOfRank (r - 1) fun a => S a.castSucc - l a • S (Fin.last k)
T_O : Fin 8 → Matrix (Fin 8) (Fin 8) ℝ
