    },
    {
      "topic": "ancilla idle noise",
      "stim_generated": "there is no general ancilla-idle channel; ancillas receive noise after reset, before measurement, after an H when present, and after a CX when active",
      "custom_qldpc": "every ancilla idle in each two-qubit schedule layer receives DEPOLARIZE1(p)"
    },
    {
      "topic": "single-qubit Clifford noise",
      "stim_generated": "after_clifford_depolarization=p adds DEPOLARIZE1(p) after both H layers on the X-check ancillas",
      "custom_qldpc": "ancillas are prepared and measured directly with RX/MX and no separate post-H noise location exists"
    },
